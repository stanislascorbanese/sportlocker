---
/**
 * Cascade de matériel sportif en arrière-plan de toute la page.
 *
 * Un flux continu d'objets — ballons, raquettes, frisbee, boules, mölkky —
 * traverse l'écran du haut vers le bas, et c'est le défilement qui l'entraîne.
 * Scroller fait descendre la cascade ; à l'arrêt elle continue de dériver
 * lentement, sinon la page a l'air figée.
 *
 * Deux décisions qui expliquent le reste du fichier :
 *
 *   - la géométrie est construite dans le code, pas chargée. Un ballon est une
 *     sphère, une raquette un tore et un cylindre. Aucun modèle à télécharger,
 *     rien à versionner, et le tout pèse quelques milliers de triangles. Un
 *     décor de fond ne justifie pas 2 Mo de glTF ;
 *
 *   - les objets sont des silhouettes, pas des produits. Matériaux sombres,
 *     liseré vert sur les arêtes, brouillard qui les avale en profondeur. Ils
 *     passent *derrière* le contenu, et tout ce qui attire l'œil ici le vole au
 *     texte. C'est un décor, et ça doit rester un décor.
 *
 * Le canevas est fixe en `z-index: -2` : au-dessus de l'atmosphère, sous le
 * voile des sections alternées. Voir « Atmosphère de page » dans global.css.
 */
---

<div id="sl-cascade" aria-hidden="true"></div>

<style>
  #sl-cascade {
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    /* Monte en douceur quand le rendu démarre : sans ça les objets
       apparaissent d'un bloc au premier frame. */
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  #sl-cascade.is-ready {
    opacity: var(--cascade-opacity, 0.5);
  }

  /* Le couloir central.
   *
   * Le contenu est centré ; laisser la cascade passer à pleine force derrière
   * une colonne de texte donnait exactement ce qu'il ne faut pas — un ballon en
   * travers d'un titre. Le masque garde le décor à pleine intensité dans les
   * marges et l'efface presque au milieu, là où on lit.
   *
   * Sur téléphone la colonne de texte occupe toute la largeur : il n'y a pas de
   * marge où reléguer quoi que ce soit, donc pas de masque et une intensité
   * simplement plus basse. */
  @media (min-width: 768px) {
    #sl-cascade {
      -webkit-mask-image: linear-gradient(
        to right,
        #000 0%, #000 22%,
        rgba(0, 0, 0, 0.35) 40%, rgba(0, 0, 0, 0.35) 60%,
        #000 78%, #000 100%
      );
      mask-image: linear-gradient(
        to right,
        #000 0%, #000 22%,
        rgba(0, 0, 0, 0.35) 40%, rgba(0, 0, 0, 0.35) 60%,
        #000 78%, #000 100%
      );
    }
  }
  #sl-cascade canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script is:inline>
  ;(function () {
    var host = document.getElementById('sl-cascade')
    if (!host) return

    // WebGL absent (vieux navigateur, GPU sur liste noire, rendu logiciel
    // désactivé) : l'atmosphère CSS suffit, on ne force rien.
    try {
      var probe = document.createElement('canvas')
      if (!probe.getContext('webgl') && !probe.getContext('experimental-webgl')) return
    } catch (e) {
      return
    }

    var reduced =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches

    var CASCADE_BUILD = '2026-09-11 · le relais'

    var THREE, renderer, scene, camera, fogColor

    /**
     * L'état de la caméra entre deux images.
     *
     * Tout est amorti plutôt qu'appliqué directement : la cible est recalculée à
     * chaque image d'après le défilement, et la caméra la rejoint par un lissage
     * exponentiel. Sans ça, un coup de molette brutal fait sauter le cadrage, et
     * un saut de cadrage est exactement ce qui trahit une caméra pilotée par un
     * script.
     */
    var cam = {
      baseFov: 46,
      pos: { x: 0, y: 0, z: 15.2 },
      look: { x: 0, y: 0, z: -20 },
      roll: 0,
      fov: 46,
      // Position du curseur, ramenée dans [-1, 1]. Le parallaxe à la souris ne
      // sert que sur desktop : sur un écran tactile il n'y a pas de curseur, et
      // le mouvement au doigt appartient déjà au défilement.
      mx: 0,
      my: 0,
      narrow: false,
    }
    var onPointer = null
    var fx = null
    var objects = []
    var ambient = null
    var relay = null
    var relayHit = null
    var RELAY_A = null
    var RELAY_B = null
    var scenes = []
    var lastDocHeight = 0
    var running = false
    var lastFrame = 0

    // Hauteur du couloir vertical dans lequel les objets bouclent. Un objet qui
    // sort par le bas est remis en haut : la boucle est invisible tant que le
    // couloir dépasse largement la hauteur vue par la caméra.
    var LANE = 26

    function palette() {
      var light = document.documentElement.classList.contains('light')
      // L'accent n'est pas le vert de marque : à pleine saturation, un plot vert
      // devient l'élément le plus lumineux de la page et vole la vedette au
      // titre. C'est un vert désaturé, à peine plus clair que le corps.
      return light
        ? {
            fog: 0xf3f6f9,
            body: 0xb4c6d6,
            accent: 0x86c2ae,
            metal: 0xc2cfda,
            key: 0xffffff,
            keyIntensity: 0.8,
            rim: 0x9fd6c2,
            rimIntensity: 0.45,
            ambient: 0.72,
            // Le tracé au sol et l'arceau : les deux seuls éléments qui ont le
            // droit d'être un peu plus francs que le reste du décor, parce
            // qu'ils portent la lecture des scènes.
            line: 0x7ba3bd,
            hoop: 0xd98f4a,
            panel: 0xdde6ee,
            ballGlow: 0x6b3a12,
          }
        : {
            fog: 0x0d1b2a,
            body: 0x24405a,
            accent: 0x2f8f70,
            metal: 0x33506a,
            key: 0xd6ece3,
            keyIntensity: 0.85,
            rim: 0x2bc295,
            rimIntensity: 1.2,
            ambient: 0.34,
            line: 0x5d93b5,
            hoop: 0xe58a38,
            panel: 0x35566f,
            ballGlow: 0x7a3c10,
          }
    }

    // La couleur de chaque article.
    //
    // Tout le décor était bleu nuit sur bleu nuit : on voyait des formes, pas du
    // matériel de sport. Un ballon de basket orange, un frisbee bleu, un mölkky
    // en bois — ça se reconnaît sans lire la légende.
    //
    // Les teintes restent en retrait : ce sont des couleurs de matériel vu à
    // travers un soir, pas des couleurs de catalogue. En thème clair elles
    // s'éclaircissent, sinon elles tapent sur le fond blanc.
    var SPORT_DARK = {
      foot:    { body: 0xdbe3ea, trim: 0x1e3346 },
      basket:  { body: 0xe58a38, trim: 0x2e1a0b },
      volley:  { body: 0xe7edf3, trim: 0x2f6fb0 },
      racket:  { body: 0x8ea4b8, trim: 0x2f8f70 },
      paddle:  { body: 0xbb8752, trim: 0x2f8f70 },
      frisbee: { body: 0x3f9ad8, trim: 0xdfe8ef },
      molkky:  { body: 0xc19a68, trim: 0x8a663c },
      boule:   { body: 0x94a2af, trim: 0x6f7e8a },
      cone:    { body: 0xdd6237, trim: 0x22384c },
    }
    var SPORT_LIGHT = {
      foot:    { body: 0xf2f6fa, trim: 0x9fb0bf },
      basket:  { body: 0xf0a463, trim: 0xa8703c },
      volley:  { body: 0xf4f8fb, trim: 0x8fb4d6 },
      racket:  { body: 0xb6c6d3, trim: 0x86c2ae },
      paddle:  { body: 0xd9b48c, trim: 0x86c2ae },
      frisbee: { body: 0x8ac3e8, trim: 0xeff5f9 },
      molkky:  { body: 0xdcc09a, trim: 0xb59468 },
      boule:   { body: 0xc0cad3, trim: 0x9aa7b2 },
      cone:    { body: 0xef9877, trim: 0xb0bfcb },
    }

    function sportSet(p) {
      return document.documentElement.classList.contains('light') ? SPORT_LIGHT : SPORT_DARK
    }
    /** Matériau d'un article : `which` vaut 'body' ou 'trim'. */
    /**
     * Les textures, dessinées à l'exécution.
     *
     * Il n'y a aucun fichier image dans ce dépôt, et c'est voulu : une carte de
     * grain en 2048 px pèse deux mégaoctets, et la vitrine doit rester légère
     * pour un gérant qui la consulte depuis un camping. Un canvas dessiné au
     * chargement coûte quelques millisecondes de processeur et zéro octet de
     * réseau.
     *
     * Ce qu'on gagne : un ballon cesse d'être une sphère lisse. Le grain du
     * cuir accroche la lumière rasante, et c'est ce relief-là — pas la
     * résolution de l'écran — qui fait la différence entre « objet 3D » et
     * « ballon ».
     */
    var TEX = {}

    /**
     * Bruit de valeur, en deux octaves.
     *
     * La première version multipliait deux sinus — `sin(x·0,35) · sin(y·0,31)`.
     * Ce n'est pas du bruit, c'est une grille régulière d'une trentaine de
     * périodes. Posée en rugosité sur une surface métallique, elle produisait des
     * stries verticales sur toute la façade de la borne, que j'ai d'abord prises
     * pour un conflit de profondeur.
     *
     * Un bruit crédible n'a pas de période. On tire donc une grille aléatoire
     * grossière, on l'interpole, et on superpose une octave plus fine : les
     * creux viennent de la première, le piqué de la seconde, et aucune des deux
     * ne se répète.
     */
    function valueNoise(size, cells, seedRand) {
      var g = new Float32Array((cells + 1) * (cells + 1))
      for (var i = 0; i < g.length; i++) g[i] = seedRand()
      var out = new Float32Array(size * size)
      var step = size / cells
      for (var y = 0; y < size; y++) {
        var gy = y / step, y0 = Math.floor(gy), fy = gy - y0
        // Lissage en S : une interpolation linéaire laisse voir les arêtes de
        // la grille, ce qui ramènerait le motif régulier qu'on cherche à fuir.
        var sy = fy * fy * (3 - 2 * fy)
        for (var x = 0; x < size; x++) {
          var gx = x / step, x0 = Math.floor(gx), fx = gx - x0
          var sx = fx * fx * (3 - 2 * fx)
          var i00 = y0 * (cells + 1) + x0
          var a = g[i00] + (g[i00 + 1] - g[i00]) * sx
          var b = g[i00 + cells + 1] + (g[i00 + cells + 2] - g[i00 + cells + 1]) * sx
          out[y * size + x] = a + (b - a) * sy
        }
      }
      return out
    }

    function noiseCanvas(size, base, amp, grain) {
      var cv = document.createElement('canvas')
      cv.width = cv.height = size
      var ctx = cv.getContext('2d')
      var img = ctx.createImageData(size, size)
      var d = img.data
      var rnd = Math.random
      var coarse = valueNoise(size, 12, rnd)
      var fine = valueNoise(size, 48, rnd)
      for (var i = 0; i < size * size; i++) {
        var v = base + (coarse[i] - 0.5) * amp + (fine[i] - 0.5) * grain
        v = Math.max(0, Math.min(1, v)) * 255
        d[i * 4] = d[i * 4 + 1] = d[i * 4 + 2] = v
        d[i * 4 + 3] = 255
      }
      ctx.putImageData(img, 0, 0)
      var t = new THREE.CanvasTexture(cv)
      t.wrapS = t.wrapT = THREE.RepeatWrapping
      return t
    }

    function textures() {
      if (TEX.ready) return TEX
      // Grain de cuir : creux marqués, piqué fin. C'est la carte de relief des
      // ballons.
      TEX.pebble = noiseCanvas(512, 0.5, 0.55, 0.35)
      TEX.pebble.repeat.set(6, 3)
      // Feutre de balle de tennis : plus doux, plus uniforme.
      TEX.felt = noiseCanvas(256, 0.55, 0.2, 0.5)
      TEX.felt.repeat.set(8, 4)
      // Métal brossé : brossage horizontal, d'où l'amplitude nulle en vertical.
      TEX.brushed = noiseCanvas(512, 0.5, 0.05, 0.22)
      TEX.brushed.repeat.set(1, 14)
      TEX.ready = true
      return TEX
    }

    /**
     * L'environnement réfléchi.
     *
     * C'est ce qui manquait le plus. Sans environnement, `metalness` ne réfléchit
     * rien et rend gris — d'où des métaux qu'il avait fallu ramener à 0,06 pour
     * qu'ils ne soient pas noirs. Une boule de pétanque sans reflet n'est pas une
     * boule de pétanque, c'est une bille grise.
     *
     * Plutôt qu'un fichier HDR, on filme un studio minuscule : trois panneaux
     * lumineux et un sol, que PMREM transforme en carte d'environnement. Quatre
     * plans suffisent — ce qu'on réfléchit, à cette échelle, ce sont des taches
     * de lumière, pas un décor lisible.
     */
    function buildEnvironment(p) {
      var env = new THREE.Scene()
      var box = new THREE.BoxGeometry(1, 1, 1)
      function panel(color, intensity, sx, sy, sz, x, y, z) {
        var m = new THREE.Mesh(box, new THREE.MeshBasicMaterial({ color: color }))
        m.material.color.multiplyScalar(intensity)
        m.scale.set(sx, sy, sz)
        m.position.set(x, y, z)
        env.add(m)
      }
      var dark = sportSet(p) !== SPORT_LIGHT
      // La boîte englobante donne la teinte générale du reflet : le bleu nuit du
      // site en sombre, un blanc cassé en clair.
      panel(dark ? 0x0e1c2b : 0xeef3f7, 1, 40, 40, 40, 0, 0, 0)
      // Panneau clé, en haut à gauche — c'est lui qu'on verra glisser sur les
      // sphères quand elles tournent.
      panel(0xffffff, dark ? 2.4 : 3.2, 12, 6, 1, -9, 9, 6)
      // Appoint froid à droite, plus faible.
      panel(0xbfe6d8, dark ? 1.1 : 1.6, 8, 10, 1, 10, 2, -4)
      // Liseré de marque derrière : c'est ce qui pose le vert dans les reflets
      // sans avoir à teinter les matériaux eux-mêmes.
      panel(0x2bc295, dark ? 0.9 : 0.6, 14, 1.4, 1, 2, -7, -8)
      return env
    }

    function sportMat(p, key, which, opts) {
      var set = sportSet(p)[key]
      var o = opts || {}
      var mat = new THREE.MeshStandardMaterial({
        color: set ? set[which] : p.body,
        roughness: o.roughness === undefined ? 0.68 : o.roughness,
        // La métallicité peut enfin monter : il y a désormais un environnement à
        // réfléchir. C'est son absence qui rendait les métaux noirs et obligeait
        // à les brider à 0,06.
        metalness: o.metalness === undefined ? 0.12 : o.metalness,
        transparent: !!o.transparent,
        opacity: o.opacity === undefined ? 1 : o.opacity,
      })
      mat.envMapIntensity = o.envMapIntensity === undefined ? 1 : o.envMapIntensity
      if (o.bump) {
        var t = textures()
        mat.bumpMap = t[o.bump]
        mat.bumpScale = o.bumpScale === undefined ? 0.015 : o.bumpScale
        mat.roughnessMap = t[o.bump]
      }
      return mat
    }

    // ─── Fabriques de géométrie ───────────────────────────────────────────────
    //
    // Chaque fabrique renvoie un Group. On vise la silhouette reconnaissable au
    // premier coup d'œil, pas la fidélité : à cette taille et sous ce
    // brouillard, un ballon de basket se lit à ses coutures, une raquette à son
    // tamis et son manche.

    function matBody(p) {
      return new THREE.MeshStandardMaterial({
        color: p.body,
        roughness: 0.72,
        metalness: 0.06,
      })
    }
    function matAccent(p) {
      return new THREE.MeshStandardMaterial({
        color: p.accent,
        roughness: 0.45,
        metalness: 0.15,
      })
    }
    function matMetal(p) {
      return new THREE.MeshStandardMaterial({
        color: p.metal,
        // Même raison que l'arceau : sans carte d'environnement, un matériau
        // métallique n'a rien à réfléchir et rend noir. Une boule de pétanque
        // reste mate ici, et c'est le liseré qui lui donne son éclat.
        roughness: 0.42,
        metalness: 0.12,
      })
    }

    function ballFoot(p) {
      var g = new THREE.Group()
      // Icosaèdre plutôt que sphère lisse : les facettes rappellent les
      // panneaux d'un ballon de foot et accrochent la lumière.
      g.add(new THREE.Mesh(new THREE.IcosahedronGeometry(1, 1), sportMat(p, 'foot', 'body')))
      var patch = new THREE.Mesh(
        new THREE.IcosahedronGeometry(1.005, 1),
        sportMat(p, 'foot', 'trim'),
      )
      patch.material = patch.material.clone()
      patch.material.wireframe = true
      patch.material.transparent = true
      patch.material.opacity = 0.5
      g.add(patch)
      return g
    }

    function ballBasket(p) {
      var g = new THREE.Group()
      // 64 x 48 au lieu de 20 x 16 : à contre-jour, la silhouette d'une sphère
      // basse en facettes se lit comme un polygone, et c'est le premier détail
      // qui trahit la 3D bon marché.
      g.add(new THREE.Mesh(
        new THREE.SphereGeometry(1, 64, 48),
        sportMat(p, 'basket', 'body', { roughness: 0.82, metalness: 0.02, bump: 'pebble', bumpScale: 0.016 }),
      ))
      // Les quatre coutures : deux méridiens, deux arcs croisés.
      var seam = new THREE.TorusGeometry(1.002, 0.022, 6, 40)
      var m = sportMat(p, 'basket', 'trim')
      var s1 = new THREE.Mesh(seam, m)
      var s2 = new THREE.Mesh(seam, m)
      s2.rotation.y = Math.PI / 2
      var s3 = new THREE.Mesh(seam, m)
      s3.rotation.x = Math.PI / 2
      g.add(s1, s2, s3)
      return g
    }

    function ballVolley(p) {
      var g = new THREE.Group()
      g.add(new THREE.Mesh(new THREE.SphereGeometry(1, 20, 16), sportMat(p, 'volley', 'body')))
      // Trois bandes parallèles par face : la signature d'un ballon de volley.
      var band = new THREE.TorusGeometry(1.003, 0.018, 6, 40)
      for (var i = -1; i <= 1; i++) {
        var b = new THREE.Mesh(band, sportMat(p, 'volley', 'trim'))
        b.rotation.x = Math.PI / 2
        b.position.y = i * 0.38
        b.scale.setScalar(Math.cos((i * 0.38 * Math.PI) / 2.6))
        g.add(b)
      }
      return g
    }

    function boule(p) {
      // Boule de pétanque : petite, métallique, striée.
      var g = new THREE.Group()
      var steel = sportMat(p, 'boule', 'body', { roughness: 0.38, metalness: 0.22 })
      g.add(new THREE.Mesh(new THREE.SphereGeometry(0.62, 18, 14), steel))
      var ring = new THREE.TorusGeometry(0.622, 0.012, 5, 32)
      for (var i = -2; i <= 2; i++) {
        var r = new THREE.Mesh(ring, sportMat(p, 'boule', 'trim'))
        r.rotation.x = Math.PI / 2
        r.position.y = i * 0.17
        r.scale.setScalar(Math.cos((i * 0.17 * Math.PI) / 1.7))
        g.add(r)
      }
      return g
    }

    function frisbee(p) {
      var g = new THREE.Group()
      var disc = new THREE.Mesh(
        new THREE.CylinderGeometry(1.15, 1.0, 0.14, 28),
        sportMat(p, 'frisbee', 'body'),
      )
      g.add(disc)
      var lip = new THREE.Mesh(
        new THREE.TorusGeometry(1.14, 0.05, 6, 32),
        sportMat(p, 'frisbee', 'trim'),
      )
      lip.rotation.x = Math.PI / 2
      lip.position.y = -0.06
      g.add(lip)
      return g
    }

    function racket(p) {
      // Raquette de badminton : tamis ovale, manche long. C'est la silhouette la
      // plus identifiable du lot, et c'est aussi l'article qui dimensionne la
      // borne (68 cm) — autant qu'elle passe à l'écran.
      var g = new THREE.Group()
      var head = new THREE.Mesh(
        new THREE.TorusGeometry(0.62, 0.055, 8, 36),
        sportMat(p, 'racket', 'body'),
      )
      head.scale.set(1, 1.25, 1)
      head.position.y = 0.85
      g.add(head)

      // Cordage : deux jeux de fils fins, juste assez pour qu'on le devine.
      var stringMat = sportMat(p, 'racket', 'trim', { transparent: true, opacity: 0.4 })
      for (var i = -2; i <= 2; i++) {
        var v = new THREE.Mesh(new THREE.BoxGeometry(0.012, 1.45, 0.012), stringMat)
        v.position.set(i * 0.2, 0.85, 0)
        g.add(v)
        var h = new THREE.Mesh(new THREE.BoxGeometry(1.15, 0.012, 0.012), stringMat)
        h.position.set(0, 0.85 + i * 0.26, 0)
        g.add(h)
      }

      var throat = new THREE.Mesh(
        new THREE.CylinderGeometry(0.05, 0.06, 0.5, 10),
        sportMat(p, 'racket', 'body'),
      )
      throat.position.y = 0.12
      g.add(throat)
      var grip = new THREE.Mesh(
        new THREE.CylinderGeometry(0.085, 0.075, 0.8, 12),
        sportMat(p, 'racket', 'trim'),
      )
      grip.position.y = -0.5
      g.add(grip)
      return g
    }

    function paddle(p) {
      // Raquette de plage / ping-pong : palette ronde et manche court.
      var g = new THREE.Group()
      var face = new THREE.Mesh(
        new THREE.CylinderGeometry(0.72, 0.72, 0.08, 26),
        sportMat(p, 'paddle', 'body'),
      )
      face.rotation.x = Math.PI / 2
      face.position.y = 0.45
      g.add(face)
      var edge = new THREE.Mesh(
        new THREE.TorusGeometry(0.72, 0.035, 6, 30),
        sportMat(p, 'paddle', 'trim'),
      )
      edge.position.y = 0.45
      g.add(edge)
      var handle = new THREE.Mesh(
        new THREE.CylinderGeometry(0.09, 0.08, 0.62, 12),
        sportMat(p, 'paddle', 'trim'),
      )
      handle.position.y = -0.24
      g.add(handle)
      return g
    }

    function molkky(p) {
      // Quille de mölkky : cylindre de bois à sommet biseauté.
      var g = new THREE.Group()
      var body = new THREE.Mesh(
        new THREE.CylinderGeometry(0.28, 0.28, 1.5, 14),
        sportMat(p, 'molkky', 'body'),
      )
      g.add(body)
      var tip = new THREE.Mesh(
        new THREE.CylinderGeometry(0.12, 0.28, 0.42, 14),
        sportMat(p, 'molkky', 'trim'),
      )
      tip.position.y = 0.96
      g.add(tip)
      return g
    }

    function cone(p) {
      // Plot de terrain : la seule forme plate du lot, utile pour varier les
      // silhouettes quand plusieurs sphères se suivent.
      var g = new THREE.Group()
      g.add(new THREE.Mesh(new THREE.ConeGeometry(0.5, 1.0, 16), sportMat(p, 'cone', 'body')))
      var base = new THREE.Mesh(
        new THREE.BoxGeometry(1.0, 0.07, 1.0),
        sportMat(p, 'cone', 'trim'),
      )
      base.position.y = -0.5
      g.add(base)
      return g
    }

    var FACTORIES = [
      ballFoot,
      racket,
      ballBasket,
      frisbee,
      ballVolley,
      molkky,
      paddle,
      boule,
      cone,
    ]

    // ─── Scènes ───────────────────────────────────────────────────────────────
    //
    // Le flux d'objets habille la page, mais il ne raconte rien. Les scènes,
    // elles, sont des moments : un terrain qui passe dessous, un ballon qui
    // monte et retombe dans l'arceau, des boules qui roulent et s'arrêtent.
    //
    // Chacune possède une fenêtre de défilement. Dans sa fenêtre, elle se joue
    // en fonction de la position exacte dans la page ; en dehors, elle est
    // masquée et ne coûte plus rien à dessiner. Piloter par le scroll plutôt
    // que par une horloge a trois vertus : la scène est réversible — on remonte,
    // le ballon ressort de l'arceau —, elle ne se joue jamais hors champ, et
    // deux visiteurs qui défilent à la même hauteur voient la même image.

    function clamp01(v) {
      return v < 0 ? 0 : v > 1 ? 1 : v
    }
    function lerp(a, b, t) {
      return a + (b - a) * t
    }
    /** Adoucit les extrémités : une scène qui démarre pile à zéro saccade. */
    function ease(t) {
      return t * t * (3 - 2 * t)
    }

    function lineMaterial(p, opacity) {
      return new THREE.LineBasicMaterial({
        color: p.line,
        transparent: true,
        opacity: opacity,
      })
    }

    /** Construit un LineSegments à partir d'une liste plate de sommets. */
    function segments(points, material) {
      var g = new THREE.BufferGeometry()
      g.setAttribute('position', new THREE.Float32BufferAttribute(points, 3))
      return new THREE.LineSegments(g, material)
    }

    /** Pousse les segments d'un cercle (ou d'un arc) dans le plan XZ. */
    function pushArc(out, cx, cz, r, from, to, steps, y) {
      for (var i = 0; i < steps; i++) {
        var a0 = from + ((to - from) * i) / steps
        var a1 = from + ((to - from) * (i + 1)) / steps
        out.push(cx + Math.cos(a0) * r, y, cz + Math.sin(a0) * r)
        out.push(cx + Math.cos(a1) * r, y, cz + Math.sin(a1) * r)
      }
    }
    function pushRect(out, x0, z0, x1, z1, y) {
      out.push(x0, y, z0, x1, y, z0)
      out.push(x1, y, z0, x1, y, z1)
      out.push(x1, y, z1, x0, y, z1)
      out.push(x0, y, z1, x0, y, z0)
    }

    // ─── Le terrain ───────────────────────────────────────────────────────────
    //
    // Un city-stade vu de haut, qui se rapproche pendant qu'on lit. Il n'y a
    // pas de sol dans le reste du décor : les objets flottent dans le vide, et
    // c'est ce qui les empêchait de donner une échelle. Une ligne peinte au sol
    // suffit à dire « on est dehors, sur un terrain », et à poser le bas du
    // cadre.

    function makeCourt(p) {
      var g = new THREE.Group()
      var pts = []
      var W = 13
      var D = 8.5

      pushRect(pts, -W, -D, W, D, 0)
      pts.push(0, 0, -D, 0, 0, D) // ligne médiane
      pushArc(pts, 0, 0, 2.1, 0, Math.PI * 2, 36, 0)

      // Les deux raquettes, et l'arc de lancer franc au bout de chacune.
      pushRect(pts, -W, -2.6, -W + 4.2, 2.6, 0)
      pushRect(pts, W - 4.2, -2.6, W, 2.6, 0)
      pushArc(pts, -W + 4.2, 0, 2.1, -Math.PI / 2, Math.PI / 2, 18, 0)
      pushArc(pts, W - 4.2, 0, 2.1, Math.PI / 2, (Math.PI * 3) / 2, 18, 0)

      g.add(segments(pts, lineMaterial(p, 0.72)))

      // Une dalle à peine teintée sous les lignes : sans elle le tracé flotte
      // dans le noir et se lit comme un schéma, pas comme un sol.
      var slab = new THREE.Mesh(
        new THREE.PlaneGeometry(W * 2 + 1.4, D * 2 + 1.4),
        new THREE.MeshBasicMaterial({
          color: p.line,
          transparent: true,
          opacity: 0.09,
          depthWrite: false,
        }),
      )
      slab.rotation.x = -Math.PI / 2
      slab.position.y = -0.02
      g.add(slab)

      return { group: g }
    }

    // ─── Le tennis ────────────────────────────────────────────────────────────
    //
    // La première scène après la borne, et la seule qu'on aborde de l'intérieur
    // d'un casier. Il faut donc qu'elle soit déjà en train de se jouer quand on
    // débouche : un échange en cours, puis un smash qui part vers le fond du
    // couloir. C'est cette balle-là qu'on suivra jusqu'au panier.
    //
    // Le terrain est tourné d'un quart de tour : sa longueur suit le couloir,
    // pas la largeur de l'écran. Sans ça on survole un court par le travers et
    // l'échange se joue de gauche à droite, perpendiculairement à la marche.

    function makeTennis(p) {
      var g = new THREE.Group()

      var court = makeCourt(p)
      court.group.rotation.y = Math.PI / 2
      g.add(court.group)

      // Le filet, au milieu, en travers du couloir. Deux mailles suffisent à le
      // dire : une bande claire en haut, une trame translucide dessous.
      var net = new THREE.Group()
      var mesh = new THREE.Mesh(
        new THREE.PlaneGeometry(9, 1.05),
        new THREE.MeshStandardMaterial({
          color: p.line, roughness: 0.9, metalness: 0,
          transparent: true, opacity: 0.22, side: THREE.DoubleSide, depthWrite: false,
        }),
      )
      mesh.position.y = 0.52
      net.add(mesh)
      var bande = new THREE.Mesh(
        new THREE.BoxGeometry(9, 0.1, 0.06),
        new THREE.MeshStandardMaterial({ color: p.line, roughness: 0.6, metalness: 0.1 }),
      )
      bande.position.y = 1.05
      net.add(bande)
      g.add(net)

      // La raquette est du côté caméra : c'est nous qui frappons.
      var swing = new THREE.Group()
      var r = racket(p)
      r.scale.setScalar(1.45)
      swing.add(r)
      swing.position.set(2.4, 2.2, 9)
      g.add(swing)

      var ball = new THREE.Mesh(
        new THREE.SphereGeometry(0.24, 18, 14),
        new THREE.MeshStandardMaterial({ color: 0xd8e64a, roughness: 0.85, metalness: 0.02 }),
      )
      g.add(ball)

      return { group: g, swing: swing, ball: ball }
    }

    function updateTennis(scn, q) {
      // Fin à plat, et pas à 0,02 : la rotation s'applique aussi au point de
      // sortie du smash, et deux centièmes de radian à dix unités déplacent le
      // raccord de vingt centimètres — visible sur une balle de vingt-six.
      scn.group.rotation.x = lerp(-0.10, 0, ease(q))

      // Le geste : armé jusqu'à 0,52, frappe à 0,60, accompagnement ensuite.
      // La frappe tombe pile quand la balle atteint le tamis — c'est la seule
      // coïncidence qui compte, tout le reste peut dériver sans qu'on le voie.
      var arm = clamp01(q / 0.52)
      var hit = clamp01((q - 0.52) / 0.14)
      scn.swing.rotation.z = lerp(1.25, -1.35, ease(hit) || ease(arm) * 0.12)
      scn.swing.rotation.x = lerp(-0.2, 0.55, ease(hit))
      scn.swing.rotation.y = lerp(0.35, -0.45, ease(hit))

      if (q < 0.6) {
        // L'échange en cours : la balle revient du fond du court, en cloche.
        var t = clamp01(q / 0.6)
        scn.ball.position.set(
          lerp(-3.2, 2.4, t),
          2.2 + Math.sin(Math.PI * t) * 2.6,
          lerp(-19, 8.4, t),
        )
      } else {
        // Le smash. Elle part vers le fond, plus vite qu'elle n'est venue, et
        // elle plonge : un smash descend, sinon c'est un lob.
        var u = (q - 0.6) / 0.4
        var f = u * u * 0.55 + u * 0.45
        // Le point d'arrivée n'est pas choisi pour la trajectoire : c'est
        // exactement `exit` de la scène, là où le relais prend le suivi. Une
        // balle qui finit ailleurs, c'est une deuxième balle qui apparaît.
        scn.ball.position.set(
          lerp(2.4, -1.2, f),
          lerp(4.4, 3.3, f),
          lerp(8.4, -10, f),
        )
      }
      scn.ball.rotation.x += 0.22
    }

    // ─── Le panier ────────────────────────────────────────────────────────────
    //
    // La scène qu'on retient. Le ballon monte de la gauche, décrit son arc,
    // tombe dans l'arceau et fait gonfler le filet au passage — c'est ce
    // gonflement qui vend le tir, bien plus que la trajectoire.

    // Vingt brins et cinq cerclages au lieu de quatorze et quatre. Un filet de
    // basket réel en a douze, mais un tracé d'un pixel de large ne rend pas
    // l'épaisseur de la corde : la densité compense ce que la ligne ne peut pas
    // dire. Un cerclage de plus au fond ferme la poche, qui bâillait.
    var NET_STRANDS = 20
    var NET_RINGS = [0, -0.3, -0.58, -0.84, -1.06]
    var NET_RADII = [0.72, 0.645, 0.55, 0.44, 0.33]

    function netPoints() {
      var pts = []
      var i, k, a
      // Brins verticaux.
      for (i = 0; i < NET_STRANDS; i++) {
        a = (i / NET_STRANDS) * Math.PI * 2
        for (k = 0; k < NET_RINGS.length - 1; k++) {
          pts.push(Math.cos(a) * NET_RADII[k], NET_RINGS[k], Math.sin(a) * NET_RADII[k])
          pts.push(Math.cos(a) * NET_RADII[k + 1], NET_RINGS[k + 1], Math.sin(a) * NET_RADII[k + 1])
        }
      }
      // Deux cerclages horizontaux : sans eux on lit des franges, pas un filet.
      for (k = 1; k < NET_RINGS.length; k++) {
        for (i = 0; i < NET_STRANDS; i++) {
          var a0 = (i / NET_STRANDS) * Math.PI * 2
          var a1 = ((i + 1) / NET_STRANDS) * Math.PI * 2
          pts.push(Math.cos(a0) * NET_RADII[k], NET_RINGS[k], Math.sin(a0) * NET_RADII[k])
          pts.push(Math.cos(a1) * NET_RADII[k], NET_RINGS[k], Math.sin(a1) * NET_RADII[k])
        }
      }
      return pts
    }

    function makeHoop(p) {
      var g = new THREE.Group()

      var panel = new THREE.Mesh(
        new THREE.BoxGeometry(3.1, 2.05, 0.07),
        new THREE.MeshStandardMaterial({
          color: p.panel,
          roughness: 0.6,
          metalness: 0.04,
          transparent: true,
          opacity: 0.82,
        }),
      )
      panel.position.set(0, 0.75, -0.85)
      g.add(panel)

      // Le cadre. Une vitre sans bord flotte et se lit comme un rectangle de
      // brouillard ; c'est le cadre qui en fait un panneau accroché à quelque
      // chose. Quatre barres, la même laque que l'arceau.
      var cadreMat = new THREE.MeshStandardMaterial({
        color: p.hoop, roughness: 0.3, metalness: 0.5,
      })
      var barH = new THREE.BoxGeometry(3.18, 0.09, 0.11)
      var barV = new THREE.BoxGeometry(0.09, 2.13, 0.11)
      for (var cy2 = -1; cy2 <= 1; cy2 += 2) {
        var bh = new THREE.Mesh(barH, cadreMat)
        bh.position.set(0, 0.75 + cy2 * 1.025, -0.85)
        g.add(bh)
      }
      for (var cx2 = -1; cx2 <= 1; cx2 += 2) {
        var bv = new THREE.Mesh(barV, cadreMat)
        bv.position.set(cx2 * 1.545, 0.75, -0.85)
        g.add(bv)
      }

      // Le petit rectangle peint au centre du panneau : c'est lui qui fait
      // reconnaître un panneau de basket au premier coup d'œil.
      var markPts = []
      pushRect(markPts, -0.6, -0.42, 0.6, 0.42, 0)
      var mark = segments(markPts, lineMaterial(p, 0.85))
      mark.rotation.x = Math.PI / 2
      mark.position.set(0, 0.62, -0.8)
      g.add(mark)

      var ring = new THREE.Mesh(
        // 16 x 64 : l'arceau est l'objet que la caméra approche le plus, et un
        // tore à 30 segments s'y lit comme un polygone.
        new THREE.TorusGeometry(0.72, 0.055, 16, 64),
        // De l'acier laqué, pas du plastique. La métallicité peut monter
        // maintenant qu'il y a un environnement à réfléchir — c'est le reflet du
        // panneau lumineux qui court le long du tube quand le panier tourne.
        new THREE.MeshStandardMaterial({ color: p.hoop, roughness: 0.28, metalness: 0.55 }),
      )
      ring.rotation.x = Math.PI / 2
      g.add(ring)

      // La potence qui relie l'arceau au panneau.
      var arm = new THREE.Mesh(
        new THREE.BoxGeometry(0.3, 0.09, 0.42),
        new THREE.MeshStandardMaterial({ color: p.hoop, roughness: 0.5, metalness: 0.1 }),
      )
      arm.position.set(0, 0, -0.62)
      g.add(arm)

      var base = netPoints()
      var net = segments(base.slice(), lineMaterial(p, 0.85))
      g.add(net)

      // Le ballon du tir n'est pas de la couleur du décor : c'est lui qu'on
      // doit suivre des yeux d'un bout à l'autre de la scène. En bleu nuit
      // comme le reste, la trajectoire ne se lisait pas du tout — on voyait un
      // panier, pas un tir. Il reprend donc l'orange de l'arceau, avec des
      // coutures sombres.
      var ballPalette = {}
      for (var key in p) ballPalette[key] = p[key]
      ballPalette.body = p.hoop
      ballPalette.accent = 0x2e1a0b
      // Trois ballons plutôt qu'un : un tir isolé passe inaperçu si on scrolle
      // vite, trois qui s'enchaînent font une séquence qu'on ne peut pas rater.
      var balls = []
      for (var b = 0; b < 3; b++) {
        var ball = ballBasket(ballPalette)
        ball.scale.setScalar(0.44)
        // Une pointe d'émission sur le cuir, et lui seul : c'est le seul objet
        // de la page qui doit tenir sa couleur quelle que soit la lumière,
        // parce que c'est lui qu'on suit des yeux. Les coutures restent mates,
        // sinon la balle devient une lampe.
        ball.children[0].material = ball.children[0].material.clone()
        ball.children[0].material.emissive = new THREE.Color(p.ballGlow)
        ball.children[0].material.emissiveIntensity = 0.6
        g.add(ball)
        balls.push(ball)
      }

      return { group: g, net: net, netBase: base.slice(), balls: balls }
    }

    function updateHoop(scn, q) {
      // Le panier pivote pendant l'approche pour se présenter de face au
      // moment où on arrive à sa hauteur : de loin on le voit de trois quarts,
      // de près l'arceau est ouvert vers nous.
      scn.group.rotation.y = lerp(0.55, 0.05, ease(q))

      // Les trois tirs se suivent à un tiers de fenêtre d'écart, et chacun part
      // d'un point différent : trois paraboles superposées se liraient comme un
      // seul ballon qui clignote.
      // Le premier départ n'est pas un point de départ choisi : c'est `entry`
      // de la scène, là où le relais dépose la balle qu'on suivait depuis le
      // court. Le panier apparaît donc devant nous au moment exact où la balle
      // arrive, et le premier tir est la continuation de ce qu'on suivait.
      var DEPARTS = [
        [-4.0, 1.4, 12],
        [-6.2, -6.4, -2.2],
        [-8.4, -4.4, 0.6],
      ]
      var lastShot = 0
      for (var i = 0; i < scn.balls.length; i++) {
        var ball = scn.balls[i]
        var d = DEPARTS[i]
        // Chaque ballon occupe les deux tiers de la fenêtre, décalé d'un sixième.
        var qi = clamp01((q - i * 0.17) / 0.66)
        if (qi > lastShot) lastShot = qi

        if (qi <= 0) {
          ball.visible = false
          continue
        }
        ball.visible = true

        if (qi < 0.58) {
          // Montée. Le déplacement horizontal ralentit vers le sommet et la
          // hauteur y est étirée : c'est la suspension, le temps que le regard
          // a besoin de prendre pour anticiper le panier. Une parabole à vitesse
          // constante passe trop vite au sommet et le tir ne se raconte pas.
          var t = clamp01(qi / 0.58)
          var slow = 1 - Math.pow(1 - t, 2.2)
          var arc = Math.sin(Math.PI * Math.pow(t, 0.82))
          ball.position.set(
            lerp(d[0], 0, slow),
            lerp(d[1], 0.95, slow) + arc * 4.4,
            lerp(d[2], 0, slow),
          )
          // La rotation suit la vitesse : elle ralentit au sommet avec le reste.
          ball.rotation.z = qi * 5 + slow * 3
        } else if (qi < 0.68) {
          // Traversée. Fenêtre volontairement courte — c'est l'accélération
          // après la suspension qui fait l'impact, pas la vitesse absolue.
          var t2 = (qi - 0.58) / 0.10
          ball.position.set(0, lerp(0.95, -1.7, t2 * t2 * (3 - 2 * t2)), 0)
          ball.rotation.z += 0.22
        } else {
          // Chute. En t² : une chute linéaire flotte, et une balle qui flotte
          // annule tout le travail de la suspension juste avant.
          var t3 = (qi - 0.68) / 0.32
          var g3 = t3 * t3
          ball.position.set(lerp(0, 0.9 + i * 0.4, t3), lerp(-1.7, -8, g3), lerp(0, 1.2, t3))
          ball.rotation.z += 0.14
        }
        ball.rotation.x += 0.004
      }

      // Le claquement du filet.
      //
      // Un gonflement symétrique — il enfle, il dégonfle — est ce qu'on fait
      // quand on n'a pas regardé de filet. Un vrai filet est chassé d'un coup
      // par le ballon, puis oscille en s'amortissant, et il passe *sous* sa
      // forme de repos entre deux oscillations : la corde se resserre. C'est ce
      // resserrement, plus que le gonflement, qui rend le mouvement vivant.
      var tw = (lastShot - 0.60) / 0.40
      var swell = 0
      if (tw > 0) {
        // Attaque sur 4 % de la fenêtre : quasi instantanée, comme le contact.
        var att = clamp01(tw / 0.04)
        if (tw < 0.04) {
          swell = att
        } else {
          // Puis une oscillation amortie. Les valeurs négatives sont voulues :
          // c'est le filet qui se pince en revenant.
          var rest = clamp01((tw - 0.04) / 0.96)
          swell = Math.exp(-rest * 5.5) * Math.cos(rest * 19)
        }
      }
      var attr = scn.net.geometry.attributes.position
      var arr = attr.array
      var base = scn.netBase
      for (var i = 0; i < arr.length; i += 3) {
        var y = base[i + 1]
        // Le haut du filet est accroché à l'arceau : il ne bouge pas. Plus on
        // descend, plus il se déforme.
        var w = clamp01(-y / 1.2)
        var k = 1 + swell * 0.55 * w
        arr[i] = base[i] * k
        arr[i + 1] = y - swell * 0.3 * w
        arr[i + 2] = base[i + 2] * k
      }
      attr.needsUpdate = true
    }

    // ─── La borne ─────────────────────────────────────────────────────────────
    //
    // Le produit lui-même : une porte s'ouvre et un ballon en sort. C'est la
    // seule scène qui montre ce qu'on vend, et c'est pour ça qu'elle est la
    // première de la page.
    //
    // Les proportions sont celles de la vraie borne — 90 × 50 × 180 cm, huit
    // casiers sur trois colonnes — reprises de `data/produit.json`. Un décor qui
    // décrit une autre machine que la fiche technique, c'est ce qu'on a passé la
    // journée d'hier à corriger.

    function makeKiosk(p) {
      var g = new THREE.Group()
      var dark = sportSet(p) !== SPORT_LIGHT
      var t = textures()

      // Tôle brossée. C'est le matériau qui change tout : jusqu'ici le meuble
      // était un aplat mat, donc un rectangle. Une tôle réfléchit le panneau
      // lumineux du studio, et ce reflet qui glisse quand la borne tourne est ce
      // qui lui donne un volume.
      function steel(hex, rough, metal) {
        var m = new THREE.MeshStandardMaterial({
          color: hex,
          roughness: rough === undefined ? 0.38 : rough,
          metalness: metal === undefined ? 0.62 : metal,
        })
        // Aucune carte de rugosité ici, volontairement. C'est le reflet de
        // l'environnement qui fait lire le métal ; un faux brossage plaqué
        // par-dessus ne l'aide pas, il le salit. La borne est une tôle laquée
        // propre, pas une pièce d'atelier.
        return m
      }

      var bodyHex = dark ? 0x22394f : 0xb9c8d6
      var doorHex = dark ? 0x2b4a67 : 0xd6e1ea
      var wellHex = dark ? 0x060d15 : 0x2b3a47

      var caisse = steel(bodyHex)
      g.add(new THREE.Mesh(new THREE.BoxGeometry(1.8, 3.6, 1.0), caisse))

      // Les arêtes. Un chanfrein n'existe pas dans une BoxGeometry, mais quatre
      // baguettes légèrement plus claires posées sur les angles verticaux en
      // font l'office : elles attrapent la lumière là où une arête vive le
      // ferait, et c'est ce liseré qui détache le meuble du fond.
      var areteMat = steel(dark ? 0x3d5c78 : 0xdfe9f1, 0.22, 0.8)
      var arete = new THREE.BoxGeometry(0.05, 3.62, 0.05)
      for (var ax = -1; ax <= 1; ax += 2) {
        for (var az = -1; az <= 1; az += 2) {
          var e = new THREE.Mesh(arete, areteMat)
          e.position.set(ax * 0.895, 0, az * 0.495)
          g.add(e)
        }
      }

      // Bandeau de marque, seul endroit du décor où le vert est franc.
      var band = new THREE.Mesh(
        new THREE.BoxGeometry(1.86, 0.26, 1.22),
        new THREE.MeshStandardMaterial({
          color: 0x1d9e75, roughness: 0.35, metalness: 0.2,
          emissive: 0x0d5c44, emissiveIntensity: dark ? 0.6 : 0.15,
        }),
      )
      band.position.y = 1.62
      g.add(band)

      // Socle : une borne posée à même le sol flotte. Le retrait sous le meuble
      // fait l'ombre portée que le rendu ne calcule pas.
      var socle = new THREE.Mesh(new THREE.BoxGeometry(1.66, 0.14, 0.86), steel(wellHex, 0.7, 0.3))
      socle.position.y = -1.85
      g.add(socle)

      var doorMat = steel(doorHex, 0.34, 0.55)
      var wellMat = new THREE.MeshStandardMaterial({ color: wellHex, roughness: 0.95, metalness: 0 })
      var poigneeMat = steel(dark ? 0x8fb8cf : 0x7d8fa0, 0.2, 0.9)

      var doors = []
      var cols = [-0.58, 0, 0.58]
      var layout = [
        [0, 1.02, 0.52, 1.9],
        [0, -0.62, 0.52, 1.9],
        [1, 1.06, 0.52, 0.82],
        [1, 0.18, 0.52, 0.82],
        [1, -0.7, 0.52, 0.82],
        [2, 1.06, 0.52, 0.82],
        [2, 0.18, 0.52, 0.82],
        [2, -0.7, 0.52, 0.82],
      ]
      for (var i = 0; i < layout.length; i++) {
        var L = layout[i], w = L[2], h = L[3], cx = cols[L[0]], cy = L[1]

        // Le puits derrière la porte, qui fait qu'une porte ouverte révèle une
        // cavité et non un trou dans le vide.
        //
        // Sa face avant dépasse de 1 cm celle de la caisse. Ce centimètre n'est
        // pas cosmétique : posées exactement dans le même plan, les deux faces
        // se disputent chaque pixel — le GPU n'a aucun moyen de les départager
        // et tranche au hasard, d'où les rayures verticales. En profondeur, deux
        // surfaces ne doivent jamais être à la même cote.
        var well = new THREE.Mesh(new THREE.BoxGeometry(w - 0.04, h - 0.04, 0.38), wellMat)
        well.position.set(cx, cy, 0.32)
        g.add(well)

        // Le pivot avance pour que la porte soit entièrement en avant de la
        // caisse. Centrée sur z = 0,5, sa moitié arrière traversait le meuble :
        // rayures à l'arrêt, et une porte qui s'ouvrait en passant au travers.
        var pivot = new THREE.Group()
        pivot.position.set(cx - w / 2, cy, 0.545)

        var panel = new THREE.Mesh(new THREE.BoxGeometry(w - 0.03, h - 0.03, 0.045), doorMat)
        panel.position.x = w / 2
        pivot.add(panel)

        // Poignée verticale au bord libre, décollée du panneau : c'est l'objet
        // le plus petit du meuble et celui qui dit le plus qu'il s'ouvre.
        var poignee = new THREE.Mesh(
          new THREE.CylinderGeometry(0.018, 0.018, Math.min(h * 0.45, 0.5), 10),
          poigneeMat,
        )
        poignee.position.set(w - 0.11, 0, 0.045)
        pivot.add(poignee)

        g.add(pivot)
        doors.push(pivot)
      }

      // L'écran de la borne, en haut à droite : la seule surface qui émet.
      var ecran = new THREE.Mesh(
        new THREE.BoxGeometry(0.34, 0.24, 0.02),
        new THREE.MeshStandardMaterial({
          color: 0x0a1f1a, roughness: 0.15, metalness: 0.1,
          emissive: 0x2bc295, emissiveIntensity: dark ? 1.5 : 0.5,
        }),
      )
      ecran.position.set(0.58, 1.34, 0.60)
      g.add(ecran)

      var out = ballBasket(p)
      out.scale.setScalar(0.3)
      g.add(out)

      return { group: g, doors: doors, out: out, openIndex: 3 }
    }

    function updateKiosk(scn, q) {
      var t = ease(q)
      // La borne est plein axe : la caméra entre par la porte ouverte. Elle est
      // de face aux six dixièmes du plan, pas à la fin — la caméra arrive à la
      // fin, et un meuble encore de trois quarts à cet instant se traverserait
      // par la tôle.
      scn.group.rotation.y = lerp(-0.55, 0, ease(clamp01(q / 0.6)))

      // La porte s'ouvre au tiers de la fenêtre et reste ouverte : la refermer
      // pendant que l'article est dehors serait un contresens sur le produit.
      var open = clamp01((q - 0.3) / 0.25)
      scn.doors[scn.openIndex].rotation.y = -ease(open) * 1.9

      // L'article sort du casier puis flotte devant, comme s'il était pris.
      var e = ease(clamp01((q - 0.42) / 0.4))
      scn.out.visible = e > 0.01
      scn.out.position.set(lerp(0, 1.3, e), 0.18 - e * 0.5, lerp(0.2, 1.5, e))
      scn.out.rotation.y += 0.01
      scn.out.rotation.x = e * 2
    }

    // ─── La pétanque ──────────────────────────────────────────────────────────
    //
    // Deux boules qui roulent vers le cochonnet et s'arrêtent. C'est la scène
    // la plus calme, et elle est en bas de page à dessein : on n'ouvre pas sur
    // de la pétanque, on ferme dessus.

    function makePetanque(p) {
      var g = new THREE.Group()

      var pts = []
      pushArc(pts, 0, 0, 3.4, 0, Math.PI * 2, 40, 0)
      pushArc(pts, 0, 0, 0.9, 0, Math.PI * 2, 24, 0)
      g.add(segments(pts, lineMaterial(p, 0.55)))

      var jack = new THREE.Mesh(
        new THREE.SphereGeometry(0.17, 12, 10),
        new THREE.MeshStandardMaterial({ color: p.accent, roughness: 0.7 }),
      )
      jack.position.y = 0.17
      g.add(jack)

      var balls = []
      for (var i = 0; i < 3; i++) {
        var b = boule(p)
        b.scale.setScalar(0.62)
        g.add(b)
        balls.push(b)
      }
      return { group: g, balls: balls }
    }

    function updatePetanque(scn, q) {
      scn.group.rotation.x = -0.34

      // Les trois boules partent décalées : elles arrivent l'une après l'autre,
      // comme une vraie mène.
      for (var i = 0; i < scn.balls.length; i++) {
        var t = clamp01((q - i * 0.16) / 0.5)
        var e = ease(t)
        var b = scn.balls[i]
        var target = [[-0.75, 0.5], [0.85, -0.35], [0.25, 0.95]][i]
        b.position.set(lerp(-9, target[0], e), 0.38, lerp(3.2 + i, target[1], e))
        // La rotation suit la distance parcourue : une boule qui glisse sans
        // tourner se voit tout de suite.
        b.rotation.z = -(b.position.x + 9) * 1.5
      }
    }

    /**
     * Les cinq scènes, posées en enfilade.
     *
     * Elles ne montent plus dans le cadre l'une après l'autre : elles sont
     * plantées à des profondeurs croissantes le long de -Z, et c'est la caméra
     * qui les traverse au fil du défilement. Un couloir, pas un tapis roulant.
     *
     * `ox`/`oy` sont l'écart latéral et la hauteur de la scène dans le couloir.
     * `ox = 0` veut dire : plein axe, la caméra passe dedans — c'est le cas de
     * la borne, dont on traverse la porte ouverte.
     *
     * `from`/`to` et `stationZ` ne sont pas écrits ici : ils sont calculés au
     * démarrage à partir de la position réelle des sections de texte de la
     * page (cf. assignStations). C'est ce qui « cale » l'animation sur le
     * contenu au lieu de la caler sur un pourcentage deviné, et ça marche sur
     * n'importe laquelle des vingt pages du site.
     */
    /**
     * `exitAt` / `entryAt` : où la balle quitte une scène, où elle entre dans
     * la suivante — en coordonnées LOCALES de la scène, converties en monde au
     * moment voulu.
     *
     * Elles ne sont pas recopiées à la main depuis les animations : ce sont
     * littéralement les mêmes triplets que dans les `update`, et le passage en
     * coordonnées monde traverse la matrice réelle du groupe, rotations
     * comprises. Un point recopié à la main serait juste au premier essai puis
     * faux dès qu'une rotation change — et une balle qui se téléporte de sept
     * unités entre deux scènes est exactement ce qui casse l'illusion qu'il
     * n'y en a qu'une.
     *
     * `relayColor` est la couleur de la balle qui part : celle du sport qu'on
     * vient de voir, puisque c'est lui qu'on suit vers le suivant.
     */
    var SCENE_DEFS = [
      { key: 'kiosk', ox: 0, oy: -0.6, make: makeKiosk, update: updateKiosk,
        // Sortie par le casier ouvert (y = 0,18, la cote du gabarit), déjà
        // devant la caméra qui vient de traverser la porte.
        exitAt: [0, 0.18, -10], relayColor: 0xd8e64a },
      { key: 'tennis', ox: 0, oy: -4.0, make: makeTennis, update: updateTennis,
        // Le point d'arrivée du smash, à la virgule près.
        exitAt: [-1.2, 3.3, -10], relayColor: 0xd8e64a },
      { key: 'hoop', ox: 4.2, oy: 0.6, make: makeHoop, update: updateHoop,
        // Le départ du premier tir, et la sortie du ballon sous le filet.
        entryAt: [-4.0, 1.4, 12], exitAt: [0.9, -8, 1.2], relayColor: 0xf0a463 },
      { key: 'petanque', ox: 3.0, oy: -4.6, make: makePetanque, update: updatePetanque,
        // Le point de lâcher de la première boule.
        entryAt: [-9, 0.38, 3.2] },
    ]

    /**
     * Le vol de la caméra est un montage, pas un travelling uniforme.
     *
     * Une caméra qui avance à vitesse constante donne exactement ce qu'on
     * avait : chaque objet traverse le champ en trois secondes et rien ne se
     * regarde. Un plan de drone fait l'inverse — il se pose sur son sujet, y
     * reste le temps qu'il se passe quelque chose, puis file vers le suivant.
     *
     * La vitesse est donc alternée : lente pendant le plan (24 unités sur 12 %
     * de la page), rapide pendant la liaison (40 unités sur 8 %). Deux fois et
     * demie plus rapide en transit — c'est ce rapport qui fait qu'un plan se
     * sent comme un plan.
     */
    var FLIGHT_Z0 = 18
    var STATION_APPROACH = 18   // où le drone prend son plan, devant la station
    var STATION_EXIT = 6        // de combien il la dépasse en repartant
    var STATION_TRANSIT = 40    // distance parcourue entre deux plans
    var STATION_STEP = STATION_APPROACH + STATION_EXIT + STATION_TRANSIT

    // Le plan tenu, en fraction de page, autour de la station.
    var HOLD_BEFORE = 0.09
    var HOLD_AFTER = 0.03
    // Le recouvrement de deux plans. C'est lui, et lui seul, qui enchaîne :
    // pendant la liaison les deux poids se croisent, et le regard de la caméra
    // glisse du sujet qu'on quitte à celui qui arrive au lieu de sauter.
    var HOLD_EDGE = 0.06
    // Écart minimal entre deux stations : en dessous, la liaison n'a plus la
    // place d'exister et les deux plans se marchent dessus.
    var MIN_GAP = 0.17

    // La fenêtre de rendu d'une scène, plus large que son plan : elle doit
    // exister avant qu'on la regarde, pour émerger du brouillard.
    var WIN_BEFORE = 0.20
    var WIN_AFTER = 0.08

    // La chorégraphie interne (le tir, la frappe, la mène) est calée sur le
    // plan tenu, pas sur la fenêtre de rendu : elle se joue pendant qu'on
    // regarde, jamais pendant l'approche où l'objet est encore dans le
    // brouillard.
    var ACTION_FROM = 0.42
    var ACTION_TO = 0.88

    function actionQ(q) {
      return clamp01((q - ACTION_FROM) / (ACTION_TO - ACTION_FROM))
    }

    function smooth(u) {
      return u * u * (3 - 2 * u)
    }

    /**
     * La liaison en cours, s'il y en a une.
     *
     * Renvoie l'indice du plan qu'on quitte, l'avancement dans la liaison, et
     * un poids en cloche qui vaut 1 en plein milieu. Nul pendant les plans
     * tenus : là, c'est le sujet qui commande le cadrage, pas le relais.
     */
    function currentTransit(p) {
      for (var i = 0; i < scenes.length - 1; i++) {
        var a = scenes[i].holdTo
        var b = scenes[i + 1].holdFrom
        if (b <= a) continue
        if (p >= a && p <= b) {
          var u = (p - a) / (b - a)
          return { i: i, u: u, w: Math.sin(Math.PI * clamp01(u)) }
        }
      }
      return null
    }

    /**
     * Le relais : la balle qui relie deux scènes.
     *
     * C'est la pièce qui manquait pour que ça s'enchaîne au lieu de se
     * succéder. Sans elle, la liaison est un trajet dans le brouillard entre
     * deux sujets — quarante unités pendant lesquelles il n'y a rien à
     * regarder. Avec elle, on quitte une scène en suivant l'objet qu'elle
     * vient d'envoyer, et cet objet nous dépose dans la suivante.
     *
     * Elle part de la sortie du plan précédent et arrive à l'entrée du
     * suivant, en restant quatre à six unités devant la caméra sur tout le
     * trajet — assez près pour qu'on la lise, assez loin pour qu'elle mène.
     */
    /**
     * Le point de passage d'une scène, en coordonnées monde.
     *
     * Passe par la matrice du groupe : la scène a une rotation propre, et un
     * point exprimé dans son repère n'est pas au même endroit selon l'angle.
     * Repli sur le centre de la station si la scène n'est pas encore rendue —
     * en pratique elle l'est toujours, sa fenêtre de rendu commençant bien
     * avant la liaison.
     */
    function handoff(scn, local, fallbackZ, out) {
      if (local && scn.group.visible) {
        scn.group.updateMatrixWorld()
        out.set(local[0], local[1], local[2]).applyMatrix4(scn.group.matrixWorld)
        return out
      }
      return out.set(scn.def.ox * scn.xf, scn.def.oy, scn.stationZ + fallbackZ)
    }

    function placeRelay(progress) {
      if (!relay) return null
      var t = currentTransit(progress)
      if (!t) { relay.visible = false; return null }

      var A = scenes[t.i]
      var B = scenes[t.i + 1]
      var u = t.u

      handoff(A, A.def.exitAt, -10, RELAY_A)
      handoff(B, B.def.entryAt, 12, RELAY_B)

      relay.position.set(
        lerp(RELAY_A.x, RELAY_B.x, u),
        // La cloche verticale : une balle qui relie deux points en ligne
        // droite ne ressemble à rien. Une parabole, si.
        lerp(RELAY_A.y, RELAY_B.y, u) + Math.sin(Math.PI * u) * 2.4,
        lerp(RELAY_A.z, RELAY_B.z, u),
      )
      relay.rotation.x += 0.14
      relay.rotation.y += 0.09

      var col = A.def.relayColor
      if (col && relay.userData.col !== col) {
        relay.material.color.setHex(col)
        relay.userData.col = col
      }
      relay.visible = true
      return t
    }

    /**
     * Le poids d'un plan à un instant du défilement : un plateau à 1 pendant
     * le plan tenu, des flancs en smoothstep de part et d'autre.
     *
     * Le plateau est le point : une cloche (ce qu'il y avait avant) ne tient
     * jamais son cadrage, elle ne fait que passer par lui. Et comme
     * smoothstep(u) + smoothstep(1-u) = 1 exactement, deux flancs qui se
     * croisent somment toujours à 1 : la liaison est continue par
     * construction, sans cas particulier.
     */
    function shotWeight(scn, p) {
      var a = scn.holdFrom - HOLD_EDGE
      var b = scn.holdFrom
      var c = scn.holdTo
      var d = scn.holdTo + HOLD_EDGE
      if (p <= a || p >= d) return 0
      if (p < b) return smooth((p - a) / (b - a))
      if (p <= c) return 1
      return smooth((d - p) / (d - c))
    }

    /**
     * La position de la caméra sur l'axe du couloir, à un instant donné.
     *
     * Monotone décroissante par construction : la caméra n'avance jamais à
     * reculons, quelle que soit la répartition des stations.
     */
    function flightZ(p) {
      var n = scenes.length
      if (!n) return FLIGHT_Z0
      var first = scenes[0]
      if (p <= first.holdFrom) {
        var u0 = first.holdFrom > 0.0001 ? clamp01(p / first.holdFrom) : 1
        return lerp(FLIGHT_Z0 + 8, first.stationZ + STATION_APPROACH, smooth(u0))
      }
      for (var i = 0; i < n; i++) {
        var scn = scenes[i]
        if (p <= scn.holdTo) {
          var u = clamp01((p - scn.holdFrom) / Math.max(scn.holdTo - scn.holdFrom, 0.0001))
          return lerp(scn.stationZ + STATION_APPROACH, scn.stationZ - STATION_EXIT, smooth(u))
        }
        var nx = scenes[i + 1]
        if (!nx) break
        if (p <= nx.holdFrom) {
          var v = clamp01((p - scn.holdTo) / Math.max(nx.holdFrom - scn.holdTo, 0.0001))
          return lerp(scn.stationZ - STATION_EXIT, nx.stationZ + STATION_APPROACH, smooth(v))
        }
      }
      var last = scenes[n - 1]
      var w = clamp01((p - last.holdTo) / Math.max(1 - last.holdTo, 0.0001))
      return last.stationZ - STATION_EXIT - w * 26
    }

    /**
     * Place les stations sur les sections de texte de la page.
     *
     * On mesure le centre de chaque section, on le convertit en fraction de
     * défilement, et on répartit les scènes sur les sections disponibles. Une
     * scène arrive donc pile quand le lecteur est au milieu d'un bloc de
     * texte — le décor et le propos avancent ensemble.
     *
     * Repli sur un espacement régulier si la page n'a pas assez de sections
     * (les pages légales, par exemple) : mieux vaut un rythme approximatif
     * qu'une cascade qui ne se déclenche pas.
     */
    function assignStations() {
      var max = document.documentElement.scrollHeight - window.innerHeight
      if (max <= 0 || !scenes.length) return
      lastDocHeight = document.documentElement.scrollHeight

      var marks = []
      try {
        var nodes = document.querySelectorAll('[data-cascade-beat], main section, main > article')
        for (var i = 0; i < nodes.length; i++) {
          var r = nodes[i].getBoundingClientRect()
          var centre = r.top + window.scrollY + r.height / 2
          var f = (centre - window.innerHeight / 2) / max
          if (f > 0.03 && f < 0.97) marks.push(f)
        }
      } catch (e) {}
      marks.sort(function (a, b) { return a - b })

      // On part d'un rythme régulier — c'est lui qui fait le montage — puis on
      // aimante chaque plan sur la section de texte la plus proche, sans
      // jamais descendre sous MIN_GAP. Prendre les sections telles quelles
      // donnait des écarts de 0,14 à 0,25 : les liaisons courtes n'avaient
      // plus la place d'exister et deux plans se marchaient dessus.
      // L'amplitude suit le nombre de plans, elle n'est pas fixe : sur
      // téléphone il n'y a que deux scènes, et les étaler de 0,10 à 0,90
      // laissait les deux tiers de la page avec une caméra qui rampe dans le
      // vide. Trente pour cent de page par plan, centrés, plafonnés à 0,80.
      var n = scenes.length
      var span = n > 1 ? Math.min(0.80, (n - 1) * 0.30) : 0
      var start = Math.max(0.10, (1 - span) / 2)
      var prev = -1
      for (var k = 0; k < n; k++) {
        var ideal = n > 1 ? start + (k / (n - 1)) * span : 0.5
        var at = ideal
        var best = 1
        for (var m = 0; m < marks.length; m++) {
          var dist = Math.abs(marks[m] - ideal)
          // Aimantation courte : au-delà, on garde le rythme régulier plutôt
          // que d'aller chercher une section qui casse la cadence.
          if (dist < best && dist < 0.07) { best = dist; at = marks[m] }
        }
        if (prev >= 0 && at - prev < MIN_GAP) at = prev + MIN_GAP
        prev = at

        var scn = scenes[k]
        scn.at = at
        scn.from = at - WIN_BEFORE
        scn.to = at + WIN_AFTER
        scn.holdFrom = at - HOLD_BEFORE
        scn.holdTo = at + HOLD_AFTER
        // Les stations sont régulièrement espacées dans le couloir, quelle que
        // soit la répartition des plans dans la page : c'est la vitesse de la
        // caméra qui s'adapte, pas la géométrie.
        scn.stationZ = -k * STATION_STEP
      }
    }

    /**
     * Ce que la caméra fait pendant chaque scène.
     *
     * Une caméra immobile devant un décor qui défile, c'est une vitrine. Ce qui
     * fait le cinéma, c'est que le point de vue prenne parti : il se penche vers
     * ce qui compte, se rapproche au moment de l'impact, et repart. Chaque scène
     * a donc son plan.
     *
     * `x`, `y`, `z` sont un écart à la position de repos, pas une position
     * absolue : le mouvement se superpose au travelling lent qui traverse toute
     * la page, au lieu de l'écraser.
     *
     * `lookX`/`lookY` déplacent le point visé — c'est ce décalage, plus que le
     * déplacement lui-même, qui donne l'impression d'un regard. `fov` resserre
     * le champ : resserrer pendant qu'on avance est le vieux truc qui fait
     * qu'un rapprochement se sent au lieu de se constater.
     *
     * `roll` incline l'horizon de quelques dixièmes de degré. À cette dose
     * personne ne le remarque consciemment, et tout le monde trouve l'image
     * plus vivante.
     */
    var CAMERA_BEATS = {
      // Le casier vient de loin vers nous : la caméra recule pour lui laisser la
      // place d'arriver, et plonge vers le bas, d'où il monte. C'est le seul
      // plan où elle cède du terrain — partout ailleurs elle va au-devant.
      // `thread` : ce plan ne regarde pas la borne, il la traverse. La caméra
      // s'aligne sur le casier ouvert (le n° 3 du gabarit, à y = 0,18 dans le
      // repère du meuble) et plonge dedans. 0,18 n'est pas un réglage à l'œil :
      // c'est la cote du casier dans `layout`, et si le gabarit change il faut
      // la reprendre là.
      kiosk:    { x: 0,    y: 0.18, z: 0,    lookX: 0,    lookY: 0.18, fov: 1.12, roll: 0, thread: true },
      // Le panier est à droite : on se penche franchement de son côté, on avance
      // et on resserre. Avancer en resserrant est le vieux truc qui fait qu'un
      // rapprochement se sent au lieu de se constater.
      hoop:     { x: 2.2,  y: 0.8,  z: 0,    lookX: 3.6,  lookY: 0.7,  fov: 0.88, roll: -0.012 },
      // Le terrain est large : on prend de la hauteur et on ouvre le champ, le
      // seul moment du site où le décor respire au lieu de se refermer.
      // Le tennis se joue à hauteur de balle : la caméra remonte de trois
      // unités et demie au-dessus du sol du court, sinon on regarde le tracé
      // et pas l'échange.
      tennis:   { x: 1.0,  y: 3.6,  z: 0,    lookX: 1.4,  lookY: 3.0,  fov: 1.00, roll: 0.008 },
      // La pétanque se joue au sol : on descend au ras du sable et on regarde
      // vers le bas.
      petanque: { x: 1.8,  y: -1.4, z: 0,    lookX: 2.8,  lookY: -2.0, fov: 0.94, roll: -0.010 },
    }

    // ─── Mise en place ────────────────────────────────────────────────────────

    /**
     * Le post-traitement, écrit à la main.
     *
     * Il n'y a pas d'EffectComposer ici, et c'est délibéré : il vit dans les
     * `examples/` de three.js, qu'il faudrait charger depuis un CDN. Un script
     * externe qui n'arrive pas, c'est un hero noir en production, découvert par
     * un client. Quatre passes écrites ici ne peuvent pas ne pas arriver.
     *
     * La chaîne :
     *   scène ─→ cible pleine résolution
     *          ─→ extraction des hautes lumières (demi-résolution)
     *          ─→ flou horizontal ─→ flou vertical
     *          ─→ composition : halo + vignettage + grain + aberration
     *
     * Le coût tient dans les trois passes en demi-résolution, soit un quart des
     * pixels chacune. C'est ce qui rend l'effet payable ; c'est aussi pourquoi
     * il reste coupé sur téléphone, où le GPU est déjà le facteur limitant.
     *
     * L'alpha traverse toute la chaîne. La cascade est posée derrière le
     * contenu de la page, à travers lequel on doit continuer de voir : une
     * composition qui sortirait alpha = 1 recouvrirait le site d'un rectangle
     * opaque. L'alpha final est le maximum entre celui de la scène et le halo,
     * sans quoi le halo s'arrêterait net au bord des objets.
     */
    var FX_VERT = [
      'varying vec2 vUv;',
      'void main() { vUv = uv; gl_Position = vec4(position.xy, 0.0, 1.0); }',
    ].join('\n')

    var FX_BRIGHT = [
      'uniform sampler2D tDiffuse; uniform float threshold; varying vec2 vUv;',
      'void main() {',
      '  vec4 c = texture2D(tDiffuse, vUv);',
      '  float l = dot(c.rgb, vec3(0.2126, 0.7152, 0.0722));',
      '  float k = smoothstep(threshold, threshold + 0.30, l);',
      '  gl_FragColor = vec4(c.rgb * k, c.a * k);',
      '}',
    ].join('\n')

    // Gaussienne à cinq prises, décalages non entiers : l'interpolation
    // linéaire du GPU fait le travail de neuf prises pour le prix de cinq.
    var FX_BLUR = [
      'uniform sampler2D tDiffuse; uniform vec2 dir; varying vec2 vUv;',
      'void main() {',
      '  vec4 sum = texture2D(tDiffuse, vUv) * 0.2270270270;',
      '  sum += texture2D(tDiffuse, vUv + dir * 1.3846153846) * 0.3162162162;',
      '  sum += texture2D(tDiffuse, vUv - dir * 1.3846153846) * 0.3162162162;',
      '  sum += texture2D(tDiffuse, vUv + dir * 3.2307692308) * 0.0702702703;',
      '  sum += texture2D(tDiffuse, vUv - dir * 3.2307692308) * 0.0702702703;',
      '  gl_FragColor = sum;',
      '}',
    ].join('\n')

    var FX_COMPOSE = [
      'uniform sampler2D tScene; uniform sampler2D tBloom;',
      'uniform float bloom; uniform float vignette; uniform float grain;',
      'uniform float aberration; uniform float time;',
      'varying vec2 vUv;',
      'void main() {',
      '  vec2 off = vUv - 0.5;',
      '  float r2 = dot(off, off);',
      // L'aberration croît avec le carré de la distance au centre : nulle au
      // milieu de l'image, visible dans les angles. C'est le comportement d'un
      // vrai objectif, et c'est ce qui la rend crédible plutôt que décorative.
      '  float a = aberration * r2;',
      '  vec4 s = texture2D(tScene, vUv);',
      '  vec3 col = vec3(',
      '    texture2D(tScene, vUv + off * a).r,',
      '    s.g,',
      '    texture2D(tScene, vUv - off * a).b',
      '  );',
      '  vec4 b = texture2D(tBloom, vUv);',
      '  col += b.rgb * bloom;',
      '  col *= 1.0 - vignette * r2;',
      '  float n = fract(sin(dot(vUv * 1000.0 + time, vec2(12.9898, 78.233))) * 43758.5453);',
      '  col += (n - 0.5) * grain;',
      '  gl_FragColor = vec4(col, clamp(max(s.a, b.a * bloom), 0.0, 1.0));',
      '}',
    ].join('\n')

    /**
     * Une cible de rendu.
     *
     * Pas de multi-échantillonnage ici, et c'est un choix appuyé sur un échec :
     * `WebGLMultisampleRenderTarget` a rendu la page entièrement noire. Le gain
     * ne valait pas de déboguer un chemin qui dépend de l'extension et du pilote
     * sur la page d'accueil d'un site commercial.
     *
     * Le lissage passe donc par le suréchantillonnage — voir SUPER plus bas.
     */
    function makeRT(w, h) {
      return new THREE.WebGLRenderTarget(Math.max(2, Math.floor(w)), Math.max(2, Math.floor(h)), {
        minFilter: THREE.LinearFilter,
        magFilter: THREE.LinearFilter,
        format: THREE.RGBAFormat,
        depthBuffer: true,
        stencilBuffer: false,
      })
    }

    /**
     * Facteur de suréchantillonnage.
     *
     * Le `antialias: true` du renderer ne vaut que pour le dessin direct à
     * l'écran : dès que la scène est rendue dans une cible intermédiaire — ce
     * que fait le post-traitement — il ne s'applique plus. Les arêtes fines
     * redeviennent crénelées, et sur la borne, dont les poignées font 18
     * millièmes d'unité et les jeux de porte trois centièmes, ça se lisait comme
     * des stries verticales sur toute la façade.
     *
     * On rend donc la scène à une fois et demie la taille de l'écran et on la
     * réduit à la composition : le filtre linéaire moyenne les pixels, ce qui
     * est exactement ce que fait un antialiasing. Coût : 2,25 fois plus de
     * pixels sur la seule passe de scène. C'est le prix du post-traitement, et
     * il reste réservé au desktop.
     */
    var SUPER = 1.5

    function buildFx(narrow) {
      // Coupé sur téléphone et en mouvement réduit. Sur téléphone c'est le GPU
      // qui commande ; en mouvement réduit, le grain est précisément le genre de
      // scintillement qu'on nous demande d'éteindre.
      if (narrow || reduced) return null
      // Interrupteur de diagnostic : ?fx=0 dans l'URL coupe tout le
      // post-traitement. C'est ce qui permet de trancher en deux captures si un
      // défaut vient de la chaîne d'effets ou du modèle lui-même — au lieu
      // d'émettre des hypothèses, ce qui m'a coûté trois corrections inutiles.
      // L'interrupteur est collant : une fois posé par ?fx=0 il tient pour
      // tout l'onglet, y compris après avoir cliqué sur un lien du menu — un
      // lien interne ne transporte pas la chaîne de requête, et sans ça le
      // diagnostic se perdait dès la deuxième page.
      try {
        var q = new URLSearchParams(location.search).get('fx')
        if (q !== null) sessionStorage.setItem('sl-fx', q)
        if (sessionStorage.getItem('sl-fx') === '0') return null
      } catch (e) {}
      try {
        var w = window.innerWidth, h = window.innerHeight
        var pr = renderer.getPixelRatio()
        var half = { w: (w * pr) / 2, h: (h * pr) / 2 }

        var quadScene = new THREE.Scene()
        var quadCam = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1)
        var geo = new THREE.PlaneGeometry(2, 2)

        function pass(frag, uniforms) {
          var mat = new THREE.ShaderMaterial({
            uniforms: uniforms,
            vertexShader: FX_VERT,
            fragmentShader: frag,
            depthTest: false,
            depthWrite: false,
            // Sans blending, le fragment remplace le tampon tel quel, alpha
            // compris. Avec NormalBlending sur un tampon effacé à zéro, la
            // couleur serait multipliée par son propre alpha et l'image
            // s'assombrirait à chaque passe.
            blending: THREE.NoBlending,
          })
          return mat
        }

        var mesh = new THREE.Mesh(geo, null)
        quadScene.add(mesh)

        return {
          scene: quadScene,
          cam: quadCam,
          mesh: mesh,
          geo: geo,
          sceneRT: makeRT(w * pr * SUPER, h * pr * SUPER),
          rtA: makeRT(half.w, half.h),
          rtB: makeRT(half.w, half.h),
          bright: pass(FX_BRIGHT, {
            tDiffuse: { value: null },
            // Seuil bas : le décor est sombre, et ce qu'on veut faire rayonner
            // ce sont les liserés de marque et l'arceau, pas des blancs purs
            // qui n'existent nulle part dans cette palette.
            threshold: { value: 0.22 },
          }),
          blur: pass(FX_BLUR, { tDiffuse: { value: null }, dir: { value: new THREE.Vector2() } }),
          compose: pass(FX_COMPOSE, {
            tScene: { value: null },
            tBloom: { value: null },
            bloom: { value: 0.9 },
            vignette: { value: 0.55 },
            grain: { value: 0.05 },
            aberration: { value: 0.0075 },
            time: { value: 0 },
          }),
          half: half,
        }
      } catch (e) {
        // Un GPU qui refuse une cible de rendu, un contexte perdu : on retombe
        // sur le rendu direct plutôt que sur un écran noir.
        return null
      }
    }

    /** Dessine une passe plein écran vers `target` (null = écran). */
    function blit(mat, target) {
      fx.mesh.material = mat
      renderer.setRenderTarget(target)
      renderer.clear()
      renderer.render(fx.scene, fx.cam)
    }

    function renderFrame(now) {
      if (!fx) {
        renderer.setRenderTarget(null)
        renderer.render(scene, camera)
        return
      }
      try {
        renderer.setRenderTarget(fx.sceneRT)
        renderer.clear()
        renderer.render(scene, camera)

        fx.bright.uniforms.tDiffuse.value = fx.sceneRT.texture
        blit(fx.bright, fx.rtA)

        fx.blur.uniforms.tDiffuse.value = fx.rtA.texture
        fx.blur.uniforms.dir.value.set(1.4 / fx.half.w, 0)
        blit(fx.blur, fx.rtB)

        fx.blur.uniforms.tDiffuse.value = fx.rtB.texture
        fx.blur.uniforms.dir.value.set(0, 1.4 / fx.half.h)
        blit(fx.blur, fx.rtA)

        fx.compose.uniforms.tScene.value = fx.sceneRT.texture
        fx.compose.uniforms.tBloom.value = fx.rtA.texture
        // Le grain doit sauter d'une image à l'autre, sinon c'est une texture
        // collée sur l'écran et non du grain.
        fx.compose.uniforms.time.value = (now % 1000) / 1000
        blit(fx.compose, null)
      } catch (e) {
        // Une erreur en cours de chaîne laisserait l'écran sur la dernière
        // image : on désarme définitivement et on repasse en rendu direct.
        fx = null
        renderer.setRenderTarget(null)
        renderer.render(scene, camera)
      }
    }

    function build() {
      var p = palette()
      var narrow = window.innerWidth < 768
      // Moins d'objets sur téléphone : même densité apparente sur un écran trois
      // fois plus étroit, et une charge GPU qui reste honnête sur batterie.
      // Quinze objets en vol faisaient un confetti : l'œil ne se posait sur
      // aucun, et chacun coûtait des polygones qu'on refusait ensuite aux
      // scènes. Quatre suffisent à tenir la profondeur, et ils sont désormais
      // relégués très en arrière — présents pour l'échelle, pas pour être
      // regardés. Le propos, ce sont les scènes.
      var count = narrow ? 2 : 4

      scene = new THREE.Scene()
      // Les objets d'ambiance vivent dans un groupe qui suit la caméra en
      // profondeur. Sans lui ils resteraient plantés à z ≈ -10 pendant que la
      // caméra s'enfonce de deux cents unités : le couloir se viderait dès la
      // deuxième scène.
      ambient = new THREE.Group()

      // Le relais, créé une fois pour toutes : une seule balle change de
      // couleur d'une liaison à l'autre plutôt que quatre balles qui
      // apparaissent et disparaissent.
      relay = new THREE.Mesh(
        new THREE.SphereGeometry(0.26, 18, 14),
        new THREE.MeshStandardMaterial({ color: 0xd8e64a, roughness: 0.8, metalness: 0.04 }),
      )
      relay.visible = false
      RELAY_A = new THREE.Vector3()
      RELAY_B = new THREE.Vector3()
      fogColor = new THREE.Color(p.fog)
      // Le brouillard n'est plus un fond : c'est le volet. Une scène naît à
      // 48 unités et se dégage à 12 — soit exactement la fenêtre pendant
      // laquelle la caméra l'approche. On ne voit jamais un objet apparaître,
      // on le voit émerger.
      scene.fog = new THREE.Fog(p.fog, 14, 62)

      camera = new THREE.PerspectiveCamera(
        narrow ? 58 : 46,
        window.innerWidth / window.innerHeight,
        0.1,
        110,
      )
      camera.position.set(0, 0, 15.2)

      // L'état amorti part de la position de repos, sinon la première image
      // rattrape depuis (0,0,14) une cible déjà décalée et le décor entre en
      // glissant, ce qui ressemble à un bug de chargement.
      cam.baseFov = camera.fov
      cam.fov = camera.fov
      cam.narrow = narrow
      cam.pos.x = 0
      cam.pos.y = 0
      cam.pos.z = 15.2
      cam.look.x = 0
      cam.look.y = 0
      cam.roll = 0

      scene.add(ambient)
      scene.add(relay)
      scene.add(new THREE.AmbientLight(0xffffff, p.ambient))
      var key = new THREE.DirectionalLight(p.key, p.keyIntensity)
      key.position.set(-6, 9, 8)
      scene.add(key)
      // La lumière d'appoint vient de derrière : c'est elle qui pose le liseré
      // vert sur les arêtes et détache les objets du fond.
      var rim = new THREE.DirectionalLight(p.rim, p.rimIntensity)
      rim.position.set(7, -4, -6)
      scene.add(rim)

      // Sur téléphone le champ visible est bien plus étroit qu'il n'y paraît :
      // à 5,2 la moitié des objets tombait hors cadre et la cascade
      // disparaissait presque.
      var spreadX = narrow ? 3 : 11
      for (var i = 0; i < count; i++) {
        var obj = FACTORIES[i % FACTORIES.length](p)

        // Répartition sur trois plans de profondeur. Les objets du fond sont
        // plus petits et plus avalés par le brouillard : c'est ce qui donne le
        // volume, plus que le nombre d'objets.
        // Trois plans, tous repoussés vers le fond : au premier essai les objets
        // du plan avant arrivaient à la taille d'une carte du contenu.
        var depth = [-13, -10.5, -8][i % 3]
        var scale = (depth < -12 ? 0.5 : depth < -9 ? 0.6 : 0.7) * (narrow ? 0.72 : 1)

        obj.scale.setScalar(scale)
        obj.position.set(
          // Décalé de façon irrégulière : une répartition régulière se lit
          // immédiatement comme une grille.
          (((i * 2.39) % 2) - 1) * spreadX + (i % 2 ? 0.8 : -0.8),
          -LANE / 2 + ((i + 0.5) / count) * LANE,
          depth,
        )
        obj.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, Math.random() * Math.PI)

        // Le flux ambiant est ramené à mi-chemin du fond, les scènes gardent
        // leur pleine couleur. Sans cette hiérarchie, un ballon orange qui
        // passe derrière un titre pèse plus lourd que le titre — et il n'a rien
        // à raconter, lui. C'est la profondeur qui décide de la dose : un objet
        // du plan avant est plus proche, donc moins avalé.
        var mix = depth < -8 ? 0.62 : depth < -4 ? 0.52 : 0.42
        obj.traverse(function (n) {
          if (!n.material || !n.material.color) return
          n.material = n.material.clone()
          n.material.color.lerp(fogColor, mix)
        })

        objects.push({
          group: obj,
          baseY: obj.position.y,
          // Vitesse propre légère : tous les objets ne tombent pas du même pas,
          // sinon la cascade ressemble à un tapis roulant.
          rate: 0.85 + ((i * 37) % 30) / 100,
          spin: {
            x: (((i * 13) % 7) - 3) * 0.0006,
            y: (((i * 29) % 9) - 4) * 0.0008,
            z: (((i * 17) % 5) - 2) * 0.0005,
          },
        })
        ambient.add(obj)
      }

      // Les scènes. Sur téléphone on garde le panier et le terrain — ce sont
      // eux qui portent le propos — et on laisse tomber la pétanque, qui est la
      // plus décorative des trois.
      for (var j = 0; j < SCENE_DEFS.length; j++) {
        var def = SCENE_DEFS[j]
        // Sur téléphone, deux scènes : la borne (le produit) et le panier
        // (celle qui se lit le mieux dans un cadre étroit).
        if (narrow && def.key !== 'kiosk' && def.key !== 'hoop') continue
        var built = def.make(p)
        built.def = def
        built.group.scale.setScalar(narrow ? 0.68 : 1)
        // Réduire la taille ne suffit pas : sur téléphone le champ visible est
        // deux fois plus étroit, et une scène posée à x = 5 tombe entièrement
        // hors cadre. Les mises à jour multiplient donc leur écart au centre
        // par ce facteur.
        built.xf = narrow ? 0.45 : 1
        built.group.visible = false
        scene.add(built.group)
        scenes.push(built)
      }

      renderer = new THREE.WebGLRenderer({ alpha: true, antialias: !narrow })
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, narrow ? 1.5 : 2))
      renderer.setSize(window.innerWidth, window.innerHeight)
      renderer.setClearColor(0x000000, 0)
      // Courbe tonale de cinéma. Sans elle, tout ce qui dépasse la valeur 1
      // s'écrase en aplat : un reflet spéculaire devient une tache blanche au
      // lieu de rouler sur la surface. ACES est la courbe des films, et c'est
      // exactement ce qu'on cherche ici.
      renderer.toneMapping = THREE.ACESFilmicToneMapping
      renderer.toneMappingExposure = 1.15
      // Sans encodage sRGB en sortie, les couleurs sont calculées dans un espace
      // et affichées dans un autre : le décor paraît délavé et les ombres
      // bouchées. C'est le réglage le plus invisible et le plus déterminant.
      renderer.outputEncoding = THREE.sRGBEncoding
      host.appendChild(renderer.domElement)

      // Poignée de mise au point. Le décor n'a pas d'interface et ne laisse
      // aucune trace dans le DOM : sans ça, la seule façon de savoir pourquoi
      // une scène ne s'affiche pas est de deviner. Coût : une référence.
      // L'environnement a besoin du renderer : il est donc construit ici et non
      // dans build(), où le renderer n'existe pas encore.
      try {
        var pmrem = new THREE.PMREMGenerator(renderer)
        var envScene = buildEnvironment(p)
        var envRT = pmrem.fromScene(envScene, 0.04)
        scene.environment = envRT.texture
        pmrem.dispose()
      } catch (e) {
        // Un GPU qui refuse PMREM : on garde les lumières directes, le décor
        // reste correct, simplement plus mat.
      }

      assignStations()

      fx = buildFx(narrow)
      // Marqueur de version. Sans lui, impossible de savoir si ce qu'on regarde
      // est bien le code qu'on vient d'écrire — un onglet gardé ouvert ou le
      // site en production ressemblent exactement à la page de développement.
      try {
        console.info(
          '[cascade] ' + CASCADE_BUILD +
          ' · post-traitement ' + (fx ? 'actif' : 'coupé') +
          ' · ' + (narrow ? 'mobile' : 'desktop'),
        )
        // Les stations, telles qu'elles ont réellement été calculées sur cette
        // page. Sans ce relevé, un rythme qui tombe mal ne se distingue pas
        // d'une scène cassée : là on voit tout de suite si la station est au
        // mauvais endroit ou si c'est l'animation qui ne joue pas.
        console.info(
          '[cascade] stations · ' +
          scenes.map(function (s) {
            return s.def.key + ' @' + s.at.toFixed(3) +
              ' plan[' + s.holdFrom.toFixed(2) + '→' + s.holdTo.toFixed(2) + ']' +
              ' z=' + s.stationZ.toFixed(0)
          }).join('  |  '),
        )
      } catch (e) {}
      window.__slCascade = {
        build: CASCADE_BUILD,
        scene: scene, camera: camera, scenes: scenes, objects: objects,
        fx: function () { return !!fx },
      }
    }

    // ─── Boucle ───────────────────────────────────────────────────────────────

    function scrollProgress() {
      var doc = document.documentElement
      var max = doc.scrollHeight - window.innerHeight
      if (max <= 0) return 0
      return Math.min(Math.max(window.scrollY / max, 0), 1)
    }

    function playScenes(progress) {
      for (var i = 0; i < scenes.length; i++) {
        var scn = scenes[i]
        if (scn.from === undefined) continue
        var q = (progress - scn.from) / (scn.to - scn.from)
        // Hors fenêtre, la scène sort du rendu : c'est ce qui permet d'en avoir
        // cinq sans que la page coûte cinq fois plus cher.
        if (q < -0.02 || q > 1.02) {
          scn.group.visible = false
          continue
        }
        scn.group.visible = true
        // La scène est plantée à sa station. Elle ne bouge plus : c'est le
        // point fixe autour duquel la caméra travaille.
        scn.group.position.set(scn.def.ox * scn.xf, scn.def.oy, scn.stationZ)
        scn.def.update(scn, actionQ(clamp01(q)))
      }
    }

    /**
     * Le cadrage d'une image.
     *
     * Trois couches qui s'additionnent :
     *   1. un travelling lent qui traverse toute la page — la caméra avance de
     *      trois unités du haut au bas du site, ce qui suffit à ce qu'on sente
     *      qu'on descend dans le décor plutôt que devant lui ;
     *   2. le plan de la scène active, pondéré par sa cloche ;
     *   3. une respiration et le parallaxe à la souris, tous deux coupés en
     *      mouvement réduit — ce sont les seules parties qui bougent sans que le
     *      visiteur ait rien demandé.
     *
     * Les plans se cumulent au lieu de s'exclure : quand deux scènes se
     * chevauchent, la caméra passe de l'une à l'autre en glissant, sans coupure.
     */
    function frameCamera(progress, now) {
      // Le cadrage est composé DANS le repère de la scène regardée, pas en
      // écarts abstraits : on veut « le drone se place à deux unités à droite
      // du panier et le regarde », pas « la caméra se décale de deux unités ».
      // Pendant la liaison les deux plans se croisent et tout s'interpole —
      // position, cible, roulis, focale — d'un sujet à l'autre.
      var px = 0, py = 0, lx = 0, ly = 0, lz = 0
      var roll = 0, fovMul = 1, total = 0, thread = 0

      for (var i = 0; i < scenes.length; i++) {
        var scn = scenes[i]
        if (scn.holdFrom === undefined) continue
        var beat = CAMERA_BEATS[scn.def.key]
        if (!beat) continue
        var w = shotWeight(scn, progress)
        if (w <= 0) continue
        // Sur téléphone le champ est deux fois plus étroit : un déport de deux
        // unités y sort la scène du cadre au lieu de la souligner.
        // Un plan traversant ne se met pas à l'échelle du cadre : il vise une
        // ouverture réelle de quelques dizaines de centimètres. Son écart suit
        // donc l'échelle du modèle, pas l'amplitude de cadrage — sinon on rate
        // la porte de dix centimètres et on entre dans la tôle.
        var amp = beat.thread ? scn.group.scale.x : (cam.narrow ? 0.45 : 1)
        if (beat.thread) thread += w
        var sx = scn.def.ox * scn.xf
        var sy = scn.def.oy
        px += (sx + beat.x * amp) * w
        py += (sy + beat.y * amp) * w
        lx += (sx + beat.lookX * amp) * w
        ly += (sy + beat.lookY * amp) * w
        lz += scn.stationZ * w
        roll += beat.roll * w
        fovMul += (beat.fov - 1) * w
        total += w
      }

      var baseZ = flightZ(progress)

      if (total > 0.0001) {
        px /= total; py /= total; lx /= total; ly /= total; lz /= total
      } else {
        lz = baseZ - 34
      }

      // Le regard vise toujours DEVANT la station, jamais la station elle-même :
      // sinon, à l'instant où la caméra la dépasse, elle se retournerait pour
      // la regarder et l'image ferait un tête-à-queue. C'était le défaut de
      // fond de la version précédente, où `lookAt` visait le plan z = 0 : passé
      // z = 0, la caméra regardait derrière elle et plus rien ne collait.
      lz = Math.min(lz - 12, baseZ - 8)

      // Pendant la liaison, le regard quitte les stations pour la balle. C'est
      // littéralement « on suit cette balle » : elle sort d'une scène, elle
      // entre dans la suivante, et la caméra ne fait que l'accompagner. Le
      // poids en cloche fait que la bascule et le retour sont progressifs — on
      // ne coupe jamais d'un sujet à l'autre.
      if (relayHit && relay && relay.visible) {
        var rw = relayHit.w * 0.8
        lx = lerp(lx, relay.position.x, rw)
        ly = lerp(ly, relay.position.y, rw)
        lz = lerp(lz, relay.position.z, rw)
        lz = Math.min(lz, baseZ - 6)
      }

      // La respiration, la dérive et le parallaxe à la souris s'effacent quand
      // la caméra vise une ouverture : une porte fait cinquante centimètres de
      // large, un parallaxe de quatre-vingt-dix la rate à tous les coups.
      var free = 1 - clamp01(thread) * 0.92
      var breathe = reduced ? 0 : Math.sin(now * 0.00021) * 0.35 * free
      var sway = reduced ? 0 : Math.sin(now * 0.00013) * 0.5 * free

      var targetX = px + sway + (reduced ? 0 : cam.mx * 0.9 * free)
      var targetY = py + breathe + (reduced ? 0 : cam.my * 0.55 * free)

      // Lissage exponentiel. Plus ferme qu'avant (0,055) : avec des liaisons
      // deux fois et demie plus rapides que les plans, un amortissement mou
      // laissait la caméra traîner derrière le défilement et arriver en retard
      // sur son propre sujet.
      var k = reduced ? 1 : 0.12
      cam.pos.x += (targetX - cam.pos.x) * k
      cam.pos.y += (targetY - cam.pos.y) * k
      cam.pos.z += (baseZ - cam.pos.z) * (reduced ? 1 : 0.2)
      cam.look.x += (lx - cam.look.x) * k
      cam.look.y += (ly - cam.look.y) * k
      cam.look.z += (lz - cam.look.z) * k
      cam.roll += (roll - cam.roll) * k

      var targetFov = cam.baseFov * fovMul
      cam.fov += (targetFov - cam.fov) * k
      if (Math.abs(camera.fov - cam.fov) > 0.01) {
        camera.fov = cam.fov
        camera.updateProjectionMatrix()
      }

      camera.position.set(cam.pos.x, cam.pos.y, cam.pos.z)
      camera.lookAt(cam.look.x, cam.look.y, Math.min(cam.look.z, cam.pos.z - 4))
      // `lookAt` remet le roulis à zéro : on l'applique après, sinon il est
      // écrasé à chaque image.
      camera.rotation.z += cam.roll
    }

    function layout(now) {
      // Le défilement entraîne la cascade, la dérive l'anime à l'arrêt. Le
      // facteur 2,4 veut dire : la page entière fait passer un peu plus de deux
      // couloirs d'objets. En dessous, l'effet ne se remarque pas ; au-dessus,
      // ça file et ça donne le tournis.
      // Une seule lecture du défilement par image : `scrollHeight` force un
      // recalcul de mise en page, et le payer deux fois par image se sent sur
      // une page longue.
      var progress = scrollProgress()
      var travel = progress * LANE * 2.4 + (reduced ? 0 : now * 0.00035)

      for (var i = 0; i < objects.length; i++) {
        var o = objects[i]
        var y = o.baseY - travel * o.rate
        // Boucle sur le couloir : modulo ramené dans [-LANE/2, LANE/2].
        y = ((((y + LANE / 2) % LANE) + LANE) % LANE) - LANE / 2
        o.group.position.y = y
        if (!reduced) {
          o.group.rotation.x += o.spin.x * 6
          o.group.rotation.y += o.spin.y * 6
          o.group.rotation.z += o.spin.z * 6
        }
      }

      playScenes(progress)
      relayHit = placeRelay(progress)
      frameCamera(progress, now)
      // Le couloir d'ambiance suit la caméra : il est là pour donner une
      // vitesse, pas pour être un lieu.
      if (ambient) ambient.position.z = camera.position.z - 11
    }

    function frame(now) {
      if (!running) return
      // ~40 images par seconde : au-delà, on dépense de la batterie pour un
      // décor que personne ne regarde fixement.
      if (now - lastFrame > 24) {
        lastFrame = now
        layout(now)
        renderFrame(now)
      }
      requestAnimationFrame(frame)
    }

    function start() {
      if (running) return
      running = true
      lastFrame = 0
      requestAnimationFrame(frame)
    }

    function stop() {
      running = false
    }

    function onResize() {
      if (!renderer) return
      camera.aspect = window.innerWidth / window.innerHeight
      camera.updateProjectionMatrix()
      renderer.setSize(window.innerWidth, window.innerHeight)
      // Une rotation de téléphone change le champ visible sans reconstruire la
      // scène : sans cette ligne, l'amplitude des plans resterait celle du
      // format précédent et les scènes sortiraient du cadre.
      cam.narrow = window.innerWidth < 768

      if (fx) {
        var pr = renderer.getPixelRatio()
        var w = window.innerWidth * pr, h = window.innerHeight * pr
        fx.sceneRT.setSize(Math.max(2, Math.floor(w * SUPER)), Math.max(2, Math.floor(h * SUPER)))
        fx.half.w = w / 2
        fx.half.h = h / 2
        fx.rtA.setSize(Math.max(2, Math.floor(fx.half.w)), Math.max(2, Math.floor(fx.half.h)))
        fx.rtB.setSize(Math.max(2, Math.floor(fx.half.w)), Math.max(2, Math.floor(fx.half.h)))
      }
    }

    /** Le bouton clair/sombre change la palette : on reconstruit la scène. */
    function rebuild() {
      if (!renderer) return
      stop()
      scene.traverse(function (n) {
        if (n.geometry) n.geometry.dispose()
        if (n.material) {
          if (Array.isArray(n.material)) n.material.forEach(function (m) { m.dispose() })
          else n.material.dispose()
        }
      })
      if (fx) {
        fx.sceneRT.dispose()
        fx.rtA.dispose()
        fx.rtB.dispose()
        fx.geo.dispose()
        fx.bright.dispose()
        fx.blur.dispose()
        fx.compose.dispose()
        fx = null
      }
      renderer.dispose()
      host.innerHTML = ''
      objects = []
      ambient = null
      relay = null
      relayHit = null
      scenes = []
      build()
      start()
    }

    function init() {
      THREE = window.THREE
      if (!THREE) return
      build()
      layout(performance.now())
      renderFrame(performance.now())
      host.classList.add('is-ready')

      // En mouvement réduit, une seule image composée : le décor garde sa
      // richesse, sans rien qui bouge.
      if (reduced) {
        window.addEventListener(
          'scroll',
          function () {
            layout(performance.now())
            renderFrame(performance.now())
          },
          { passive: true },
        )
      } else {
        start()
      }

      window.addEventListener('resize', onResize, { passive: true })

      // Le parallaxe à la souris n'existe que sur pointeur fin : sur tactile il
      // n'y a pas de curseur, et `pointermove` s'y déclencherait au doigt, en
      // concurrence avec le défilement.
      if (!reduced && window.matchMedia && window.matchMedia('(pointer: fine)').matches) {
        onPointer = function (e) {
          cam.mx = (e.clientX / window.innerWidth) * 2 - 1
          // Inversé : la caméra suit le regard, elle ne le fuit pas.
          cam.my = 1 - (e.clientY / window.innerHeight) * 2
        }
        window.addEventListener('pointermove', onPointer, { passive: true })
      }
      // Onglet en arrière-plan : rien à dessiner.
      document.addEventListener('visibilitychange', function () {
        if (document.hidden) stop()
        else if (!reduced) start()
      })
      document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
        // Après le basculement de classe sur <html>, pas avant.
        btn.addEventListener('click', function () {
          setTimeout(rebuild, 0)
        })
      })
    }

    /**
     * Chargement des dépendances.
     *
     * three.js est indispensable : sans lui, pas de décor, et on s'arrête là
     * sans rien afficher — l'atmosphère CSS tient la page toute seule, et un
     * message d'erreur pour un élément décoratif serait pire que son absence.
     *
     * GSAP est facultatif, et c'est délibéré. Il apporte des courbes
     * d'accélération réglées et une écriture de séquences plus lisible que mes
     * fractions calculées à la main, mais le décor doit rester debout s'il
     * n'arrive pas. Chaque endroit qui l'utilise teste sa présence et retombe
     * sur l'implémentation maison. Une URL de CDN qui change de numéro de
     * version ne doit pas coûter la page d'accueil.
     */
    function loadScript(src, done) {
      var s = document.createElement('script')
      s.src = src
      s.onload = function () { done(true) }
      s.onerror = function () { done(false) }
      document.head.appendChild(s)
    }

    function load() {
      var CDN = 'https://cdnjs.cloudflare.com/ajax/libs/'
      function withThree() {
        if (window.gsap) return init()
        // Les deux scripts GSAP en chaîne : ScrollTrigger s'enregistre auprès du
        // noyau, il lui faut donc le noyau déjà là.
        loadScript(CDN + 'gsap/3.12.5/gsap.min.js', function (ok) {
          if (!ok) return init()
          loadScript(CDN + 'gsap/3.12.5/ScrollTrigger.min.js', function (ok2) {
            if (ok2 && window.gsap && window.ScrollTrigger) {
              try { window.gsap.registerPlugin(window.ScrollTrigger) } catch (e) {}
            }
            init()
          })
        })
      }
      if (window.THREE) return withThree()
      loadScript(CDN + 'three.js/r128/three.min.js', function (ok) {
        if (ok) withThree()
      })
    }

    // Le décor n'est pas prioritaire : il attend que la page ait fini de se
    // charger, pour ne pas disputer la bande passante aux polices et aux images.
    if (document.readyState === 'complete') setTimeout(load, 200)
    else window.addEventListener('load', function () { setTimeout(load, 200) })
  })()
</script>
