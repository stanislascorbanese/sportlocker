      bandeauCol.position.set(0, 0.62, 0.57)
      colonne.add(bandeauCol)

      // La plaque QR : un cadre et quatre carrés, la mire d'un code.
      var plaque = new THREE.Mesh(
        new THREE.BoxGeometry(0.34, 0.46, 0.02),
        steel(dark ? 0x0d1b2a : 0xeef3f7, 0.5, 0.1),
      )
      plaque.position.set(0, 0.3, 0.57)
      colonne.add(plaque)
      for (var qx = -1; qx <= 1; qx += 2) {
        for (var qy = -1; qy <= 1; qy += 2) {
          var mire = new THREE.Mesh(new THREE.BoxGeometry(0.085, 0.085, 0.012), vertPlein)
          mire.position.set(qx * 0.065, 0.3 + qy * 0.065, 0.585)
          colonne.add(mire)
        }
      }

      // La plaque signalétique, trois lignes muettes.
      for (var li = 0; li < 3; li++) {
        var ligne = new THREE.Mesh(
          new THREE.BoxGeometry(0.24 - li * 0.05, 0.025, 0.012),
          steel(dark ? 0x35485c : 0xa9bccd, 0.7, 0.05),
        )
        ligne.position.set(-0.03 + li * 0.02, -0.18 - li * 0.06, 0.575)
        colonne.add(ligne)
      }

      colonne.position.set(cols[2], 0.95, 0)
      g.add(colonne)

      // L'écran de la borne, au sommet : la seule surface qui émet vraiment.
      var ecran = new THREE.Mesh(
        new THREE.BoxGeometry(0.3, 0.1, 0.02),
        new THREE.MeshStandardMaterial({
          color: 0x0a1f1a, roughness: 0.15, metalness: 0.1,
          emissive: 0x2bc295, emissiveIntensity: dark ? 1.5 : 0.5,
        }),
      )
      ecran.position.set(cols[2], 1.58, 0.585)
      g.add(ecran)

      /**
       * La gerbe : tout le matériel qui jaillit de la case ouverte.
       *
       * Un seul ballon qui sortait en flottant disait « il y a un ballon
       * dedans ». Huit objets qui giclent vers l'objectif disent « il y a TOUT
       * là-dedans », ce qui est exactement le propos de la borne — et ils
       * arrivent à l'instant où la caméra franchit la porte, si bien qu'on les
       * traverse au lieu de les regarder.
       *
       * Chacun garde sa direction propre, tirée d'un cercle : sans ça les huit
       * partent en éventail régulier et ça se lit comme un motif, pas comme une
       * explosion.
       */
      /**
       * Les quatre bandes de la façade : au-dessus, au-dessous, à gauche et à
       * droite de la case ouverte. Ensemble elles refont exactement la face
       * avant du meuble, moins l'ouverture — et cette ouverture-là est un vrai
       * trou, à travers lequel on voit ce qu'il y a dans le casier.
       */
      var OUV = layout[3]
      var FW = (OUV[2] - 0.04) / 2
      var FH = (OUV[3] - 0.04) / 2
      var fx0 = cols[OUV[0]], fy0 = OUV[1]
      var bandes = [
        [1.8, 1.8 - (fy0 + FH), 0, (fy0 + FH + 1.8) / 2],
        [1.8, fy0 - FH + 1.8, 0, (fy0 - FH - 1.8) / 2],
        [fx0 - FW + 0.9, FH * 2, (fx0 - FW - 0.9) / 2, fy0],
        [0.9 - (fx0 + FW), FH * 2, (fx0 + FW + 0.9) / 2, fy0],
      ]
      for (var fb = 0; fb < bandes.length; fb++) {
        var B = bandes[fb]
        if (B[0] <= 0.002 || B[1] <= 0.002) continue
        var bande = new THREE.Mesh(new THREE.PlaneGeometry(B[0], B[1]), caisse)
        bande.position.set(B[2], B[3], 0.5)
        g.add(bande)
      }

      /**
       * LES HUIT SPORTS DE LA BORNE.
       *
       * Une seule table pour les deux bouts de la page. Ce qui jaillit de la
       * case à l'ouverture et ce qui rentre dans les casiers à la fin sont les
       * mêmes objets, au même dessin et à la même couleur : c'est ça qui boucle
       * la démonstration — on range ce qu'on a sorti, et chacun dans sa case.
       *
       * L'ordre suit `layout`, ligne pour ligne : les deux grandes portes du
       * haut prennent le matériel long, les six casiers à ballons prennent les
       * ballons. Ce n'est pas un détail d'affichage, c'est la fiche produit.
       */
      var SPORTS = [
        { motif: 'raquette', couleur: 0x2bc295 },
        { motif: 'club', couleur: 0xe8ff3a },
        { motif: 'foot', couleur: 0xf2f6f8 },
        { motif: 'basket', couleur: 0xff7a1a },
        { motif: 'volley', couleur: 0x3f9ad8 },
        { motif: 'tennis', couleur: 0xd8ff3a },
        { motif: 'petanque', couleur: 0x9fb0bf },
        { motif: 'frisbee', couleur: 0x4fd6a8 },
      ]

      /**
       * Un objet de sport dessiné au trait, avec SON motif.
       *
       * Huit icosphères en fil de fer donnaient huit boules identiques : on
       * voyait « des objets », pas « des sports ». Ici chaque ballon porte le
       * tracé qui le désigne — les trois grands cercles d'un ballon de foot,
       * les deux coutures en amande du basket, les six panneaux du volley, les
       * stries d'une boule de pétanque, la couture unique d'une balle de
       * tennis. C'est ce tracé, et non la silhouette, qui se lit à trente
       * centimètres de l'objectif quand douze objets giclent d'un coup.
       *
       * Tout tient dans une sphère de rayon 0,5 en coordonnées locales : c'est
       * ce qui permet de les tasser dans une case sans avoir à mesurer.
       */
      function objetSport(spec) {
        var o = new THREE.Group()
        // Le CORPS est plein et sombre, pas en fil de fer.
        //
        // Une sphère en fil de fer vue de près, c'est une pelote : les
        // méridiens du fond se superposent à ceux du devant et le motif
        // s'annule. Un volume plein teinté de la couleur du sport, avec le
        // tracé posé DESSUS, donne un ballon — une forme qui a un devant et un
        // derrière, et une seule couture visible à la fois.
        // La matière du corps est gardée en main : tant que les objets sont
        // enfermés dans la case, aucune lampe ne les atteint et douze ballons
        // sombres dans un puits sombre ne font rien voir du tout. On leur donne
        // donc leur propre lumière le temps de l'enfermement, et on la coupe
        // quand ils sortent au grand jour.
        var corps = new THREE.MeshStandardMaterial({
          color: new THREE.Color(spec.couleur).multiplyScalar(0.17),
          roughness: 0.55, metalness: 0.05,
          emissive: spec.couleur, emissiveIntensity: 0.1,
          transparent: true, opacity: 1,
        })
        var fil = corps
        var trait = new THREE.MeshBasicMaterial({
          color: spec.couleur, transparent: true, opacity: 0.92,
        })
        var halo = new THREE.MeshBasicMaterial({
          color: spec.couleur, transparent: true, opacity: 0.13,
          depthWrite: false, blending: THREE.AdditiveBlending,
        })

        /** Un cercle de section fine, orienté par ses trois angles. */
        function anneau(r, ep, rx, ry, rz) {
          var m = new THREE.Mesh(new THREE.TorusGeometry(r, ep, 6, 34), trait)
          m.rotation.set(rx || 0, ry || 0, rz || 0)
          o.add(m)
          return m
        }
        function sphere(r) {
          o.add(new THREE.Mesh(new THREE.SphereGeometry(r, 20, 14), corps))
          o.add(new THREE.Mesh(new THREE.SphereGeometry(r * 1.22, 12, 9), halo))
        }

        if (spec.motif === 'raquette') {
          var cad = anneau(0.32, 0.022)
          cad.scale.set(1, 1.16, 1)
          var hal = new THREE.Mesh(new THREE.TorusGeometry(0.32, 0.075, 6, 18), halo)
          hal.scale.set(1, 1.16, 1)
          o.add(hal)
          // Le cordage. Sans lui le cadre se lit comme un cerceau ; avec, c'est
          // une raquette même vue de trois quarts et à contre-jour.
          for (var rc = -1; rc <= 1; rc++) {
            var vv = new THREE.Mesh(new THREE.BoxGeometry(0.007, 0.56, 0.007), trait)
            vv.position.x = rc * 0.155
            o.add(vv)
            var hz = new THREE.Mesh(new THREE.BoxGeometry(0.54, 0.007, 0.007), trait)
            hz.position.y = rc * 0.16
            o.add(hz)
          }
          var mch2 = new THREE.Mesh(new THREE.CylinderGeometry(0.021, 0.027, 0.44, 7), trait)
          mch2.position.y = -0.60
          o.add(mch2)
        } else if (spec.motif === 'club') {
          var shf = new THREE.Mesh(new THREE.CylinderGeometry(0.011, 0.017, 0.88, 7), trait)
          shf.position.y = 0.10
          o.add(shf)
          var grp2 = new THREE.Mesh(new THREE.CylinderGeometry(0.027, 0.022, 0.22, 7), trait)
          grp2.position.y = 0.62
          o.add(grp2)
          var hd = new THREE.Mesh(new THREE.SphereGeometry(0.10, 10, 8), trait)
          hd.scale.set(1.5, 0.8, 1.05)
          hd.position.set(0.07, -0.36, 0)
          o.add(hd)
          var hdh = new THREE.Mesh(new THREE.SphereGeometry(0.17, 8, 6), halo)
          hdh.position.copy(hd.position)
          o.add(hdh)
        } else if (spec.motif === 'frisbee') {
          var jupe = new THREE.Mesh(
            new THREE.CylinderGeometry(0.46, 0.36, 0.09, 22, 1, true), fil,
          )
          o.add(jupe)
          anneau(0.46, 0.016, Math.PI / 2)
          anneau(0.30, 0.011, Math.PI / 2).position.y = 0.042
          var fh = new THREE.Mesh(new THREE.CylinderGeometry(0.5, 0.42, 0.02, 16), halo)
          o.add(fh)
        } else {
          var r0 = spec.motif === 'tennis' ? 0.36 : 0.46
          sphere(r0)
          var rc0 = r0 * 1.004
          if (spec.motif === 'foot') {
            anneau(rc0, 0.015, Math.PI / 2)
            anneau(rc0, 0.015)
            anneau(rc0, 0.015, 0, Math.PI / 2)
          } else if (spec.motif === 'basket') {
            anneau(rc0, 0.017, Math.PI / 2)
            anneau(rc0, 0.017)
            // Les deux coutures latérales : des cercles plus petits, penchés,
            // décalés vers les flancs. C'est le motif d'un ballon de basket.
            var cb1 = anneau(r0 * 0.74, 0.015, 0, 0, 0)
            cb1.position.x = r0 * 0.36
            cb1.rotation.y = 1.05
            var cb2 = anneau(r0 * 0.74, 0.015, 0, 0, 0)
            cb2.position.x = -r0 * 0.36
            cb2.rotation.y = -1.05
          } else if (spec.motif === 'volley') {
            for (var vb = 0; vb < 3; vb++) {
              anneau(rc0, 0.014, 0, (vb * Math.PI) / 3)
            }
          } else if (spec.motif === 'tennis') {
            var tc1 = anneau(rc0, 0.014)
            tc1.scale.set(1, 0.58, 1)
            var tc2 = anneau(rc0, 0.014, 0, Math.PI / 2)
            tc2.scale.set(1, 0.58, 1)
          } else {
            // Pétanque : des méridiens serrés, comme les stries d'une boule.
            // Leur rayon suit la sphère — un anneau de rayon constant posé en
            // hauteur dépasserait du ballon, et un trait qui flotte à côté de
            // son objet est pire que pas de trait du tout.
            for (var pb = -2; pb <= 2; pb++) {
              var yy = pb * 0.15
              var rr = Math.sqrt(Math.max(r0 * r0 - yy * yy, 0.0004))
              anneau(rr, 0.011, Math.PI / 2).position.y = yy
            }
          }
        }
        o.userData.corps = corps
        return o
      }

      var OUVERT = layout[3]
      var gerbe = new THREE.Group()
      // Le centre du PUITS, pas la façade : le puits va de z = 0,13 à z = 0,51,
      // donc son milieu est à 0,32. Posés à 0,42 les objets étaient déjà aux
      // trois quarts dehors avant d'avoir bougé, et c'est ce qui les faisait
      // déborder du cadre de la case.
      gerbe.position.set(cols[OUVERT[0]], OUVERT[1], 0.32)
      g.add(gerbe)
      var gerbeItems = []
      // Douze objets pour huit sports : les quatre premiers reviennent une
      // seconde fois. En dessous la case a l'air à moitié vide ; au-dessus on
      // ne distingue plus rien au moment où ça part.
      var GERBE_N = 12
      /**
       * LA CASE EST UNE BOÎTE, et rien n'en dépasse avant l'ouverture.
       *
       * Douze objets posés au même point et à leur taille pleine, ça ne fait
       * pas un casier plein : ça fait un tas qui traverse la tôle, et c'est
       * exactement ce qu'on voyait — des ballons à cheval sur les bordures,
       * entrechoqués, plus grands que le compartiment qui est censé les
       * contenir.
       *
       * On les range donc VRAIMENT : trois colonnes, quatre rangées, à
       * l'intérieur des bords, et à une échelle choisie pour que rien ne touche
       * la paroi. La porte s'ouvre sur une case pleine et serrée ; ils
       * reprennent leur taille sur place — c'est la détente — puis partent.
       * L'explosion vient de là, du contraste entre le tassement et le départ,
       * pas de la vitesse.
       */
      var CASE_W = OUVERT[2] / 2 - 0.06
      var CASE_H = OUVERT[3] / 2 - 0.06
      for (var gi = 0; gi < GERBE_N; gi++) {
        var spec5 = SPORTS[gi % SPORTS.length]
        var long5 = spec5.motif === 'raquette' || spec5.motif === 'club'
        var obj = objetSport(spec5)
        var cx5 = ((gi % 3) - 1) * (CASE_W * 0.62)
        var cy5 = (Math.floor(gi / 3) - 1.5) * (CASE_H * 0.44)
        // La direction de fuite est RADIALE depuis le centre de la case : celui
        // qui est rangé en haut à gauche part en haut à gauche. Douze
        // directions réparties à pas égal donnaient une roue ; celles-ci
        // donnent une gerbe, et chacune est déjà justifiée par le rangement.
        var a5 = Math.atan2(cy5, cx5 === 0 ? 0.0001 : cx5) + Math.sin(gi * 2.4) * 0.30
        var r5 = 1.15 + ((gi * 7) % 5) * 0.42
        // Le matériel long est RANGÉ À PLAT, en travers de la case, et à une
        // échelle plus petite. Debout et à la taille des ballons, une raquette
        // de soixante-dix centimètres sortait par le bas d'un casier qui n'en
        // fait que soixante-deux : très exactement le débordement qu'on
        // voulait supprimer. Un casier bien rangé, c'est aussi ça — chaque
        // chose dans le sens où elle tient.
        if (long5) obj.rotation.z = Math.PI / 2
        var tasse5 = long5 ? 0.1 : 0.15
        obj.scale.setScalar(tasse5)
        gerbeItems.push({
          mesh: obj,
          rang: [cx5, cy5, ((gi % 2) - 0.5) * 0.13],
          dir: [Math.cos(a5) * r5, Math.sin(a5) * r5 * 0.8, 1.3 + ((gi * 5) % 6) * 0.5],
          spin: [0.03 + gi * 0.004, 0.05 - gi * 0.003],
          tasse: tasse5,
          plein: long5 ? 0.17 : 0.22,
          // Un retard très court : ils partent quasiment ensemble. Étalés, on
          // lit une file ; groupés, une explosion.
          retard: (gi % 4) * 0.018,
        })
        gerbe.add(obj)
      }

      /**
       * LE RETOUR : un objet par casier, et chacun le sien.
       *
       * Ce n'est plus une seule case qui aspire tout, ce sont les huit — et
       * chacune reçoit ce qui lui va : les deux grandes portes du haut prennent
       * le matériel long, les six casiers à ballons prennent les ballons.
       * C'est littéralement ce que dit la fiche produit, joué à l'image.
       *
       * Et ce sont les MÊMES objets qu'à l'ouverture, tirés de la même table :
       * la raquette qui est sortie de la borne au premier écran est celle qui y
       * rentre au dernier. Une autre série d'objets, même jolie, aurait raconté
       * deux bornes au lieu d'une.
       */
      var retourItems = []
      for (var ri = 0; ri < layout.length; ri++) {
        var LR = layout[ri]
        // LE MÊME SPORT QU'AU DÉBUT, ET DANS LA MÊME CASE. `SPORTS[ri]` est
        // aussi ce qui sort du casier à l'ouverture : la page se referme
        // littéralement sur ce qu'elle a ouvert.
        var obj2 = objetSport(SPORTS[ri])
        obj2.visible = false
        g.add(obj2)
        // Ils arrivent de TOUT LE POURTOUR : l'angle suit la position du casier
        // dans la façade, si bien que celui d'en haut à gauche vient d'en haut
        // à gauche. Rien ne se croise, et l'aspiration se lit d'un coup d'œil.
        var ang = Math.atan2(LR[1] + 0.55, cols[LR[0]] === 0 ? 0.0001 : cols[LR[0]]) +
          (ri % 2 ? 0.25 : -0.25)
        // Deux échelles, comme à l'aller : la taille de vol et la taille
        // TASSÉE, celle qui tient dans la case. Un objet qui arrive à sa taille
        // de vol et s'arrête dans un casier de cinquante-deux centimètres en
        // ressort par les quatre côtés.
        var petit = LR[3] < 1
        retourItems.push({
          mesh: obj2,
          porte: ri,
          cible: [cols[LR[0]], LR[1], 0.30],
          vol: petit ? 0.21 : 0.34,
          tasse: petit ? 0.125 : 0.30,
          dir: [Math.cos(ang) * 4.2, Math.sin(ang) * 3.4, 2.6 + (ri % 3) * 1.4],
          spin: [0.05 + ri * 0.006, 0.04 - ri * 0.004],
          retard: (ri % 4) * 0.05,
        })
      }

      // Le casier 04 : celui du milieu de la première rangée de ballons,
      // exactement celui que la maquette met en avant avec sa coche verte.
      // `ouvertY` est sa COTE, et c'est elle que vise le plan traversant : la
      // caméra visait 0,18 alors que la case est à −0,45, soit soixante-trois
      // centimètres plus haut — elle passait au-dessus au lieu d'entrer.
      return {
        group: g, doors: doors, out: null, openIndex: 3,
        gerbe: gerbe, gerbeItems: gerbeItems, retourItems: retourItems,
        ouvertX: cols[OUVERT[0]], ouvertY: OUVERT[1],
      }
    }

    /**
     * La sortie : la porte est déjà ouverte, l'article est dehors, et le meuble
     * s'éloigne. Rien ne s'anime sinon la rotation — tout le mouvement est dans
     * l'appareil, qui recule.
     */
    /**
     * Le plan de sortie, en trois temps nets.
     *
     *   0 → 0,30  l'approche. On arrive à deux mètres de la porte ouverte.
     *   0,30 → 0,62  la vue est fixe. L'article rentre, la porte se referme,
     *                et c'est le défilement seul qui déroule le geste.
     *   0,62 → 1  le dézoom, jusqu'à se confondre avec la borne de la section.
     *
     * Les trois temps sont écrits ici et dans le plan de caméra avec les mêmes
     * bornes : c'est ce qui garantit que la porte finit de se fermer AVANT que
     * la caméra recule. Dans l'autre ordre, on s'éloigne d'une porte encore
     * ouverte et le geste passe inaperçu.
     */
    // Le recul ne part qu'aux sept dixièmes du plan. Avec une approche longue,
    // la caméra n'a fini de se rapprocher qu'à ce moment-là ; un dézoom qui
    // commence avant l'arrivée annule l'arrivée — on recule d'un mètre pour
    // chaque mètre gagné, et la borne cesse de grossir sans que rien ne bouge
    // à l'image.
    var SORTIE_ARRET = 0.34
    var SORTIE_RECUL = 0.70

    function updateSortie(scn, q) {
      scn.group.rotation.y = lerp(-0.3, -0.34, ease(clamp01(q / 0.5)))
      // La gerbe d'ouverture appartient à l'autre borne : elle n'a rien à faire
      // sur celle-ci, qui joue le retour.
      if (scn.gerbe) scn.gerbe.visible = false

      var arret = clamp01((q - SORTIE_ARRET) / (SORTIE_RECUL - SORTIE_ARRET))

      /**
       * Les HUIT cases aspirent, chacune la sienne.
       *
       * Une seule case qui avalait tout racontait un casier ; huit portes qui
       * se referment chacune sur son objet racontent une borne. Les deux
       * grandes prennent le matériel long, les six petites les ballons — c'est
       * la fiche produit, jouée.
       *
       * Ils arrivent de tout le pourtour du cadre, chacun depuis la direction
       * de son casier dans la façade, et accélèrent en approchant : la
       * trajectoire est en (1-t)^1,7, donc lente au loin et happée à la fin.
       */
      var retour = scn.retourItems
      for (var gj = 0; gj < retour.length; gj++) {
        var it = retour[gj]
        var e = clamp01((arret - it.retard) / 0.5)
        var loin = Math.pow(1 - e, 1.7)
        // Ils restent visibles jusqu'à ce que la porte les recouvre : les
        // effacer à 0,995 revenait à faire disparaître l'objet juste avant que
        // la case ne se referme sur lui, c'est-à-dire à annuler le geste.
        it.mesh.visible = e > 0.004
        it.mesh.position.set(
          it.cible[0] + it.dir[0] * loin,
          it.cible[1] + it.dir[1] * loin + loin * 0.6,
          it.cible[2] + it.dir[2] * loin,
        )
        // Et ils se TASSENT en entrant, comme ils étaient tassés au départ. Un
        // objet qui garde sa taille de vol dépasse des quatre côtés d'un casier
        // de cinquante-deux centimètres : la borne avait l'air de fermer sa
        // porte sur un ballon trop gros pour elle.
        it.mesh.scale.setScalar(lerp(it.vol, it.tasse, ease(clamp01((e - 0.55) / 0.4))))
        it.mesh.rotation.x += it.spin[0] * (1 - e)
        it.mesh.rotation.y += it.spin[1] * (1 - e)
        // Chaque porte se referme sur SON objet, et pas avant qu'il soit entré.
        var d8 = scn.doors[it.porte]
        if (d8) d8.rotation.y = -1.9 * (1 - ease(clamp01((e - 0.82) / 0.18)))
      }
      // Les portes sont pilotées une par une ci-dessus : chacune se referme sur
      // son objet, jamais avant. Une porte qui se ferme sur un ballon encore
      // dehors, c'est le genre de détail qui se remarque sans qu'on sache dire
      // pourquoi l'image est fausse.
    }

    function updateKiosk(scn, q) {
      var t = ease(q)
      // La borne est plein axe : la caméra entre par la porte ouverte. Elle est
      // de face aux six dixièmes du plan, pas à la fin — la caméra arrive à la
      // fin, et un meuble encore de trois quarts à cet instant se traverserait
      // par la tôle.
      // Tout est calé sur l'instant de la traversée, pas sur des fractions de
      // plan écrites à la main : de face aux deux tiers du chemin, porte grande
      // ouverte au même moment, raquette dehors juste après. Si le découpage de
      // la page bouge, ces trois gestes restent à leur place l'un par rapport à
      // l'autre et par rapport au passage.
      var T = qTraversee(scn)
      scn.group.rotation.y = lerp(-0.55, 0, ease(clamp01(q / (T * 0.68))))

      // La porte s'ouvre au tiers de la fenêtre et reste ouverte : la refermer
      // pendant que l'article est dehors serait un contresens sur le produit.
      var open = clamp01((q - T * 0.20) / Math.max(T * 0.30, 0.0001))
      scn.doors[scn.openIndex].rotation.y = -ease(open) * 1.9

      // La gerbe. Elle part aux trois quarts du chemin vers la porte et
      // continue de s'ouvrir pendant qu'on la traverse : à l'instant de la
      // coupe les objets sont déjà de part et d'autre de l'objectif, et c'est
      // ce qui donne la sensation d'être passé au travers.
      var items = scn.gerbeItems
      for (var gj = 0; gj < items.length; gj++) {
        var it = items[gj]
        // Ils partent À L'INSTANT OÙ LA PORTE S'OUVRE, pas juste avant qu'on
        // entre. La borne est alors encore entière dans le cadre, à six ou sept
        // mètres : douze objets qui jaillissent d'un coup s'y lisent comme une
        // explosion. Partis plus tard, ils étaient déjà énormes et on n'en
        // voyait que trois.
        // Le départ est calé sur la PORTE, pas sur la traversée : elle s'ouvre
        // entre T·0,20 et T·0,50, et rien ne peut sortir d'une porte fermée.
        // À T·0,24 les douze objets giclaient d'une case entrebâillée à sept
        // mètres — on ne voyait ni la case pleine ni la porte s'ouvrir, juste
        // des objets qui apparaissaient. À T·0,40, la porte est aux trois
        // quarts ouverte, la caméra est assez près pour qu'on distingue ce
        // qu'il y a dedans, et on a eu le temps de voir le casier PLEIN.
        var e = clamp01((q - T * 0.40 - it.retard) / Math.max(T * 0.52, 0.0001))
        // DEUX temps, et c'est tout le sujet. D'abord la DÉTENTE : les objets
        // reprennent leur taille sans bouger d'un millimètre, encore rangés
        // dans leur case. Ensuite la SORTIE. Le décalage d'un dixième entre les
        // deux est ce qui donne la libération — on voit la case se gonfler
        // avant de se vider. Départ et grossissement simultanés donnaient une
        // simple projection d'objets, ce qui n'est pas la même chose.
        var det = ease(clamp01(e / 0.30))
        var d5 = clamp01((e - 0.10) / 0.90)
        var s5 = d5 * (2 - d5)        // sortie franche, puis elle s'étale
        // Visibles dès que la porte s'entrouvre : il faut avoir vu la case
        // PLEINE pour comprendre ce qui se vide.
        it.mesh.visible = q > T * 0.14
        // Éclairés de l'intérieur tant qu'ils sont dans la case, rendus à la
        // lumière du décor une fois dehors.
        if (it.mesh.userData.corps) {
          it.mesh.userData.corps.emissiveIntensity = lerp(0.34, 0.1, det)
        }
        it.mesh.position.set(
          it.rang[0] + it.dir[0] * s5,
          it.rang[1] + it.dir[1] * s5,
          it.rang[2] + it.dir[2] * s5,
        )
        it.mesh.scale.setScalar(lerp(it.tasse, it.plein, det))
        // Ils ne tournent qu'une fois dehors. Une pile d'objets qui pivotent
        // dans une case fermée, ce n'est pas de la compression, c'est du
        // désordre — et ça se voit d'autant plus qu'ils se traversent.
        if (s5 > 0.002) {
          it.mesh.rotation.x += it.spin[0]
          it.mesh.rotation.y += it.spin[1]
        }
      }
    }

    // ─── La pétanque ──────────────────────────────────────────────────────────
    //
    // Le terrain de camping, dessiné au trait comme le reste : une bande de
    // gravier sombre cernée de rondins lumineux, un cercle au sol autour du
    // cochonnet, trois boules qui viennent s'y ranger. Sa longueur suit l'axe
    // du couloir — posé en travers, la caméra le traversait par le petit côté
    // et n'en voyait qu'une tranche.
    //
    // C'est le seul plan du site pris à quarante centimètres du sol. Une vue
    // plongeante sur des boules donne trois points gris sur du gris ; à hauteur
    // de gravier, une boule de sept centimètres devient un objet.

    var PET_L = 7.5    // demi-longueur, le long de Z
    var PET_W = 2.1    // demi-largeur, le long de X
    var PET_JACK = [0.3, -4.6]   // cochonnet : x, z

    function makePetanque(p) {
      var g = new THREE.Group()

      // LE SOL AUTOUR DE LA PISTE.
      //
      // Le terrain de pétanque n'était qu'une bande de gravier de quatre mètres
      // sur quinze, posée sur rien. Tant qu'on ne le découvrait qu'au dernier
      // mètre, le brouillard s'en chargeait ; vu de cinquante mètres, une bande
      // isolée au milieu du noir n'est pas un terrain, c'est un objet flottant.
      // Cette dalle-ci recouvre l'intervalle qui le sépare de celle du basket —
      // elles se chevauchent d'une dizaine de mètres, à un centimètre l'une
      // au-dessous de l'autre pour qu'aucun pixel ne soit disputé.
      var abords = tapis(30, 46, 6, 14)
      abords.position.set(0, -0.02, -2)
      g.add(abords)

      g.add(tapis(PET_W * 2, PET_L * 2, 3, 8))

      // Les rondins. Lumineux et à peine enfoncés — un rondin qui affleure
      // parfaitement se lit comme une barre.
      var boisMat = neon(NEON_SOURD, 0.45)
      function rondin(len, x, z, ry) {
        var r = new THREE.Mesh(new THREE.CylinderGeometry(0.13, 0.13, len, 14), boisMat)
        r.rotation.z = Math.PI / 2
        r.rotation.y = ry
        r.position.set(x, 0.085, z)
        g.add(r)
      }
      rondin(PET_L * 2, -PET_W, 0, Math.PI / 2)
      rondin(PET_L * 2, PET_W, 0, Math.PI / 2)
      rondin(PET_W * 2, 0, -PET_L, 0)
      rondin(PET_W * 2, 0, PET_L, 0)

      // Le cercle au sol autour du cochonnet : c'est lui qui dit où se joue le
      // point. Sans repère, trois boules sur du gravier sont trois boules
      // posées au hasard.
      var cercle = new THREE.Mesh(
        new THREE.RingGeometry(0.92, 0.99, 48),
        new THREE.MeshBasicMaterial({ color: NEON, transparent: true, opacity: 0.55, side: THREE.DoubleSide }),
      )
      cercle.rotation.x = -Math.PI / 2
      cercle.position.set(PET_JACK[0], 0.015, PET_JACK[1])
      g.add(cercle)

      var jack = new THREE.Mesh(
        new THREE.SphereGeometry(0.055, 14, 12),
        new THREE.MeshStandardMaterial({
          color: 0xe8d86a, emissive: 0xbda93c, emissiveIntensity: 0.7, roughness: 0.55,
        }),
      )
      jack.position.set(PET_JACK[0], 0.055, PET_JACK[1])
      g.add(jack)

      // L'ombre de contact. Il n'y a pas d'ombres portées ici — elles
      // coûteraient une passe de rendu entière — mais sans elles les boules
      // flottent au-dessus du gravier.
      var ombreMat = new THREE.MeshBasicMaterial({
        color: 0x000000, transparent: true, opacity: 0.42, depthWrite: false,
      })
      var bouleMat = new THREE.MeshStandardMaterial({
        color: 0x223442, roughness: 0.3, metalness: 0.65,
      })
      var balls = []
      var ombres = []
      for (var i = 0; i < 3; i++) {
        var o = new THREE.Mesh(new THREE.CircleGeometry(0.13, 20), ombreMat)
        o.rotation.x = -Math.PI / 2
        o.position.y = 0.012
        g.add(o)
        ombres.push(o)

        var b = new THREE.Group()
        b.add(new THREE.Mesh(new THREE.SphereGeometry(0.115, 20, 16), bouleMat))
        // Trois stries, le seul détail qui dise « boule de pétanque » et pas
        // « bille ».
        for (var k = -1; k <= 1; k++) {
          var st = new THREE.Mesh(
            new THREE.TorusGeometry(0.1155, 0.004, 4, 30),
            new THREE.MeshBasicMaterial({ color: NEON, transparent: true, opacity: 0.35 }),
          )
          st.rotation.x = Math.PI / 2
          st.position.y = k * 0.035
          st.scale.setScalar(Math.cos((k * 0.035 * Math.PI) / 0.32))
          b.add(st)
        }
        g.add(b)
        balls.push(b)
      }
      /**
       * Le club de golf, et le flash.
       *
       * Le dernier geste de la page : un club au néon entre dans le champ par
       * la droite, arme, et frappe le cochonnet. Au flash, ce qui repart n'est
       * plus un cochonnet mais une balle de golf — et c'est elle qui traverse
       * les soixante mètres qui restent pour rentrer dans le casier.
       *
       * UN VRAI DRIVER, ET UN VRAI SWING.
       *
       * Deux choses le distinguent d'un bâton qui bascule.
       *
       * La première est la TÊTE. Un driver n'est pas une boîte : c'est un
       * volume en poire, large, bas, arrondi derrière, avec une face plate
       * inclinée, une semelle et un col qui rejoint le manche de biais. Ces
       * quatre pièces-là sont ce qui fait dire « driver » plutôt que « club » ;
       * un parallélépipède de vingt centimètres disait « maillet ».
       *
       * La seconde, et la vraie, est le CENTRE DE ROTATION. Le club tournait
       * autour de son propre pied, c'est-à-dire autour de la balle : la tête
       * restait sur place et le manche balayait le ciel comme une aiguille de
       * métronome. Un golfeur ne fait pas ça. Il tient le club à bout de bras,
       * et c'est autour de SES MAINS que tout tourne — un mètre trente au-dessus
       * de la balle et légèrement en retrait. La tête décrit alors le grand arc
       * qu'on connaît : elle monte derrière l'épaule, redescend en accélérant,
       * rase le sol à l'instant du contact et remonte de l'autre côté.
       *
       * Le plan de ce cercle est incliné — de vingt degrés vers l'arrière et de
       * quarante autour de la verticale. C'est l'inclinaison d'un swing réel, et
       * c'est elle qui empêche le geste de se lire comme un moulin à eau.
       */
      var clubPivot = new THREE.Group()
      clubPivot.rotation.set(0.22, -0.70, 0)
      g.add(clubPivot)
      // LES MAINS. Tout le club pend de ce point et tourne autour de lui.
      var mains = new THREE.Group()
      mains.position.y = 1.30
      clubPivot.add(mains)
      var club = new THREE.Group()
      mains.add(club)
      var clubMat = neon(NEON, 0.85)
      clubMat.transparent = true
      var clubSourd = neon(NEON_SOURD, 0.5)
      clubSourd.transparent = true

      // Le manche pend vers le bas, effilé vers la tête comme un vrai shaft.
      // La TÊTE a sa propre matière : sombre, métallique, à peine émissive.
      // En plein néon elle ressortait comme une tache blanche — le halo du
      // post-traitement avale les petits volumes très lumineux, et on ne voyait
      // plus qu'une boule de lumière au bout d'un bâton. Sombre avec une arête
      // qui brille, elle garde sa forme de poire.
      var clubTete = new THREE.MeshStandardMaterial({
        color: 0x0e2026, roughness: 0.3, metalness: 0.65,
        emissive: NEON, emissiveIntensity: 0.22, transparent: true,
      })
      var manche = new THREE.Mesh(new THREE.CylinderGeometry(0.013, 0.019, 1.02, 10), clubMat)
      manche.position.y = -0.63
      club.add(manche)
      var grip = new THREE.Mesh(new THREE.CylinderGeometry(0.025, 0.021, 0.26, 10), clubSourd)
      grip.position.y = -0.02
      club.add(grip)
      // Le col : il rejoint la tête de biais, ce qui est la seule façon de
      // faire comprendre que la face n'est pas dans l'axe du manche.
      var col = new THREE.Mesh(new THREE.CylinderGeometry(0.016, 0.022, 0.13, 8), clubMat)
      col.position.set(0.018, -1.175, 0)
      col.rotation.z = -0.22
      club.add(col)

      // LA TÊTE, en poire : une sphère aplatie et étirée vers l'arrière.
      var tete = new THREE.Mesh(new THREE.SphereGeometry(0.085, 16, 12), clubTete)
      tete.scale.set(1.5, 0.92, 1.25)
      tete.position.set(0.075, -1.245, -0.012)
      club.add(tete)
      // La face : un disque plat, légèrement ouvert vers le haut (le loft).
      var face = new THREE.Mesh(new THREE.CylinderGeometry(0.062, 0.062, 0.012, 16), clubTete)
      face.rotation.set(Math.PI / 2, 0, 0.18)
      face.position.set(0.075, -1.245, 0.104)
      club.add(face)
      // Le cerclage de la face : c'est LUI qui dessine le driver. Une arête
      // lumineuse sur un volume sombre se lit à n'importe quelle distance,
      // là où un volume lumineux entier ne fait qu'une tache.
      var cercle = new THREE.Mesh(new THREE.TorusGeometry(0.063, 0.009, 6, 26), clubMat)
      cercle.rotation.set(0, 0, 0.18)
      cercle.position.set(0.075, -1.245, 0.106)
      club.add(cercle)
      // La semelle, qui pose la tête sur le sol et lui donne son assise.
      var semelle = new THREE.Mesh(new THREE.CylinderGeometry(0.1, 0.075, 0.014, 16), clubSourd)
      semelle.scale.set(1.25, 1, 1)
      semelle.position.set(0.075, -1.322, -0.012)
      club.add(semelle)
      club.visible = false

      /**
       * On POSE le club sur le cochonnet au lieu de recopier des cotes.
       *
       * Une fois le pivot orienté, on demande à three.js où tombe réellement la
       * tête à l'adresse, et on décale le pivot de l'écart constaté. Le jour où
       * l'inclinaison du plan de swing ou la longueur du manche changent, la
       * tête reste sur la balle sans qu'on ait à retoucher trois nombres.
       */
      clubPivot.position.set(0, 0, 0)
      clubPivot.updateMatrixWorld(true)
      var posTete = tete.getWorldPosition(new THREE.Vector3())
      clubPivot.position.set(
        PET_JACK[0] - posTete.x,
        0.062 - posTete.y,
        PET_JACK[1] - posTete.z,
      )

      // L'éclair d'impact : une sphère additive qui gonfle et s'éteint en trois
      // images. Elle n'éclaire rien — elle CACHE, le temps que le cochonnet
      // devienne balle de golf.
      var flash = new THREE.Mesh(
        new THREE.SphereGeometry(1, 16, 12),
        new THREE.MeshBasicMaterial({
          color: 0xffffff, transparent: true, opacity: 0,
          depthWrite: false, blending: THREE.AdditiveBlending,
        }),
      )
      flash.position.set(PET_JACK[0], 0.06, PET_JACK[1])
      flash.visible = false
      g.add(flash)

      return {
        group: g, balls: balls, jack: jack, ombres: ombres,
        club: club, clubPivot: clubPivot, clubMat: clubMat, clubSourd: clubSourd,
        clubTete: clubTete,
        flash: flash,
      }
    }

    // La mène, comme fonction pure de q — au même titre que `balleAt`.
    //
    // Trois boules lancées l'une après l'autre, chacune décélérant vers le
    // cochonnet. La décélération est en 1-(1-t)³ : une boule qui s'arrête net
    // n'a pas de poids, et c'est le poids qui fait la pétanque. La DERNIÈRE
    // tire : elle arrive vite, frappe la première et prend sa place. C'est le
    // geste de la pétanque — celui qu'on commente au bar le soir — et il ne
    // coûte qu'une cible qui bouge après l'impact.
    //
    // Elle est sortie de l'animation pour une raison précise : c'est la boule
    // que la CAMÉRA doit suivre. Tant que sa trajectoire vivait à l'intérieur
    // de `updatePetanque`, le plan ne pouvait que viser une cible fixe et
    // espérer que la boule y arrive.
    var PET_CARREAU = 0.62   // quand la dernière touche la première
    var PET_TIR = 2          // celle qui prend le point, et qu'on suit
    var PET_Z0 = PET_L - 0.8 // la ligne de lancer

    function petanqueT(q, i) {
      // La dernière part plus tard et va plus vite : c'est ce qui fait qu'on
      // lit un tir et non un troisième placement.
      return i === PET_TIR
        ? clamp01((q - 0.42) / 0.24)
        : clamp01((q - i * 0.17) / 0.56)
    }

    function bouleAt(q, i, out) {
      // Le carreau : la chassée part VITE et LOIN, et elle décélère.
      // À -1,9 étalé sur trois dixièmes, la boule touchée glissait doucement de
      // côté ; on voyait un déplacement, pas un choc. Trois mètres deux en
      // dix-huit centièmes, avec une décélération en 1-(1-t)², c'est une boule
      // qui part — et c'est le geste qu'on regarde la pétanque pour voir.
      var tc = clamp01((q - PET_CARREAU) / 0.18)
      var chassee = 1 - (1 - tc) * (1 - tc)
      var cible = i === 0
        ? [PET_JACK[0] - 0.5 - chassee * 3.2, PET_JACK[1] + 0.55 + chassee * 1.1]
        : i === 1
          ? [PET_JACK[0] + 0.48, PET_JACK[1] + 0.3]
          : [PET_JACK[0] - 0.12, PET_JACK[1] - 0.4]
      var t = petanqueT(q, i)
      var e = i === PET_TIR ? t * (2 - t) : 1 - Math.pow(1 - t, 3)
      var saut = Math.max(0, Math.sin(Math.PI * clamp01((t - 0.06) * 2.4))) * 0.1 * (1 - e)
      // La boule chassée décolle au moment du choc : un objet qui part sur le
      // côté sans jamais quitter le sol se lit comme un glissement.
      if (i === 0) saut += Math.sin(Math.PI * clamp01(tc * 3)) * 0.16
      return out.set(
        lerp((i - 1) * 0.55, cible[0], e),
        0.115 + saut,
        lerp(PET_Z0, cible[1], e),
      )
    }

    function updatePetanque(scn, q) {
      if (!TMP3) TMP3 = new THREE.Vector3()

      /**
       * Le golf : le dernier geste.
       *
       * Tout est calé sur `qSortiePlan` — l'instant où la scène rend la main et
       * où la balle de liaison part. La frappe DOIT tomber là : une image plus
       * tôt et la balle serait déjà partie sans avoir été frappée, une image
       * plus tard et elle serait partie avant le club.
       */
      var qF = qSortiePlan(scn)
      // Il SE DESSINE sur place : le manche pousse depuis le sol et le trait
      // s'allume, au lieu d'entrer par un bord du cadre. C'est le même geste
      // que le tracé du court qui s'allume à l'arrivée — un objet du décor qui
      // apparaît, pas un accessoire qu'on apporte.
      // Le swing occupe désormais près de SOIXANTE centièmes du plan au lieu de
      // trente-huit. Un geste de golf tient en une seconde et demie dans la
      // vie ; tassé sur deux centièmes de page, il passait entre deux images de
      // défilement et on n'en voyait qu'un bâton flou. Étalé, on a le temps de
      // lire les trois temps : le club entre, il arme, il tombe.
      var trace = ease(clamp01((q - qF * 0.42) / Math.max(qF * 0.14, 0.0001)))
      var arme = ease(clamp01((q - qF * 0.56) / Math.max(qF * 0.26, 0.0001)))
      var abat = clamp01((q - qF * 0.86) / Math.max(qF * 0.14, 0.0001))
      var suit = ease(clamp01((q - qF) / 0.14))
      scn.club.visible = trace > 0.01 && q < qF + 0.22
      if (scn.club.visible) {
        // Le club se DESSINE depuis les mains vers le bas : l'échelle en Y part
        // de zéro au point de rotation, si bien qu'il apparaît comme un trait
        // qui descend jusqu'au sol plutôt que comme un objet posé là.
        scn.club.scale.set(1, trace, 1)
        scn.clubMat.opacity = trace
        scn.clubSourd.opacity = trace * 0.8
        scn.clubTete.opacity = trace
        /**
         * Le geste, en trois temps.
         *
         *   l'adresse   la tête est sur la balle, très légèrement ouverte ;
         *   l'armé      elle monte derrière l'épaule, jusqu'à 145° ;
         *   la descente en t³ — c'est là que tout se joue. Une descente
         *               linéaire donne un club qui se pose sur la balle ; en
         *               cube, il reste haut, puis tombe. C'est ce retard-là
         *               qu'on lit comme de la vitesse.
         */
        scn.club.rotation.z = q < qF
          ? lerp(lerp(-0.06, -2.55, arme), 0, abat * abat * abat)
          : lerp(0, 2.05, suit)
      }
      // Le cochonnet existe jusqu'à la frappe. Après, c'est une balle de golf,
      // et elle appartient à la liaison.
      scn.jack.visible = q < qF
      var ecl = clamp01((q - qF + 0.02) / 0.07)
      scn.flash.visible = ecl > 0.001 && ecl < 1
      if (scn.flash.visible) {
        scn.flash.scale.setScalar(0.04 + ecl * 0.85)
        scn.flash.material.opacity = 0.95 * (1 - ecl) * (1 - ecl)
      }
      for (var i = 0; i < scn.balls.length; i++) {
        var t = petanqueT(q, i)
        var b = scn.balls[i]
        b.visible = t > 0
        bouleAt(q, i, TMP3)
        b.position.copy(TMP3)
        b.rotation.x = (PET_Z0 - TMP3.z) / 0.115
        var saut = TMP3.y - 0.115

        var om = scn.ombres[i]
        om.visible = b.visible
        om.position.set(TMP3.x, 0.012, TMP3.z)
        om.scale.setScalar(1 - Math.min(saut * 3, 0.55))
        om.material.opacity = 0.42 * (1 - Math.min(saut * 2.6, 0.7))
      }
    }

    /**
     * `exitAt` / `entryAt` : où la balle quitte une scène, où elle entre dans
     * la suivante — en coordonnées LOCALES de la scène, converties en monde au
     * moment voulu.
     *
     * Elles ne sont pas recopiées à la main depuis les animations : ce sont
     * littéralement les mêmes triplets que dans les `update`, et le passage en
     * coordonnées monde traverse la matrice réelle du groupe, rotations
     * comprises. Un point recopié à la main serait juste au premier essai puis
     * faux dès qu'une rotation change — et une balle qui se téléporte de sept
     * unités entre deux scènes est exactement ce qui casse l'illusion qu'il
     * n'y en a qu'une.
     *
     * `relayColor` est la couleur de la balle qui part : celle du sport qu'on
     * vient de voir, puisque c'est lui qu'on suit vers le suivant.
     */
    var SCENE_DEFS = [
      // Un plan long : la borne passe de petite à pleine écran sur près d'un
      // cinquième de la page. Avant, tout se jouait en 12 % et l'œil n'avait
      // pas le temps de suivre — ça se lisait comme un saut plutôt que comme
      // une approche.
      // `oy` à -1,5 : la borne est plus bas dans le cadre, ce qui laisse de
      // l'air au-dessus d'elle — et c'est cet air qu'on traverse en montant
      // juste après.
      { key: 'kiosk', ox: 0, oy: -1.5, make: makeKiosk, update: updateKiosk,
        // Deux centièmes de queue, pas cinq. `apresPrec` interdit au court
        // d'exister avant la fin de ce plan : tant qu'il durait jusqu'à 0,103,
        // la caméra passait la porte vers 0,06 puis avançait quatre centièmes
