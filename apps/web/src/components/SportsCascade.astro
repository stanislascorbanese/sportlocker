      // ferait, et c'est ce liseré qui détache le meuble du fond.
      // Le liseré vert des arêtes : c'est la signature de la maquette, et
      // c'est ce qui rend la borne reconnaissable en une image.
      var areteMat = steel(dark ? 0x1d9e75 : 0xdfe9f1, 0.3, 0.35)
      var arete = new THREE.BoxGeometry(0.05, 3.62, 0.05)
      for (var ax = -1; ax <= 1; ax += 2) {
        for (var az = -1; az <= 1; az += 2) {
          var e = new THREE.Mesh(arete, areteMat)
          e.position.set(ax * 0.895, 0, az * 0.495)
          g.add(e)
        }
      }

      // Bandeau de marque, seul endroit du décor où le vert est franc.
      var band = new THREE.Mesh(
        new THREE.BoxGeometry(1.86, 0.26, 1.22),
        new THREE.MeshStandardMaterial({
          color: 0x1d9e75, roughness: 0.35, metalness: 0.2,
          emissive: 0x0d5c44, emissiveIntensity: dark ? 0.6 : 0.15,
        }),
      )
      band.position.y = 1.62
      g.add(band)

      // Socle : une borne posée à même le sol flotte. Le retrait sous le meuble
      // fait l'ombre portée que le rendu ne calcule pas.
      var socle = new THREE.Mesh(new THREE.BoxGeometry(1.66, 0.14, 0.86), steel(wellHex, 0.7, 0.3))
      socle.position.y = -1.85
      g.add(socle)

      var doorMat = steel(doorHex, 0.34, 0.55)
      // Le puits est visible DES DEUX CÔTÉS.
      //
      // Une face simple ne se dessine que vue de l'extérieur : dès que la
      // caméra entre dans la case, elle regarde le dos des parois, le GPU les
      // supprime, et on voit à travers le meuble — le terrain de tennis
      // apparaissait au loin à l'instant précis où l'écran devait être bouché.
      // Toute la coupe repose sur ces six faces.
      var wellMat = new THREE.MeshStandardMaterial({
        color: wellHex, roughness: 0.95, metalness: 0, side: THREE.DoubleSide,
      })
      var poigneeMat = steel(dark ? 0x8fb8cf : 0x7d8fa0, 0.2, 0.9)

      var doors = []
      // Le gabarit de la maquette, à la lettre : en haut deux grandes portes
      // pour le matériel long et la colonne d'interface à droite ; en bas six
      // casiers à ballons sur trois colonnes et deux rangées.
      //
      // L'ancienne disposition — deux grandes à gauche, six petites réparties
      // sur les deux autres colonnes — n'était pas celle du dessin, et c'est ce
      // qui faisait dire que la borne « avait changé ». Elle n'avait pas changé
      // de style, elle avait changé de plan.
      var cols = [-0.58, 0, 0.58]
      var layout = [
        [0, 0.95, 0.52, 1.5],
        [1, 0.95, 0.52, 1.5],
        [0, -0.45, 0.52, 0.62],
        [1, -0.45, 0.52, 0.62],
        [2, -0.45, 0.52, 0.62],
        [0, -1.15, 0.52, 0.62],
        [1, -1.15, 0.52, 0.62],
        [2, -1.15, 0.52, 0.62],
      ]
      for (var i = 0; i < layout.length; i++) {
        var L = layout[i], w = L[2], h = L[3], cx = cols[L[0]], cy = L[1]

        // Le puits derrière la porte, qui fait qu'une porte ouverte révèle une
        // cavité et non un trou dans le vide.
        //
        // Sa face avant dépasse de 1 cm celle de la caisse. Ce centimètre n'est
        // pas cosmétique : posées exactement dans le même plan, les deux faces
        // se disputent chaque pixel — le GPU n'a aucun moyen de les départager
        // et tranche au hasard, d'où les rayures verticales. En profondeur, deux
        // surfaces ne doivent jamais être à la même cote.
        var wellGeo = new THREE.BoxGeometry(w - 0.04, h - 0.04, 0.38)
        if (i === 3) {
          /**
           * LA CASE OUVERTE EST UNE CAVITÉ, PAS UNE BOÎTE.
           *
           * Voilà pourquoi le casier avait toujours l'air vide. Le puits est un
           * cube complet : sa face avant, à z = 0,51, se dresse juste derrière
           * la porte et bouche tout. Ce qu'on prenait pour l'intérieur de la
           * case était en réalité son COUVERCLE, vu de face — et les douze
           * objets rangés dedans étaient parfaitement dessinés, parfaitement
           * placés, et parfaitement cachés derrière une plaque.
           *
           * `BoxGeometry` range ses six faces en six groupes d'indices, dans
           * l'ordre +x, −x, +y, −y, +z, −z. On reconstruit l'INDEX sans le
           * cinquième — et non les groupes : le rendu n'en tient compte que
           * pour un tableau de matériaux, et le puits n'en a qu'une. Retirer
           * les groupes ne retirait donc aucun triangle.
           *
           * Cinq faces, donc : un fond, deux parois, un plafond, un plancher.
           * Une case ouverte.
           */
          var idx3 = wellGeo.index.array
          var garde = []
          for (var wg = 0; wg < wellGeo.groups.length; wg++) {
            if (wg === 4) continue
            var G3 = wellGeo.groups[wg]
            for (var k3 = 0; k3 < G3.count; k3++) garde.push(idx3[G3.start + k3])
          }
          wellGeo.setIndex(garde)
          wellGeo.clearGroups()
        }
        var well = new THREE.Mesh(wellGeo, wellMat)
        well.position.set(cx, cy, 0.32)
        g.add(well)

        // Le casier OUVERT reçoit un liseré intérieur : quatre baguettes de
        // néon dans le sens de la profondeur, plus un cadre au fond. Vu du
        // dehors ça ne se remarque pas ; vu du dedans — c'est-à-dire pendant la
        // coupe — c'est un tunnel lumineux qui fait le tour de l'image. Sans
        // lui, la coupe était couverte par du noir pur, ce qui est efficace
        // mais ne montre rien.
        if (i === 3) {
          var lisMat = new THREE.MeshStandardMaterial({
            color: 0x2bc295, roughness: 0.4, metalness: 0.1,
            // Le liseré de la case ouverte encadre maintenant un VRAI trou, et
            // ce qu'il y a dedans est ce qu'on doit regarder. À 1,4 le halo du
            // post-traitement le faisait virer au blanc et il mangeait les
            // objets ; à 0,8 il redevient ce qu'il doit être — un cadre vert.
            emissive: 0x2bc295, emissiveIntensity: dark ? 0.8 : 0.4,
