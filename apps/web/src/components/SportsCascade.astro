        // rayures à l'arrêt, et une porte qui s'ouvrait en passant au travers.
        var pivot = new THREE.Group()
        pivot.position.set(cx - w / 2, cy, 0.545)

        var panel = new THREE.Mesh(new THREE.BoxGeometry(w - 0.03, h - 0.03, 0.045), doorMat)
        panel.position.x = w / 2
        pivot.add(panel)

        // Le contour vert de chaque porte. C'est le trait qui fait lire la
        // maquette d'un coup d'œil : sans lui, huit rectangles de la même
        // valeur sur un fond de la même valeur ne forment plus une borne mais
        // un bloc. Quatre baguettes fines plutôt qu'une texture — c'est de la
        // géométrie, donc ça tient à n'importe quelle distance.
        var liseréMat = new THREE.MeshStandardMaterial({
          color: 0x1d9e75, roughness: 0.5, metalness: 0.2,
          // Émissif discret : le liseré doit se lire, pas briller. À 0,55 la
          // borne virait au néon sous le halo du post-traitement.
          emissive: 0x0d4a37, emissiveIntensity: 0.16,
        })
        var ew = w - 0.05, eh = h - 0.05
        var barres = [
          [ew, 0.022, 0, eh / 2],
          [ew, 0.022, 0, -eh / 2],
          [0.022, eh, -ew / 2, 0],
          [0.022, eh, ew / 2, 0],
        ]
        for (var e = 0; e < 4; e++) {
          var bd = barres[e]
          var bar = new THREE.Mesh(new THREE.BoxGeometry(bd[0], bd[1], 0.02), liseréMat)
          bar.position.set(w / 2 + bd[2], bd[3], 0.07)
          pivot.add(bar)
        }

