          var hw = (w - 0.06) / 2, hh = (h - 0.06) / 2
          for (var lx = -1; lx <= 1; lx += 2) {
            for (var ly = -1; ly <= 1; ly += 2) {
              var bag = new THREE.Mesh(new THREE.BoxGeometry(0.018, 0.018, 0.36), lisMat)
              bag.position.set(cx + lx * hw, cy + ly * hh, 0.32)
              g.add(bag)
            }
          }
          for (var lz = -1; lz <= 1; lz += 2) {
            var hbar = new THREE.Mesh(new THREE.BoxGeometry(w - 0.05, 0.018, 0.018), lisMat)
            hbar.position.set(cx, cy + lz * hh, 0.32 + lz * 0.0 - 0.17)
            g.add(hbar)
            var vbar = new THREE.Mesh(new THREE.BoxGeometry(0.018, h - 0.05, 0.018), lisMat)
            vbar.position.set(cx + lz * hw, cy, 0.15)
            g.add(vbar)
          }
        }

