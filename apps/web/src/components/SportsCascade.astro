      }
      scn.ball.rotation.x += 0.35

      // Le panier n'apparaît qu'au rebond, hors cadre, et ne repart plus.
      // Le panier n'existe qu'une fois la balle de tennis partie : il est à
      // vingt-cinq mètres derrière la ligne de fond, donc hors champ pendant
      // tout le tennis, et il émerge du brouillard pendant la traversée.
      scn.panier.visible = q > TERRAIN_BOUNCE + 0.06

      // Les tirs. Ils ne commencent qu'une fois l'appareil relevé : trois
      // paraboles pendant qu'on regarde ailleurs, personne ne les verrait.
      // Les tirs occupent 0,34 de plan au lieu de 0,5 pour trois paraboles :
      // chacune a maintenant le temps d'être vue. Le quatrième ballon ne part
      // qu'ensuite, sur ce qui reste.
      // Les tirs partent à q 0,58 et occupent tout ce qui reste du plan.
      //
      // 0,58 n'est pas un réglage de goût : c'est l'instant où la caméra,
      // descendue à 12,4 m et avancée à z 4, cadre l'arceau à trois degrés
      // au-dessus du centre de l'image. Avant, on tirait pendant qu'elle
      // regardait encore le court ; après, elle serait passée dessous.
      var qb = clamp01((q - TERRAIN_TIRS) / (TERRAIN_ECHAPPEE - TERRAIN_TIRS))
      var rim = scn.rim.getWorldPosition(new THREE.Vector3())
      var cible = scn.group.worldToLocal(rim)
      // Les trois tirs partent du côté court, à sept mètres du panneau. Plus
      // loin, la parabole passe au-dessus du cadre et on ne voit qu'un ballon
      // qui disparaît par le haut.
      // La trajectoire d'un tir, elle aussi comme fonction pure : la traîne
      // orange du moodboard s'échantillonne dessus.
      function tirAt(i, qi, out) {
        var d = DEPARTS[i]
        if (i === 3) return ballonQuiPart(qi, out)
        if (qi < 0.72) {
          var tt = qi / 0.72
          // La hauteur est étirée près du sommet : c'est la suspension, le
          // temps que le regard prend pour anticiper le panier.
          var lent = 1 - Math.pow(1 - tt, 2.2)
          var arc = Math.sin(Math.PI * Math.pow(tt, 0.82))
          return out.set(
            lerp(d[0], cible.x, lent),
            lerp(d[1], cible.y, lent) + arc * 2.6,
            lerp(d[2], cible.z, lent),
          )
        }
        // Le deuxième tir rentre ; le premier ricoche sur l'arceau ; le
        // troisième repart en cloche vers la gauche — c'est celui qui file
        // vers le terrain de pétanque, et qui donne au plan suivant une raison
        // d'exister plutôt que d'arriver.
        var t3 = (qi - 0.72) / 0.28
        if (i === 1) {
          return out.set(cible.x, cible.y - t3 * t3 * 3.2, cible.z + 0.1 * t3)
        }
        if (i === 0) {
          // Ricochet : il rebondit sur le cercle puis retombe court.
          var rico = Math.sin(Math.PI * Math.min(t3 * 1.6, 1)) * 0.7
          return out.set(cible.x - 1.5 * t3, cible.y + rico - t3 * t3 * 2.6, cible.z + 2.4 * t3)
        }
        // Le long renvoi vers la pétanque.
        return out.set(
          cible.x - 7.5 * t3,
          cible.y + Math.sin(Math.PI * Math.min(t3, 1)) * 2.2 - t3 * t3 * 1.8,
          cible.z + 9 * t3,
        )
      }
      for (var i = 0; i < scn.balls.length; i++) {
        var ball = scn.balls[i]
        // Le quatrième part en dernier et vit plus longtemps : ses rebonds
        // doivent tenir jusqu'à la coupe vers la pétanque.
        // Le quatrième part au tiers et occupe tout le reste : ses cinq
        // rebonds doivent être finis avant la coupe, sinon il s'éteint en l'air.
        var qi = i === 3
          ? clamp01((q - TERRAIN_ECHAPPEE) / (TERRAIN_FIN - TERRAIN_ECHAPPEE))
          : clamp01((qb - i * 0.2) / 0.6)
        // Ils restent visibles jusqu'au bout de leur course : un ballon qui
        // s'éteint en plein vol, c'est le genre de détail qu'on ne sait pas
        // nommer mais qui fait que l'image ne tient pas.
        // Le quatrième ne s'éteint JAMAIS une fois arrêté : il doit rester
        // posé devant le terrain de pétanque pendant qu'on avance vers lui.
        // C'est lui qui dit d'où l'on vient quand la boule prend le relais.
        var vu = qi > 0 && (i === 3 || qi < 0.999)
        ball.visible = vu
        scn.trails[i].group.visible = vu
        if (!vu) continue
        tirAt(i, qi, TMP3)
        ball.position.copy(TMP3)
        drawTrail(scn.trails[i], qi, i === 3 ? 0.012 : 0.02,
          function (qq, o) { return tirAt(i, qq, o) }, TMP3)
        ball.rotation.z += 0.12
      }
    }

    // ─── La borne ─────────────────────────────────────────────────────────────
    //
    // Le produit lui-même : une porte s'ouvre et un ballon en sort. C'est la
    // seule scène qui montre ce qu'on vend, et c'est pour ça qu'elle est la
    // première de la page.
    //
    // Les proportions sont celles de la vraie borne — 90 × 50 × 180 cm, huit
    // casiers sur trois colonnes — reprises de `data/produit.json`. Un décor qui
    // décrit une autre machine que la fiche technique, c'est ce qu'on a passé la
    // journée d'hier à corriger.

    function makeKiosk(p) {
      var g = new THREE.Group()
      var dark = sportSet(p) !== SPORT_LIGHT
      var t = textures()

      // Tôle brossée. C'est le matériau qui change tout : jusqu'ici le meuble
      // était un aplat mat, donc un rectangle. Une tôle réfléchit le panneau
      // lumineux du studio, et ce reflet qui glisse quand la borne tourne est ce
      // qui lui donne un volume.
      function steel(hex, rough, metal) {
        var m = new THREE.MeshStandardMaterial({
          color: hex,
          roughness: rough === undefined ? 0.38 : rough,
          metalness: metal === undefined ? 0.62 : metal,
        })
        // Aucune carte de rugosité ici, volontairement. C'est le reflet de
        // l'environnement qui fait lire le métal ; un faux brossage plaqué
        // par-dessus ne l'aide pas, il le salit. La borne est une tôle laquée
        // propre, pas une pièce d'atelier.
        return m
      }

      // La livrée de la maquette SVG du hero, à la couleur près : corps
      // #111C27, portes #0D1B2A, liseré #1D9E75. Ce n'est pas un choix
      // esthétique isolé — la maquette se fond dans ce modèle au début du
      // défilement, et deux objets qui n'ont pas la même couleur ne se fondent
      // pas l'un dans l'autre, ils se remplacent.
      // Éclaircies par rapport à la maquette SVG (#111C27 / #0D1B2A). Un
      // aplat qui marche en vectoriel ne marche pas en 3D : là-bas le dessin
      // porte les contours, ici c'est la lumière, et sur une valeur aussi
      // basse elle n'a plus rien à éclairer — le meuble devenait une dalle
      // noire où aucune porte ne se distinguait.
      var bodyHex = dark ? 0x1b2c3e : 0xb9c8d6
      var doorHex = dark ? 0x16263a : 0xd6e1ea
      var wellHex = dark ? 0x060d15 : 0x2b3a47

      var caisse = steel(bodyHex)
      /**
       * LA CAISSE, FAÇADE PERCÉE.
       *
       * Ouvrir le puits ne suffisait pas : derrière lui, à un centimètre, la
       * face avant de la caisse rebouchait le trou. On voyait donc toujours une
       * plaque, et les douze objets rangés derrière — parfaitement dessinés,
       * parfaitement placés — restaient invisibles jusqu'à ce qu'ils en
       * sortent. Un casier ouvert doit être un TROU dans le meuble, pas un
       * rectangle plus sombre dessiné dessus.
       *
       * On retire donc la face avant du cube, et on la redessine en quatre
       * bandes qui laissent la case ouverte à jour. Voir plus bas.
       */
      var caisseGeo = new THREE.BoxGeometry(1.8, 3.6, 1.0)
      var idxC = caisseGeo.index.array
      var gardeC = []
      for (var cg = 0; cg < caisseGeo.groups.length; cg++) {
        if (cg === 4) continue
        var GC = caisseGeo.groups[cg]
        for (var kc = 0; kc < GC.count; kc++) gardeC.push(idxC[GC.start + kc])
      }
      caisseGeo.setIndex(gardeC)
      caisseGeo.clearGroups()
      g.add(new THREE.Mesh(caisseGeo, caisse))

