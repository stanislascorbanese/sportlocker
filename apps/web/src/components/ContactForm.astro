---
import { SEGMENT_META, type TenantSegment } from '@/data/site'

interface Props {
  /** Le public de la page qui affiche le formulaire. */
  segment?: TenantSegment
}
const { segment = 'camping' } = Astro.props
const meta = SEGMENT_META[segment]
// « Nom du camping » sur une page hôtel donne le sentiment d'un formulaire
// recyclé — et c'est exactement ce que c'est, si on ne le nomme pas.
const nomChamp = segment === 'hotel' ? 'Nom de l’hôtel'
  : segment === 'village' ? 'Nom du village vacances'
  : segment === 'loisirs' ? 'Nom du site'
  : 'Nom du camping'
const exemple = segment === 'hotel' ? 'Hôtel des Dunes'
  : segment === 'village' ? 'Village vacances des Dunes'
  : segment === 'loisirs' ? 'Base de loisirs des Dunes'
  : 'Camping des Dunes'
const WEB3FORMS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? ''

/**
 * Formulaire de contact.
 *
 * Il ne sert pas seulement à récolter une adresse : il qualifie. Trois
 * questions décident si le sujet existe chez cet exploitant — combien
 * d'emplacements, quels terrains, comment ils prêtent aujourd'hui — et une
 * quatrième décide du calendrier commercial.
 *
 * La première question est la plus importante : elle laisse choisir « je veux
 * juste vous raconter comment on fait ». En septembre 2026, un gérant qui
 * accepte de raconter vaut plus qu'un devis envoyé dans le vide, et l'ancien
 * formulaire ne lui laissait aucune porte d'entrée.
 */

const INTENTIONS = [
  { value: 'devis', label: 'Je veux un devis', hint: 'Avec une idée de calendrier' },
  { value: 'visite', label: 'Je veux une visite', hint: 'Voir si ça a du sens chez moi' },
  { value: 'echange', label: 'Je veux juste en parler', hint: 'Vous raconter comment on fait' },
]

// L'unité de taille n'est pas la même d'un public à l'autre : un hôtelier
// compte des chambres, une base de loisirs des visiteurs par jour. Demander des
// emplacements à un hôtel, c'est avouer qu'on n'a pas relu son propre formulaire.
const UNITES = {
  camping: 'emplacements',
  hotel: 'chambres',
  village: 'hébergements',
  loisirs: 'visiteurs par jour en haute saison',
} as const

const TAILLES = [
  { value: '<80', label: 'Moins de 80' },
  { value: '80-150', label: '80 à 150' },
  { value: '150-300', label: '150 à 300' },
  { value: '300+', label: 'Plus de 300' },
]

const CLASSEMENTS = ['Non classé', '2 étoiles', '3 étoiles', '4 étoiles', '5 étoiles']

const TERRAINS = [
  'Terrain multisports / city-stade',
  'Ping-pong',
  'Pétanque',
  'Piscine ou espace aquatique',
  'Plage à moins de 10 minutes',
  'Aucun pour l’instant',
]

const PRETS = [
  { value: 'accueil', label: 'À l’accueil, contre une caution ou une pièce d’identité' },
  { value: 'libre', label: 'En libre accès, sans contrôle' },
  { value: 'anim', label: 'Uniquement pendant les animations' },
  { value: 'aucun', label: 'On ne prête pas de matériel' },
]

const ECHEANCES = [
  { value: '2027', label: 'Pour la saison 2027' },
  { value: '2028', label: 'Plutôt 2028' },
  { value: 'curiosite', label: 'Je me renseigne, sans échéance' },
]

const field =
  'w-full bg-black/30 border border-white/10 rounded-lg px-4 py-3 text-white placeholder:text-white/60 focus:border-brand-500 focus:outline-none focus:bg-black/40 transition-colors'
const legend = 'block text-xs uppercase tracking-[0.1em] text-white/60 mb-2'
---

<div class="card-dark p-7 sm:p-10" data-reveal data-reveal-delay="1">
  <form id="contact-form" class="space-y-7">
    <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
    <input type="hidden" name="subject" value={`SportLocker — demande · ${meta.label}`} />
    <input type="hidden" name="segment" value={segment} />
    <input type="hidden" name="from_name" value="SportLocker — site vitrine" />
    <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

    <!-- INTENTION -->
    <fieldset>
      <legend class={legend}>Que souhaitez-vous&nbsp;?</legend>
      <div class="grid sm:grid-cols-3 gap-3">
        {INTENTIONS.map((opt, i) => (
          <label class="relative cursor-pointer">
            <input
              type="radio"
              name="intention"
              value={opt.label}
              checked={i === 0}
              class="peer sr-only"
            />
            <span class="block rounded-lg border border-white/10 bg-black/20 px-4 py-3 text-sm transition-colors peer-checked:border-brand-500 peer-checked:bg-brand-500/10 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-400">
              <span class="block font-medium text-white">{opt.label}</span>
              <span class="block text-xs text-white/50 font-light mt-0.5">{opt.hint}</span>
            </span>
          </label>
        ))}
      </div>
    </fieldset>

    <!-- IDENTITÉ -->
    <div class="grid sm:grid-cols-2 gap-5">
      <div>
        <label for="organization" class={legend}>
          {nomChamp} <span class="text-brand-400">*</span>
        </label>
        <input required id="organization" name="organization" type="text" class={field} placeholder={exemple} />
      </div>
      <div>
        <label for="locality" class={legend}>
          Commune <span class="text-brand-400">*</span>
        </label>
        <input required id="locality" name="locality" type="text" class={field} placeholder="Saint-Jean-de-Monts (85)" />
      </div>
    </div>

    <!-- QUALIFICATION -->
    <div class="grid sm:grid-cols-2 gap-5">
      <div>
        <label for="taille" class={legend}>Nombre de {UNITES[segment]}</label>
        <select id="taille" name="taille" class={field}>
          {TAILLES.map((opt, i) => <option value={opt.label} selected={i === 2}>{opt.label}</option>)}
        </select>
      </div>
      <div>
        <label for="classement" class={legend}>Classement</label>
        <select id="classement" name="classement" class={field}>
          {CLASSEMENTS.map((label, i) => <option value={label} selected={i === 3}>{label}</option>)}
        </select>
      </div>
    </div>

    <fieldset>
      <legend class={legend}>Ce que vous avez déjà sur place</legend>
      <div class="grid sm:grid-cols-2 gap-x-5 gap-y-2.5">
        {TERRAINS.map((label) => (
          <label class="flex items-start gap-2.5 text-sm text-white/75 font-light cursor-pointer">
            <input type="checkbox" name="terrains" value={label} class="mt-1 accent-brand-500 shrink-0" />
            <span>{label}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset>
      <legend class={legend}>Comment prêtez-vous du matériel aujourd’hui&nbsp;?</legend>
      <div class="space-y-2.5">
        {PRETS.map((opt, i) => (
          <label class="flex items-start gap-2.5 text-sm text-white/75 font-light cursor-pointer">
            <input type="radio" name="pret" value={opt.label} checked={i === 0} class="mt-1 accent-brand-500 shrink-0" />
            <span>{opt.label}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <div>
      <label for="echeance" class={legend}>Votre horizon</label>
      <select id="echeance" name="echeance" class={field}>
        {ECHEANCES.map((opt, i) => <option value={opt.label} selected={i === 0}>{opt.label}</option>)}
      </select>
    </div>

    <!-- COORDONNÉES -->
    <div class="grid sm:grid-cols-2 gap-5">
      <div>
        <label for="email" class={legend}>
          Email <span class="text-brand-400">*</span>
        </label>
        <input required id="email" name="email" type="email" class={field} placeholder="contact@votre-etablissement.fr" />
      </div>
      <div>
        <label for="phone" class={legend}>Téléphone</label>
        <input id="phone" name="phone" type="tel" class={field} placeholder="06 12 34 56 78" />
      </div>
    </div>

    <div>
      <label for="message" class={legend}>Autre chose&nbsp;?</label>
      <textarea
        id="message"
        name="message"
        rows="4"
        class={`${field} resize-none`}
        placeholder="Ce qui vous agace aujourd’hui, une contrainte particulière, une question…"
      ></textarea>
    </div>

    <div class="flex items-start gap-3">
      <input required id="consent" type="checkbox" class="mt-1 accent-brand-500" />
      <label for="consent" class="text-xs text-white/55 font-light leading-relaxed">
        J’accepte que SportLocker me recontacte par email ou téléphone à propos de ma demande.
        Aucune donnée n’est transmise à des tiers
        (<a href="/confidentialite" class="underline hover:text-white">politique de confidentialité</a>).
      </label>
    </div>

    <button type="submit" class="btn btn-primary w-full" id="submit-btn">
      Envoyer →
    </button>

    <div id="form-status" class="hidden text-sm rounded-lg p-4 leading-relaxed" aria-live="polite"></div>
  </form>
</div>

<script>
  type FormStatus = 'success' | 'error' | 'loading'

  const params = new URLSearchParams(window.location.search)

  // Pré-remplissages depuis les liens du site (ex. « en parler » plutôt que
  // « demander un devis »), pour que le formulaire arrive déjà dans le bon ton.
  const intentionParam = params.get('intention')?.toLowerCase()
  if (intentionParam) {
    const map: Record<string, string> = {
      devis: 'Je veux un devis',
      visite: 'Je veux une visite',
      echange: 'Je veux juste en parler',
    }
    const wanted = map[intentionParam]
    if (wanted) {
      document.querySelectorAll<HTMLInputElement>('input[name="intention"]').forEach((el) => {
        el.checked = el.value === wanted
      })
    }
  }

  const localityParam = params.get('locality')
  if (localityParam) {
    const el = document.getElementById('locality') as HTMLInputElement | null
    if (el && !el.value) el.value = localityParam
  }

  const prefillParam = params.get('prefill')
  if (prefillParam) {
    const el = document.getElementById('message') as HTMLTextAreaElement | null
    if (el && !el.value) el.value = prefillParam
  }

  const form = document.getElementById('contact-form') as HTMLFormElement | null
  const status = document.getElementById('form-status') as HTMLDivElement | null
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null

  if (form && status && submitBtn) {
    const setStatus = (kind: FormStatus, text: string) => {
      status.classList.remove('hidden')
      status.className = 'text-sm rounded-lg p-4 leading-relaxed border'
      if (kind === 'success') {
        status.classList.add('bg-brand-500/10', 'border-brand-500/30', 'text-brand-400')
      } else if (kind === 'error') {
        status.classList.add('bg-red-500/10', 'border-red-500/30', 'text-red-300')
      } else {
        status.classList.add('bg-white/5', 'border-white/10', 'text-white/70')
      }
      status.textContent = text
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const data = new FormData(form)

      if ((data.get('botcheck') as string)?.length) {
        setStatus('success', 'Message envoyé. Réponse sous 48 h ouvrées.')
        form.reset()
        return
      }

      // Les cases à cocher multiples arrivent en entrées répétées : on les
      // regroupe pour que l'email reçu soit lisible d'un coup d'œil.
      const terrains = data.getAll('terrains').join(' · ')
      data.delete('terrains')
      if (terrains) data.set('terrains', terrains)

      const key = data.get('access_key') as string
      if (!key) {
        // Sans clé Web3Forms configurée, on n'avale pas la demande en silence :
        // on ouvre le client mail avec tout ce qui a été saisi.
        const lignes = [
          ['Demande', data.get('intention')],
          ['Établissement', data.get('organization')],
          ['Type', data.get('segment')],
          ['Commune', data.get('locality')],
          ['Emplacements', data.get('taille')],
          ['Classement', data.get('classement')],
          ['Sur place', terrains],
          ['Prêt actuel', data.get('pret')],
          ['Horizon', data.get('echeance')],
          ['Téléphone', data.get('phone')],
          ['', ''],
          ['', data.get('message')],
        ]
          .filter(([, v]) => v)
          .map(([k, v]) => (k ? `${k} : ${v}` : `${v}`))
          .join('\n')
        window.location.href =
          `mailto:stanislas.corbanese@gmail.com?subject=${encodeURIComponent('Demande — SportLocker')}` +
          `&body=${encodeURIComponent(lignes)}`
        return
      }

      submitBtn.disabled = true
      submitBtn.textContent = 'Envoi en cours…'
      setStatus('loading', 'Envoi…')

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        })
        const json = (await res.json()) as { success?: boolean; message?: string }
        if (res.ok && json.success) {
          setStatus(
            'success',
            'C’est envoyé. Vous recevez un email de confirmation, et nous revenons vers vous sous 48 h ouvrées.',
          )
          form.reset()
        } else {
          throw new Error(json.message ?? 'Erreur inconnue')
        }
      } catch {
        setStatus(
          'error',
          'L’envoi a échoué. Écrivez-nous directement à stanislas.corbanese@gmail.com, ça marchera.',
        )
      } finally {
        submitBtn.disabled = false
        submitBtn.textContent = 'Envoyer →'
      }
    })
  }
</script>
