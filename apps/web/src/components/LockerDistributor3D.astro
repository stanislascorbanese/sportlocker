---
// Distributeur SportLocker en 3D interactif avec annotations.
// Three.js (r128) chargé en lazy quand la section entre dans le viewport.
// Les traits d'étiquettes passent en pointillés quand le point d'ancrage
// est occulté par la borne (raycast caméra → ancre chaque frame).

// A11y : mêmes 6 étiquettes que le tableau `LABELS` du script (titre + détail),
// restituées en texte pour lecteurs d'écran. Les `.sl5-label` visuelles restent
// décoratives (aria-hidden). Garder ces deux sources synchronisées.
const labels = [
  { t: 'Casiers matériel long', d: 'Deux grandes portes pour raquettes, cordes à sauter, plots et frisbees. Verrou électromécanique IP54.' },
  { t: 'Casiers ballons', d: 'Six casiers 30×30×30 cm pour les ballons de football, basket et volley. Un article par casier.' },
  { t: 'QR code de la borne', d: "Le vacancier le scanne avec son propre téléphone. Aucun écran tactile à casser, à nettoyer ni à remplacer." },
  { t: 'Alimentation 230 V', d: 'Une prise standard, environ 30 W en veille. Onduleur intégré : la borne survit à une coupure de courant.' },
  { t: '4G intégrée', d: 'Carte SIM fournie. Aucun raccordement à votre réseau, aucun accès à votre wifi, aucun câble à tirer.' },
  { t: 'Capteur de fermeture', d: "Sur chaque porte. Le retour est détecté tout seul, sans que le vacancier ait quoi que ce soit à valider." },
]
---

<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-5">
  <div class="card-dark px-4 py-3">
    <div class="text-[0.7rem] uppercase tracking-wider text-white/60">Borne</div>
    <div class="text-sm font-medium text-white mt-1">Terrain multisports</div>
  </div>
  <div class="card-dark px-4 py-3">
    <div class="text-[0.7rem] uppercase tracking-wider text-white/60">État</div>
    <div class="text-sm font-medium text-brand-400 mt-1">En ligne</div>
  </div>
  <div class="card-dark px-4 py-3">
    <div class="text-[0.7rem] uppercase tracking-wider text-white/60">Alimentation</div>
    <div class="text-sm font-medium text-white mt-1">230 V · 4G</div>
  </div>
  <div class="card-dark px-4 py-3">
    <div class="text-[0.7rem] uppercase tracking-wider text-white/60">Casiers</div>
    <div class="text-sm font-medium text-white mt-1">8</div>
  </div>
</div>

<div
  id="sl5-stage"
  class="card-dark relative overflow-hidden"
  style="height:500px;cursor:grab"
  role="img"
  aria-label="Rendu 3D interactif annoté d'une borne SportLocker à huit casiers : deux grandes portes pour le matériel long, six casiers à ballons, et la plaque QR code que le vacancier scanne avec son téléphone. Des étiquettes reliées par des lignes de repère désignent les composants principaux."
></div>

<!-- A11y : contenu des 6 étiquettes 3D restitué en texte pour lecteurs d'écran. -->
<ul id="sl5-legend" class="sr-only">
  {labels.map((l) => (
    <li><strong>{l.t}</strong> — {l.d}</li>
  ))}
</ul>

<div class="flex flex-wrap gap-2 items-center mt-4 mb-3">
  <button id="sl5-open" class="btn btn-outline btn-sm" type="button">Ouvrir toutes les portes</button>
  <button id="sl5-rotate" class="btn btn-outline btn-sm" type="button">Rotation auto</button>
  <button id="sl5-labels" class="btn btn-outline btn-sm" type="button">Masquer les étiquettes</button>
  <button id="sl5-reset" class="btn btn-outline btn-sm" type="button">Réinitialiser la vue</button>
</div>

<div class="flex flex-wrap gap-x-4 gap-y-2 items-center text-[0.78rem] text-white/55">
  <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full" style="background:#1D9E75"></span>Disponible</span>
  <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full" style="background:#3A86DD"></span>Emprunté</span>
  <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full" style="background:#EFA12B"></span>À regarnir</span>
  <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full" style="background:#E24B4A"></span>Maintenance</span>
</div>

<p class="text-[0.78rem] text-white/75 mt-3">
  Glissez pour pivoter · molette pour zoomer · cliquez une porte pour l'ouvrir · survolez (ou touchez) une étiquette pour en lire le détail. Les couleurs sont celles de votre tableau de bord : vert disponible, bleu emprunté, orange casier vide à regarnir.
</p>

<script is:inline>
  (function () {
    var stage = document.getElementById('sl5-stage');
    if (!stage) return;

    var loaded = false;

    function init() {
      var THREE = window.THREE;
      if (!THREE) return;

      var W = stage.clientWidth || 680,
        H = 500;

      var STATUS = {
        idle: '#1D9E75',
        active: '#3A86DD',
        refill: '#EFA12B',
        maintenance: '#E24B4A',
      };
      // Dotation réelle du catalogue (produit.json) : ballons, raquettes,
      // matériel de plage, accessoires de terrain. Pas de rugby, pas de cônes
      // de chantier — on montre ce qu'on livre vraiment.
      var DOORS_DATA = [
        { n: 1, x: -1.0, y: 4.05, w: 0.92, h: 3.2, label: 'Raquettes', status: 'idle', word: 'Disponible', item: 'racket' },
        { n: 2, x: 0.0, y: 4.05, w: 0.92, h: 3.2, label: 'Plage', status: 'idle', word: 'Disponible', item: 'cones' },
        { n: 3, x: -1.0, y: 1.95, w: 0.92, h: 0.92, label: 'Football', status: 'idle', word: 'Disponible', item: 'ball', color: 0xf2f2ee },
        { n: 4, x: 0.0, y: 1.95, w: 0.92, h: 0.92, label: 'Basket', status: 'active', word: 'Emprunté', item: null },
        { n: 5, x: 1.0, y: 1.95, w: 0.92, h: 0.92, label: 'Volley', status: 'idle', word: 'Disponible', item: 'ball', color: 0xe8e4d8 },
        { n: 6, x: -1.0, y: 0.95, w: 0.92, h: 0.92, label: 'Frisbee', status: 'idle', word: 'Disponible', item: 'disk', color: 0x3a86dd },
        { n: 7, x: 0.0, y: 0.95, w: 0.92, h: 0.92, label: 'Mölkky', status: 'refill', word: 'À regarnir', item: null },
        { n: 8, x: 1.0, y: 0.95, w: 0.92, h: 0.92, label: 'Boules', status: 'active', word: 'Emprunté', item: null },
      ];

      var scene = new THREE.Scene();
      // Color grade navy unifié + brume exponentielle pour la profondeur ciné
      // (cohérent avec le héros Immersive3DStory). Le distributeur « ressort »
      // sur un fond plein navy plutôt que posé sur du vide clair.
      scene.fog = new THREE.FogExp2(0x0d1b2a, 0.028);
      var camera = new THREE.PerspectiveCamera(35, W / H, 0.1, 100);
      var renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setSize(W, H);
      // Fond navy plein (au lieu du transparent plat) : socle du rig « film ».
      renderer.setClearColor(0x0d1b2a, 1);
      stage.appendChild(renderer.domElement);

      // Resilience WebGL : Safari/macOS peut "perdre" le contexte WebGL
      // (GPU process corrompu, quota dépassé, mise en veille longue…) — sans
      // handler, le canvas reste noir silencieusement. On affiche un overlay
      // de fallback avec bouton "Recharger" pour que le visiteur sache quoi
      // faire au lieu de croire que la 3D est cassée.
      renderer.domElement.addEventListener('webglcontextlost', function (e) {
        e.preventDefault();
        stage.innerHTML =
          '<div style="height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.75rem;padding:2rem;text-align:center">' +
          '<p style="color:rgba(255,255,255,0.85);font-size:0.95rem;margin:0">Aperçu 3D temporairement interrompu</p>' +
          '<p style="color:rgba(255,255,255,0.5);font-size:0.8rem;margin:0;max-width:32ch;line-height:1.45">Safari a fermé le contexte graphique. Rechargez la page pour relancer le rendu.</p>' +
          '<button type="button" onclick="window.location.reload()" style="margin-top:0.25rem;padding:0.5rem 1rem;border-radius:9999px;background:#1D9E75;color:#0D1B2A;font-weight:600;font-size:0.85rem;border:0;cursor:pointer">Recharger la page</button>' +
          '</div>';
      }, false);

      // Éclairage « film » (repris du héros Immersive3DStory) : ambient bas,
      // hémisphère ciel vert pâle → sol navy, key chaude, fill froid bleu, et
      // surtout des rim lights teintées vert marque (#1D9E75) qui détourent la
      // silhouette de la borne pour créer un halo premium.
      scene.add(new THREE.AmbientLight(0x1a2e42, 0.45));
      scene.add(new THREE.HemisphereLight(0x9ad6c0, 0x0d1b2a, 0.5));
      var key = new THREE.DirectionalLight(0xfff4e0, 1.0);
      key.position.set(7, 9, 8);
      scene.add(key);
      var fill = new THREE.DirectionalLight(0x3a86dd, 0.28);
      fill.position.set(-7, 4, 5);
      scene.add(fill);
      // Spot avant doux sur la colonne interface (écran/PIN/QR) pour la lecture.
      scene.add(
        (function () {
          var p = new THREE.PointLight(0xffffff, 0.45, 9, 2);
          p.position.set(1.5, 2.6, 2.6);
          return p;
        })(),
      );
      // Rim light verte derrière/au-dessus de la borne : halo de détourage marque.
      var rimBack = new THREE.PointLight(0x1d9e75, 2.4, 18, 2);
      rimBack.position.set(0, 3.4, -3.4);
      scene.add(rimBack);
      // Rim verte latérale gauche (rebond sur les portes / arête solaire).
      var rimSide = new THREE.PointLight(0x1d9e75, 1.4, 14, 2);
      rimSide.position.set(-4.0, 3.0, -1.0);
      scene.add(rimSide);

      var machine = new THREE.Group();
      scene.add(machine);

      function mat(c, r, m) {
        // Défauts plus « premium » : carrosserie satinée (roughness ↓) avec une
        // pointe de metalness pour accrocher key + rim sans devenir miroir.
        return new THREE.MeshStandardMaterial({ color: c, roughness: r == null ? 0.5 : r, metalness: m == null ? 0.22 : m });
      }
      function box(w, h, d, c, r, m) {
        return new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat(c, r, m));
      }
      function emap(t, r, mt) {
        return new THREE.MeshStandardMaterial({ map: t, roughness: r == null ? 0.5 : r, metalness: mt == null ? 0.05 : mt });
      }
      function tex(w, h, draw) {
        var cv = document.createElement('canvas');
        cv.width = w;
        cv.height = h;
        draw(cv.getContext('2d'), w, h);
        var t = new THREE.CanvasTexture(cv);
        t.anisotropy = 4;
        return t;
      }
      function rshape(w, h, r) {
        var s = new THREE.Shape();
        r = Math.min(r, w / 2 - 0.001, h / 2 - 0.001);
        s.moveTo(-w / 2 + r, -h / 2);
        s.lineTo(w / 2 - r, -h / 2);
        s.absarc(w / 2 - r, -h / 2 + r, r, -Math.PI / 2, 0, false);
        s.lineTo(w / 2, h / 2 - r);
        s.absarc(w / 2 - r, h / 2 - r, r, 0, Math.PI / 2, false);
        s.lineTo(-w / 2 + r, h / 2);
        s.absarc(-w / 2 + r, h / 2 - r, r, Math.PI / 2, Math.PI, false);
        s.lineTo(-w / 2, -h / 2 + r);
        s.absarc(-w / 2 + r, -h / 2 + r, r, Math.PI, Math.PI * 1.5, false);
        return s;
      }
      function uvg(w, h) {
        var hw = w / 2,
          hh = h / 2;
        return {
          generateTopUV: function (g, v, a, b, c) {
            function u(i) {
              return new THREE.Vector2((v[i * 3] + hw) / w, (v[i * 3 + 1] + hh) / h);
            }
            return [u(a), u(b), u(c)];
          },
          generateSideWallUV: function () {
            return [new THREE.Vector2(0, 0), new THREE.Vector2(1, 0), new THREE.Vector2(1, 1), new THREE.Vector2(0, 1)];
          },
        };
      }
      function rgeo(w, h, depth, r) {
        var g = new THREE.ExtrudeGeometry(rshape(w, h, r), {
          depth: depth,
          bevelEnabled: true,
          bevelThickness: 0.012,
          bevelSize: 0.012,
          bevelSegments: 1,
          curveSegments: 5,
          UVGenerator: uvg(w, h),
        });
        g.translate(0, 0, -depth / 2);
        return g;
      }
      function rcol(w, h, depth, r, c, ro, me) {
        return new THREE.Mesh(rgeo(w, h, depth, r), mat(c, ro, me));
      }
      function rtex(w, h, depth, r, t, base, ro) {
        return new THREE.Mesh(rgeo(w, h, depth, r), [emap(t, ro == null ? 0.5 : ro), mat(base)]);
      }
      function rframe(ow, oh, iw, ih, depth, r, c, me) {
        var s = rshape(ow, oh, r);
        s.holes.push(rshape(iw, ih, Math.min(r, 0.05)));
        var g = new THREE.ExtrudeGeometry(s, {
          depth: depth,
          bevelEnabled: true,
          bevelThickness: 0.01,
          bevelSize: 0.01,
          bevelSegments: 1,
          curveSegments: 5,
        });
        g.translate(0, 0, -depth / 2);
        return new THREE.Mesh(g, mat(c, 0.5, me == null ? 0.3 : me));
      }

      // Carrosserie légèrement assombrie/refroidie pour mieux capter la rim
      // verte et ne pas « cramer » en blanc sur le fond navy. Les portes
      // restent claires (lisibilité), le liseré de marque reste TEAL.
      var BODY = 0xc4cad0,
        DOOR = 0xe4e8e8,
        TEAL = 0x1d9e75,
        DARK = 0x2b3137;

      // Proportions calées sur la fiche technique : 90 (L) × 50 (P) × 180 (H) cm.
      // Échelle du rendu : 1 unité = 30 cm, soit un module de casier à ballon.
      // Largeur 3.0, profondeur 1.67, hauteur hors socle 5.85.
      machine.add(
        (function () {
          var m = rcol(3.1, 0.34, 1.78, 0.07, 0x6e726c, 0.7, 0.05);
          m.position.set(0, 0.17, 0);
          return m;
        })(),
      );
      machine.add(
        (function () {
          var m = box(2.9, 5.5, 0.08, BODY);
          m.position.set(0, 3.05, -0.8);
          return m;
        })(),
      );
      machine.add(
        (function () {
          var m = box(0.1, 5.5, 1.66, BODY);
          m.position.set(-1.45, 3.05, 0);
          return m;
        })(),
      );
      machine.add(
        (function () {
          var m = box(0.1, 5.5, 1.66, BODY);
          m.position.set(1.45, 3.05, 0);
          return m;
        })(),
      );
      machine.add(
        (function () {
          var m = box(2.9, 0.1, 1.66, 0xc9cdc7);
          m.position.set(0, 5.78, 0);
          return m;
        })(),
      );
      machine.add(
        (function () {
          var m = box(2.9, 0.12, 1.66, 0xc9cdc7);
          m.position.set(0, 0.4, 0);
          return m;
        })(),
      );
      machine.add(
        (function () {
          var m = rcol(2.84, 5.42, 0.05, 0.18, BODY, 0.6, 0.1);
          m.position.set(0, 3.05, 0.77);
          return m;
        })(),
      );
      machine.add(
        (function () {
          var m = rcol(2.78, 5.36, 0.05, 0.16, BODY, 0.55, 0.1);
          m.position.set(0, 3.05, 0.815);
          return m;
        })(),
      );
      machine.add(
        (function () {
          var s = rcol(2.78, 0.06, 0.06, 0.03, TEAL, 0.5, 0.1);
          // Liseré de marque émissif : fin trait vert qui « glow » en façade.
          var sm = s.material;
          sm.emissive = new THREE.Color(TEAL);
          sm.emissiveIntensity = 0.8;
          if ('toneMapped' in sm) sm.toneMapped = false;
          s.position.set(0, 5.66, 0.84);
          return s;
        })(),
      );

      var doors = [];
      function doorTexture(lk) {
        var aspect = lk.h / lk.w,
          cw = 220,
          ch = Math.min(1024, Math.round(cw * aspect)),
          st = STATUS[lk.status];
        return tex(cw, ch, function (g, w, h) {
          g.fillStyle = '#E9ECEA';
          g.fillRect(0, 0, w, h);
          g.strokeStyle = '#C7CBC5';
          g.lineWidth = 4;
          g.strokeRect(14, 14, w - 28, h - 28);
          g.fillStyle = '#4a4a47';
          g.font = '600 ' + Math.round(w * 0.2) + 'px sans-serif';
          g.fillText(lk.n, w * 0.12, h * 0.04 + Math.round(w * 0.2));
          g.beginPath();
          g.fillStyle = st;
          g.arc(w * 0.78, h * 0.04 + Math.round(w * 0.06), Math.round(w * 0.055), 0, 7);
          g.fill();
          g.fillStyle = '#3a3a37';
          g.font = '600 ' + Math.round(w * 0.12) + 'px sans-serif';
          g.fillText(lk.label, w * 0.12, h * 0.89);
          g.fillStyle = '#7a7a76';
          g.font = Math.round(w * 0.09) + 'px sans-serif';
          g.fillText(lk.word, w * 0.12, h * 0.955);
          g.fillStyle = '#b3b7b1';
          g.beginPath();
          g.arc(w * 0.82, h * 0.5, Math.round(w * 0.03), 0, 7);
          g.fill();
          g.fillRect(w * 0.79, h * 0.46, Math.round(w * 0.06), Math.round(h * 0.08));
        });
      }
      function makeItem(lk) {
        var g = new THREE.Group();
        if (lk.item === 'ball') {
          g.add(new THREE.Mesh(new THREE.SphereGeometry(0.13, 24, 18), mat(lk.color, 0.55, 0.05)));
        } else if (lk.item === 'rugby') {
          var b = new THREE.Mesh(new THREE.SphereGeometry(0.12, 20, 16), mat(lk.color, 0.5, 0.05));
          b.scale.set(1, 1, 1.5);
          g.add(b);
        } else if (lk.item === 'disk') {
          var d = new THREE.Mesh(new THREE.CylinderGeometry(0.15, 0.15, 0.04, 28), mat(lk.color, 0.5, 0.05));
          d.rotation.x = Math.PI / 2;
          g.add(d);
        } else if (lk.item === 'racket') {
          var grip = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.03, 0.55, 12), mat(0x2b2b2b, 0.6, 0.1));
          grip.position.y = -0.55;
          g.add(grip);
          var shaft = new THREE.Mesh(new THREE.CylinderGeometry(0.022, 0.022, 0.45, 10), mat(0x9a9e98, 0.5, 0.3));
          shaft.position.y = -0.07;
          g.add(shaft);
          var head = new THREE.Mesh(new THREE.TorusGeometry(0.18, 0.022, 10, 28), mat(0xb0b4ae, 0.5, 0.3));
          head.position.y = 0.4;
          head.scale.y = 1.3;
          g.add(head);
        } else if (lk.item === 'cones') {
          [-0.5, -0.05, 0.4].forEach(function (yy, i) {
            var c = new THREE.Mesh(new THREE.ConeGeometry(0.17 - i * 0.005, 0.34, 18), mat(0xd85a30, 0.55, 0.05));
            c.position.y = yy;
            g.add(c);
          });
        }
        return g;
      }
      DOORS_DATA.forEach(function (lk) {
        // Fond de casier : gris ardoise plutôt que quasi-noir. Portes ouvertes,
        // huit rectangles noirs se lisaient comme des trous, pas comme des casiers.
        var rec = rcol(lk.w - 0.02, lk.h - 0.02, 0.01, 0.06, 0x39424a, 0.85, 0.0);
        rec.position.set(lk.x, lk.y, 0.842);
        machine.add(rec);
        if (lk.item) {
          var im = makeItem(lk);
          im.position.set(lk.x, lk.y, 0.66);
          machine.add(im);
        }
        var ledMat = new THREE.MeshStandardMaterial({
          color: STATUS[lk.status],
          emissive: STATUS[lk.status],
          emissiveIntensity: 1.35,
          roughness: 0.35,
        });
        // Non tone-mappé : la LED « glow » franchement sur le fond navy assombri.
        if ('toneMapped' in ledMat) ledMat.toneMapped = false;
        var led = new THREE.Mesh(new THREE.SphereGeometry(0.033, 12, 10), ledMat);
        led.position.set(lk.x + lk.w / 2 - 0.13, lk.y + lk.h / 2 - 0.13, 0.86);
        machine.add(led);
        var pivot = new THREE.Group();
        pivot.position.set(lk.x - lk.w / 2, lk.y, 0.87);
        machine.add(pivot);
        var door = rtex(lk.w, lk.h, 0.045, 0.06, doorTexture(lk), DOOR, 0.6);
        door.position.set(lk.w / 2, 0, 0);
        pivot.add(door);
        // ExtrudeGeometry applique la même texture aux deux capuchons : sans ce
        // panneau, l'intérieur d'une porte ouverte affichait « notnimdaB », le
        // numéro et la pastille d'état en miroir. On plaque un dos lisse.
        var backTex = tex(160, 160, function (g, w, h) {
          g.fillStyle = '#DDE1DE';
          g.fillRect(0, 0, w, h);
          g.strokeStyle = '#C9CDC8';
          g.lineWidth = 3;
          g.strokeRect(10, 10, w - 20, h - 20);
          g.fillStyle = '#A9AEA9';
          g.font = '600 15px sans-serif';
          g.textAlign = 'center';
          g.fillText('SportLocker', w / 2, h / 2 + 5);
          g.textAlign = 'left';
        });
        var back = new THREE.Mesh(
          new THREE.PlaneGeometry(lk.w - 0.05, lk.h - 0.05),
          new THREE.MeshStandardMaterial({ map: backTex, roughness: 0.75, metalness: 0.02 }),
        );
        back.rotation.y = Math.PI;
        back.position.set(0, 0, -0.05);
        door.add(back);
        var handle = rcol(0.05, Math.min(0.22, lk.h * 0.2), 0.04, 0.02, 0x8d918b, 0.5, 0.2);
        handle.position.set(lk.w - 0.11, 0, 0.04);
        door.add(handle);
        var d = { pivot: pivot, door: door, cur: 0, target: 0 };
        door.userData.d = d;
        doors.push(d);
      });
      doors[0].target = -1.95;
      doors[2].target = -1.95;

      // Colonne interface : troisième module (30 cm) en haut à droite, à côté
      // des deux grandes portes. Aucun écran : plaque QR + plaque signalétique.
      var IX = 1.0;
      machine.add(
        (function () {
