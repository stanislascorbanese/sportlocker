---
import { Image } from 'astro:assets'
import logoMark from '@/assets/brand/logo-mark-outline.png'
import { SITE } from '@/data/site'
const year = new Date().getFullYear()
---

<footer class="bg-navy-900 border-t border-white/10 pt-16 pb-8">
  <div class="container-x">
    <div class="grid gap-10 md:grid-cols-[2fr_1fr_1fr_1fr_1fr] mb-12">
      <div>
        <a href="/" class="flex items-center gap-2.5 mb-5" aria-label="SportLocker — accueil">
          <Image src={logoMark} alt="" class="w-10 h-10" width={80} height={80} densities={[1, 2]} loading="lazy" />
          <span class="font-extrabold text-[1.05rem] text-white">
            Sport<span class="text-brand-400">Locker</span>
          </span>
        </a>
        <p class="text-sm text-white/60 leading-relaxed max-w-[300px] font-light">
          Bornes de prêt de matériel sportif pour les campings de la côte atlantique.
          Conçues et installées depuis la Vendée.
        </p>
        <p class="mt-5 text-sm text-white/45 font-light max-w-[300px]">
          Vendée · Loire-Atlantique · Charente-Maritime
        </p>
      </div>

      <div>
        <div class="text-xs font-bold uppercase tracking-[0.06em] text-white mb-4">
          Solution
        </div>
        <ul class="flex flex-col gap-2.5 list-none">
          <li><a href="/la-borne" class="link-quiet text-sm">La borne</a></li>
          <li><a href="/tarifs" class="link-quiet text-sm">Tarifs</a></li>
          <li><a href="/installation-sav" class="link-quiet text-sm">Installation &amp; SAV</a></li>
          <li><a href="/comment-ca-marche" class="link-quiet text-sm">Comment ça marche</a></li>
        </ul>
      </div>

      <div>
        <div class="text-xs font-bold uppercase tracking-[0.06em] text-white mb-4">
          Pour qui
        </div>
        <ul class="flex flex-col gap-2.5 list-none">
          <li><a href="/" class="link-quiet text-sm">Campings</a></li>
          <li><a href="/hotels" class="link-quiet text-sm">Hôtels et résidences</a></li>
          <li><a href="/villages-vacances" class="link-quiet text-sm">Villages vacances</a></li>
          <li><a href="/bases-de-loisirs" class="link-quiet text-sm">Bases de loisirs</a></li>
        </ul>
      </div>

      <div>
        <div class="text-xs font-bold uppercase tracking-[0.06em] text-white mb-4">
          Société
        </div>
        <ul class="flex flex-col gap-2.5 list-none">
          <li><a href="/a-propos" class="link-quiet text-sm">À propos</a></li>
          <li><a href="/contact" class="link-quiet text-sm">Contact</a></li>
          <li>
            <a href={`mailto:${SITE.email}`} class="link-quiet text-sm">{SITE.email}</a>
          </li>
        </ul>
      </div>

      <div>
        <div class="text-xs font-bold uppercase tracking-[0.06em] text-white mb-4">
          Légal
        </div>
        <ul class="flex flex-col gap-2.5 list-none">
          <li><a href="/mentions-legales" class="link-quiet text-sm">Mentions légales</a></li>
          <li><a href="/confidentialite" class="link-quiet text-sm">Confidentialité</a></li>
          <li><a href="/cgu" class="link-quiet text-sm">Conditions d’utilisation</a></li>
          <li><a href="/cgv" class="link-quiet text-sm">Conditions de vente</a></li>
        </ul>
      </div>
    </div>

    <div class="flex flex-wrap justify-between items-center gap-3 pt-8 border-t border-white/10">
      <div class="text-xs text-white/60">© {year} {SITE.legalName} — Tous droits réservés</div>
      <div class="text-xs text-white/60">Fait en France</div>
    </div>
  </div>
</footer>
