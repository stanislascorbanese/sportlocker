---
import Base from '@/layouts/Base.astro'
import Hero from '@/components/Hero.astro'
import FinalCta from '@/components/FinalCta.astro'
import LockerDistributor3D from '@/components/LockerDistributor3D.astro'
import { OFFRE, SITE } from '@/data/site'

const vacancier = [
  {
    n: '01',
    title: 'Il scanne le QR code de la borne',
    desc: 'Une page web s’ouvre dans son navigateur. Rien à télécharger, aucun compte à créer, aucune carte bancaire à saisir.',
  },
  {
    n: '02',
    title: 'Il saisit son numéro de séjour et son nom',
    desc: 'C’est tout ce qu’il faut. Vous avez déjà son identité, son emplacement et sa caution depuis le check-in : on s’appuie dessus au lieu de les redemander.',
  },
  {
    n: '03',
    title: 'Il choisit un article disponible',
    desc: 'La page affiche ce qu’il reste dans la borne en temps réel. Un casier, un article.',
  },
  {
    n: '04',
    title: 'Le casier s’ouvre',
    desc: 'Moins d’une seconde. Le code est vérifié par la borne elle-même, pas par un serveur : ça marche même si la 4G est tombée.',
  },
  {
    n: '05',
    title: 'Il joue, puis il rend',
    desc: 'Il repose l’article dans un casier libre et referme la porte. Un capteur enregistre le retour, sans intervention de personne.',
  },
]

const accueil = [
  {
    n: '01',
    title: 'Un seul écran',
    desc: 'Quels casiers sont vides, ce qu’il faut y remettre. C’est la seule chose que votre saisonnier a besoin de savoir.',
  },
  {
    n: '02',
    title: 'La liste des non-rendus',
    desc: 'Avec le nom du client et son emplacement. Vous facturez sur le compte séjour comme pour un vélo.',
  },
  {
    n: '03',
    title: 'Une alerte si la borne décroche',
    desc: 'Perte de connexion, porte restée ouverte, casier bloqué : nous le voyons avant vous et nous intervenons à distance quand c’est possible.',
  },
]

const technique = [
  { label: 'Casiers', value: `${OFFRE.casiers} casiers individuels` },
  { label: 'Alimentation', value: 'Prise 230 V standard, onduleur de secours intégré' },
  { label: 'Connexion', value: '4G intégrée — aucun raccordement réseau à prévoir' },
  { label: 'Ouverture', value: 'Code signé vérifié localement, fonctionne hors ligne' },
  { label: 'Retour', value: 'Capteur de fermeture de porte sur chaque casier' },
  { label: 'Installation', value: 'Une demi-journée, aucun génie civil' },
  { label: 'Mises à jour', value: 'À distance, hors saison de préférence' },
  { label: 'Emplacement', value: 'Près du terrain multisports ou de l’espace aquatique, à l’abri si possible' },
]

const jsonLd = [
  {
    '@type': 'HowTo',
    name: 'Emprunter du matériel sportif dans une borne SportLocker',
    description:
      'Le parcours d’un vacancier qui emprunte un ballon ou une raquette dans la borne de son camping.',
    step: vacancier.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.title,
      text: s.desc,
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Comment ça marche', item: SITE.url + '/comment-ca-marche' },
    ],
  },
]
---

<Base
  title="Comment ça marche"
  description="Le parcours complet : le vacancier scanne, saisit son numéro de séjour, le casier s’ouvre. Côté camping, un écran de réassort et la liste des articles non rendus. Prise 230 V, 4G intégrée, aucun génie civil."
  extraJsonLd={jsonLd}
>
  <Hero
    tag="Le fonctionnement, en détail"
    title="Deux écrans pour le client,"
    highlight="un seul pour votre accueil."
    desc="Pas d’application à installer, pas de compte à créer, pas de carte bancaire. Le numéro de séjour suffit — vous l’avez déjà."
    primary={{ href: '/contact#formulaire', label: 'En parler 15 minutes' }}
    secondary={{ href: '/campings', label: 'Voir l’offre camping' }}
  />

  <!-- PARCOURS VACANCIER -->
  <section class="section-alt">
    <div class="container-x max-w-4xl">
      <div class="text-center mb-14">
        <span class="eyebrow" data-reveal>Côté vacancier</span>
        <h2 class="section-title mt-3" data-reveal data-reveal-delay="1">
          Trente secondes,<br/>de la borne au terrain.
        </h2>
      </div>
      <ol class="space-y-4">
        {vacancier.map((s, i) => (
          <li class="card-dark p-6 flex gap-5" data-reveal data-reveal-delay={String(i + 1)}>
            <div class="font-extrabold text-2xl text-brand-400 leading-none w-10 shrink-0">{s.n}</div>
            <div>
              <div class="font-bold text-white mb-1.5">{s.title}</div>
              <div class="text-sm text-white/60 font-light leading-relaxed">{s.desc}</div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PARCOURS ACCUEIL -->
  <section class="section">
    <div class="container-x max-w-4xl">
      <div class="text-center mb-14">
        <span class="eyebrow" data-reveal>Côté accueil</span>
        <h2 class="section-title mt-3" data-reveal data-reveal-delay="1">
          Dix minutes de formation,<br/>et c’est réglé.
        </h2>
      </div>
      <ol class="space-y-4">
        {accueil.map((s, i) => (
          <li class="card-dark p-6 flex gap-5" data-reveal data-reveal-delay={String(i + 1)}>
            <div class="font-extrabold text-2xl text-brand-400 leading-none w-10 shrink-0">{s.n}</div>
            <div>
              <div class="font-bold text-white mb-1.5">{s.title}</div>
              <div class="text-sm text-white/60 font-light leading-relaxed">{s.desc}</div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- BORNE 3D -->
  <section id="distributeur-3d" class="section-alt">
    <div class="container-x">
      <div class="text-center mb-10 max-w-3xl mx-auto">
        <span class="eyebrow" data-reveal>La borne</span>
        <h2 class="section-title mt-3" data-reveal data-reveal-delay="1">
          Faites-la tourner.
        </h2>
        <p class="section-sub mt-4 mx-auto text-center" data-reveal data-reveal-delay="2">
          Ouvrez les portes, survolez les étiquettes. Le rendu correspond à la borne en cours
          d’assemblage ; les dimensions définitives seront figées après le prototype.
        </p>
      </div>
      <div class="max-w-5xl mx-auto" data-reveal data-reveal-delay="3">
        <LockerDistributor3D />
      </div>
    </div>
  </section>

  <!-- FICHE TECHNIQUE -->
  <section class="section">
    <div class="container-x max-w-4xl">
      <div class="text-center mb-12">
        <span class="eyebrow" data-reveal>Ce qu’il faut prévoir</span>
        <h2 class="section-title mt-3" data-reveal data-reveal-delay="1">Fiche technique</h2>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {technique.map((t, i) => (
          <div class="card-dark p-6" data-reveal data-reveal-delay={String((i % 4) + 1)}>
            <div class="text-xs uppercase tracking-[0.12em] text-brand-400 mb-2">{t.label}</div>
            <div class="text-sm text-white/70 font-light leading-relaxed">{t.value}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FinalCta
    title="On vient voir où la poser."
    sub="Une demi-heure sur site suffit pour savoir si ça marche chez vous, et à quel endroit."
    primary={{ href: '/contact#formulaire', label: 'Demander une visite' }}
    secondary={{ href: '/campings', label: 'Voir l’offre camping' }}
    fine="Réponse sous 24 h ouvrées · Visite offerte en Vendée et Loire-Atlantique"
  />
</Base>
