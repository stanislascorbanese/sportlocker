---
import Base from '@/layouts/Base.astro'
import FinalCta from '@/components/FinalCta.astro'
import {
  AUTRES_SEGMENTS,
  SEGMENT_META,
  SITE,
  DOTATION,
  HORS_CATALOGUE,
  buildFilAriane,
} from '@/data/site'

// Cette page n'avait ni fil d'Ariane ni type : pour un moteur, c'était une page
// de plus sans place dans l'arborescence. `CollectionPage` dit ce qu'elle est —
// une porte d'entrée vers les quatre publics.
const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: 'Campings, hôtels et bases de loisirs',
    url: `${SITE.url}/pour-qui`,
  },
  buildFilAriane('Pour qui', 'pour-qui'),
]

/**
 * Pour qui.
 *
 * Le produit ne demande rien de propre au camping : une réception, un logiciel
 * de réservation, une référence de séjour, du 230 V. Cette page le dit, et
 * envoie chaque public vers sa page.
 *
 * Le camping garde la première place et pointe vers l'accueil : c'est là qu'on
 * a la preuve, la géographie et les chiffres. Les trois autres sont servis
 * après, pas en dessous.
 */

const camping = SEGMENT_META.camping
const autres = AUTRES_SEGMENTS.map((s) => SEGMENT_META[s])

/**
 * Les quatre prérequis, et ce que chacun veut dire dans la pratique.
 *
 * La liste seule tenait en quatre lignes, et laissait sans réponse la question
 * qui vient juste après : « un export CSV, ça veut dire quoi, il faut que mon
 * prestataire développe quelque chose ? » Non — et c'est précisément ce qu'il
 * faut écrire, parce que c'est l'objection qui fait abandonner avant le devis.
 */
const prerequis = [
  {
    titre: 'Une réception',
    detail:
      'Ou au moins quelqu’un qui enregistre les arrivées. C’est de là que vient la référence du séjour, et c’est la seule chose que la borne demande à votre organisation.',
  },
  {
    titre: 'Un logiciel de réservation',
    detail:
      'N’importe lequel, du moment qu’il sait sortir un export CSV — ils le savent tous. Rien à développer, rien à connecter : nous ne touchons pas à votre PMS.',
  },
  {
    titre: 'Une référence par client',
    detail:
      'Numéro d’emplacement, de chambre ou de dossier. Peu importe la forme : c’est ce que le client saisit sur son téléphone pour ouvrir un casier.',
  },
  {
    titre: 'Une prise 230 V',
    detail:
      'À moins de vingt mètres du point de pose, sur un sol plat. Pas de dalle à couler, pas de tranchée, pas de raccordement à votre réseau informatique.',
  },
]
---

<Base
  title="Campings, hôtels et bases de loisirs"
  description="La borne s’installe partout où il y a une réception, un logiciel de réservation et une prise 230 V : campings, hôtels, villages vacances, bases de loisirs."
  extraJsonLd={jsonLd}
>
  <section class="section pt-36 sm:pt-40">
    <div class="container-x max-w-4xl">
      <span class="eyebrow" data-reveal>Pour qui</span>
      <h1 class="section-title mt-3 mb-6" data-reveal data-reveal-delay="1">
        Campings, hôtels, bases de loisirs.<br /><span class="text-brand-400">La borne ne sait pas où elle est posée.</span>
      </h1>
      <p class="section-sub max-w-2xl" data-reveal data-reveal-delay="2">
        Elle demande quatre choses, et aucune n’est propre au camping. Si vous les avez, elle
        fonctionne chez vous exactement comme ailleurs — au même <a href="/tarifs" class="lien-texte">prix</a>, avec la même <a href="/la-borne" class="lien-texte">borne de huit casiers</a>.
      </p>

      <h2 class="section-title text-[1.6rem] sm:text-[1.9rem] mt-12 mb-6" data-reveal data-reveal-delay="3">
        Les quatre prérequis.
      </h2>

      <ul class="grid gap-4 sm:grid-cols-2" data-reveal data-reveal-delay="3">
        {prerequis.map((r) => (
          <li class="card-dark p-5">
            <h3 class="font-semibold mb-1">{r.titre}</h3>
            <p class="text-[0.95rem] leading-relaxed opacity-80">{r.detail}</p>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-sm opacity-70 max-w-2xl" data-reveal>
        Si les quatre sont réunis, la borne fonctionne chez vous. Si l’un manque, dites-le nous
        avant le devis. C’est le genre de détail qui se règle en dix minutes au téléphone, et qui
        coûte une demi-journée le jour de la pose.
      </p>
    </div>
  </section>

  <!--
    CE QUI NE CHANGE PAS D'UN PUBLIC À L'AUTRE.

    La page listait les quatre prérequis puis envoyait chacun vers sa page, en
    cinq cents mots. Or c'est ici qu'on répond à la seule question que se pose
    quelqu'un qui n'est pas gérant de camping : « est-ce que c'est vraiment le
    même produit, ou une version dégradée pour les autres ? » La réponse tient
    en une dotation identique et un tarif identique — autant l'écrire.
  -->
  <section class="section-alt">
    <div class="container-x max-w-4xl">
      <span class="eyebrow" data-reveal>Le même objet</span>
      <h2 class="section-title mt-3 mb-4" data-reveal data-reveal-delay="1">
        Une seule borne, un seul tarif.
      </h2>
      <p class="section-sub max-w-2xl mb-8" data-reveal data-reveal-delay="2">
        Il n’y a pas de version hôtel ni de version base de loisirs. C’est la même borne de huit
        casiers, la même <a href="/tarifs" class="lien-texte">grille de prix</a>, les mêmes
        délais d’<a href="/installation-sav" class="lien-texte">intervention</a>. Ce qui change
        d’un établissement à l’autre, c’est la dotation — et elle se décide avec vous.
      </p>
      <div class="grid gap-4 sm:grid-cols-2" data-reveal data-reveal-delay="3">
        {DOTATION.map((d) => (
          <div class="card-dark p-5">
            <h3 class="font-semibold mb-1">{d.titre}</h3>
            <p class="text-sm opacity-75 leading-relaxed">{d.detail}</p>
          </div>
        ))}
      </div>
      <p class="text-sm opacity-60 mt-6 max-w-2xl" data-reveal>{HORS_CATALOGUE}</p>
      <p class="text-sm opacity-70 mt-4 max-w-2xl" data-reveal>
        L’encombrement, l’alimentation et les prérequis de pose sont détaillés sur la
        <a href="/la-borne" class="lien-texte">fiche technique</a>, et le parcours du client
        dans <a href="/comment-ca-marche" class="lien-texte">comment ça marche</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-x max-w-4xl">
      <span class="eyebrow" data-reveal>Les publics</span>
      <h2 class="section-title mt-3 mb-10" data-reveal data-reveal-delay="1">
        Ce que chacun vient chercher.
      </h2>

      <a href="/" class="card-dark block p-7 no-underline transition-colors hover:bg-white/[0.06]" data-reveal data-reveal-delay="1">
        <div class="flex items-baseline justify-between gap-4 flex-wrap">
          <h3 class="font-semibold text-xl">{camping.label}</h3>
          <span class="text-meta uppercase tracking-wide text-brand-400">Notre priorité</span>
        </div>
        <p class="mt-2 text-[0.95rem] leading-relaxed opacity-80">{camping.argument}</p>
        <p class="mt-3 text-sm font-medium text-brand-400">Voir l’offre →</p>
      </a>

      <div class="mt-5 grid gap-5 md:grid-cols-3">
        {autres.map((s, i) => (
          <a
            href={`/${s.slug}`}
            class="card-dark block p-6 no-underline transition-colors hover:bg-white/[0.06]"
            data-reveal
            data-reveal-delay={String(i + 1)}
          >
            <h3 class="font-semibold text-lg">{s.label}</h3>
            <p class="mt-2 text-[0.95rem] leading-relaxed opacity-80">{s.argument}</p>
            <p class="mt-3 text-sm font-medium text-brand-400">En savoir plus →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x max-w-3xl">
      <span class="eyebrow" data-reveal>Et les communes ?</span>
      <h2 class="section-title mt-3 mb-5" data-reveal data-reveal-delay="1">
        Pas aujourd’hui, et on préfère le dire.
      </h2>
      <p class="section-sub" data-reveal data-reveal-delay="2">
        Sur l’espace public, un opérateur installé propose déjà le même service gratuitement.
        Et la commande publique impose un circuit que nous ne savons pas encore tenir : régie de
        recettes, autorisation d’occupation du domaine public. Nous préférons ne pas vous vendre
        quelque chose que nous ne saurions pas livrer proprement. Si vous êtes une collectivité et
        que le sujet vous intéresse quand même, écrivez-nous : nous vous dirons franchement où nous
        en sommes.
      </p>
    </div>
  </section>

  <FinalCta />
</Base>
