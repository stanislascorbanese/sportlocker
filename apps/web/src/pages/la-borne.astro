---
import Base from '@/layouts/Base.astro'
import Hero from '@/components/Hero.astro'
import FinalCta from '@/components/FinalCta.astro'
import LockerDistributor3D from '@/components/LockerDistributor3D.astro'
import { DOTATION, HORS_CATALOGUE, SITE, SPECS, buildBorneSchema, recommendBornes } from '@/data/site'

/**
 * Fiche technique.
 *
 * C'est la page qu'un gérant ouvre avant de décrocher son téléphone : il veut
 * vérifier que ça rentre chez lui, qu'il a une prise au bon endroit, et que ça
 * ne lui demande pas de travaux. Tous les fournisseurs installés du secteur en
 * ont une ; ne pas en avoir, c'est se faire écarter avant même d'être appelé.
 *
 * Règle de rédaction : aucune cote inventée. Ce qui n'est pas figé est
 * annoncé comme provisoire, avec la date à laquelle il le sera.
 */

const dimensionnement = [
  { taille: 'Jusqu’à 150 emplacements', bornes: recommendBornes(150), lieu: 'À côté du terrain multisports ou de la piscine.' },
  { taille: '150 à 300 emplacements', bornes: recommendBornes(250), lieu: 'Une près du terrain, une près de l’espace aquatique.' },
  { taille: 'Plus de 300 emplacements', bornes: recommendBornes(400), lieu: 'Une par pôle d’animation, pour éviter les allers-retours.' },
]

const jsonLd = [
  // La fiche technique elle-même, en `additionalProperty` : dix lignes que le
  // lecteur vérifie et qu'aucun moteur ne pouvait lire.
  ...buildBorneSchema(),
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'La borne', item: SITE.url + '/la-borne' },
    ],
  },
]
---

<Base
  title="La borne — fiche technique et prérequis"
  description="Encombrement, alimentation, connexion, fixation, contenu : tout ce qu’il faut vérifier avant l’installation. Une prise 230 V et un sol plat suffisent."
  extraJsonLd={jsonLd}
>
  <Hero
    tag="Fiche technique"
    title="Une borne de huit casiers."
    highlight="Est-ce que ça rentre chez vous ?"
    desc="Une prise 230 V, une surface plane, de préférence à l’abri. Pas de génie civil, pas de dalle à couler, aucun raccordement à votre réseau informatique."
    primary={{ href: '/contact#formulaire', label: 'Demander une visite' }}
    secondary={{ href: '/tarifs', label: 'Voir les tarifs' }}
  />

  <!-- 3D -->
  <section class="section-alt">
    <div class="container-x">
      <div class="max-w-5xl mx-auto" data-reveal>
        <LockerDistributor3D />
      </div>
    </div>
  </section>

  <!-- SPÉCIFICATIONS -->
  <section class="section">
    <div class="container-x max-w-3xl">
      <span class="eyebrow" data-reveal>Spécifications</span>
      <h2 class="section-title mt-3 mb-8" data-reveal data-reveal-delay="1">
        La borne en dix lignes
      </h2>

      <table class="spec-table" data-reveal data-reveal-delay="2">
        <tbody>
          {SPECS.map((spec) => (
            <tr>
              <th scope="row">{spec.poste}</th>
              <td>
                {spec.valeur}
                {spec.note && <span class="spec-note">{spec.note}</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      <p class="caveat mt-8" data-reveal>
        <strong class="text-white/85">Où en est le produit.</strong> Le prototype est en cours
        d’assemblage pour des essais en octobre 2026, en vue d’installations au printemps 2027.
        Les cotes ci-dessus seront figées à l’issue de ces essais. Nous préférons vous l’écrire
        ici plutôt que vous le découvrir le jour de la pose. Les <a href="/tarifs" class="lien-texte">trois formules et leurs prix</a> de la saison 2027 sont déjà
        arrêtés, eux.
      </p>
    </div>
  </section>

  <!-- CE QU'IL Y A DEDANS -->
  <section class="section-alt">
    <div class="container-x">
      <div class="text-center mb-14 max-w-2xl mx-auto">
        <span class="eyebrow" data-reveal>La dotation</span>
        <h2 class="section-title mt-3 mb-4" data-reveal data-reveal-delay="1">
          Douze articles, choisis avec vous
        </h2>
        <p class="section-sub mx-auto text-center" data-reveal data-reveal-delay="2">
          Le contenu s’ajuste à votre clientèle après la première saison : les chiffres du
          tableau de bord disent ce qui sort et ce qui dort. Le tableau de bord et le parcours
          du vacancier sont détaillés dans <a href="/comment-ca-marche" class="lien-texte">comment ça marche</a>.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {DOTATION.map((item, i) => (
          <div class="card-dark p-7" data-reveal data-reveal-delay={String(i + 1)}>
            <h3 class="font-extrabold text-white mb-2">{item.titre}</h3>
            <p class="text-sm text-white/55 font-light leading-relaxed">{item.detail}</p>
          </div>
        ))}
      </div>

      <p class="text-center text-sm text-white/45 font-light mt-8" data-reveal>
        {HORS_CATALOGUE}
      </p>
    </div>
  </section>

  <!-- COMBIEN DE BORNES -->
  <section class="section">
    <div class="container-x">
      <div class="text-center mb-14">
        <span class="eyebrow" data-reveal>Dimensionnement</span>
        <h2 class="section-title mt-3" data-reveal data-reveal-delay="1">
          Une borne couvre<br/>environ 120 emplacements.
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-5 max-w-5xl mx-auto">
        {dimensionnement.map((d, i) => (
          <div class="card-dark p-7" data-reveal data-reveal-delay={String(i + 1)}>
            <div class="text-xs uppercase tracking-[0.12em] text-brand-400 mb-3">{d.taille}</div>
            <div class="font-extrabold text-3xl text-white mb-2">
              {d.bornes} <span class="text-base font-light text-white/50">borne{d.bornes > 1 ? 's' : ''}</span>
            </div>
            <p class="text-sm text-white/55 font-light leading-relaxed">{d.lieu}</p>
          </div>
        ))}
      </div>
      <p class="text-center text-xs text-white/40 font-light mt-8 max-w-2xl mx-auto" data-reveal>
        Ordre de grandeur pour situer. La bonne question n’est pas le nombre d’emplacements,
        c’est la distance entre la borne et vos terrains. Au-delà de deux ou trois minutes de
        marche, les gens n’y vont plus.
      </p>
    </div>
  </section>

  <FinalCta
    title="Un doute sur l’emplacement ?"
    sub="C’est exactement ce qu’on regarde pendant la visite. Trente minutes, et vous savez où elle irait et ce qu’il faut prévoir."
    primary={{ href: '/contact#formulaire', label: 'Demander une visite' }}
    secondary={{ href: '/installation-sav', label: 'Installation & SAV' }}
    fine="Devis sous 48 h · Visite offerte en Vendée, Loire-Atlantique et Charente-Maritime"
  />
</Base>
