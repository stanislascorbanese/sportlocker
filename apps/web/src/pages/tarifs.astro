---
import Base from '@/layouts/Base.astro'
import Hero from '@/components/Hero.astro'
import Faq from '@/components/Faq.astro'
import MiniSimulator from '@/components/MiniSimulator.tsx'
import FinalCta from '@/components/FinalCta.astro'
import { OFFRES, REPERE_MARCHE, SITE } from '@/data/site'

/**
 * Page tarifs.
 *
 * Aucun gros fournisseur du secteur n'affiche ses prix. C'est précisément
 * pourquoi on les affiche : un gérant qui doit demander un devis pour savoir
 * si c'est dans son budget ne demande pas le devis. Afficher un prix qualifie
 * les contacts entrants et évite les rendez-vous inutiles des deux côtés.
 */

const comparatif = [
  { critere: 'Investissement de départ', pilote: '0 €', achat: '4 500 € HT', location: '0 €' },
  { critere: 'Coût sur la saison', pilote: '894 € HT', achat: '790 € HT d’abonnement', location: '2 094 € HT' },
  { critere: 'Propriétaire de la borne', pilote: 'SportLocker', achat: 'Vous', location: 'SportLocker' },
  { critere: 'Matériel sportif fourni', pilote: 'Oui', achat: 'Oui', location: 'Oui' },
  { critere: 'Maintenance et pièces', pilote: 'Incluses', achat: 'Incluses dans l’abonnement', location: 'Incluses' },
  { critere: 'Engagement', pilote: 'Une saison', achat: 'Aucun', location: 'Une saison' },
  { critere: 'Dépose en fin de saison', pilote: 'Incluse', achat: 'Vous la gardez', location: 'Incluse' },
  { critere: 'Coût la 2ᵉ année', pilote: 'Vous basculez sur achat ou location', achat: '790 € HT', location: '2 094 € HT' },
]

const faq = [
  {
    q: 'Pourquoi affichez-vous vos prix alors que personne ne le fait ?',
    a: 'Parce que vous avez autre chose à faire que demander un devis pour savoir si c’est dans votre budget. Un prix écrit vous fait gagner un appel, et nous fait gagner les rendez-vous où nous n’avons rien à proposer.',
  },
  {
    q: 'À partir de quand faut-il décider ?',
    a: 'La borne s’installe avant l’ouverture d’avril, et la fabrication demande quatre à six semaines. Concrètement, une décision prise entre novembre et février tient le calendrier ; en mars, c’est tendu.',
  },
  {
    q: 'Que se passe-t-il si la saison n’est pas concluante ?',
    a: 'En saison pilote et en location, nous reprenons la borne à la fermeture et vous ne devez rien de plus. En achat, elle vous appartient : vous pouvez arrêter l’abonnement, la borne continue de fonctionner pour le prêt, vous perdez seulement les mises à jour et la maintenance à distance.',
  },
  {
    q: 'Les prix sont-ils négociables sur plusieurs bornes ?',
    a: 'Oui, à partir de deux bornes sur le même site : l’installation se fait en une seule visite et le coût baisse. Dites-nous combien vous en envisagez, le devis en tiendra compte.',
  },
  {
    q: 'Et si je facture le prêt à mes clients ?',
    a: 'La recette est intégralement la vôtre. SportLocker ne prélève aucune commission et n’intervient jamais dans l’encaissement — la ligne part sur le compte séjour, réglée au départ, comme la laverie.',
  },
  {
    q: 'Y a-t-il des frais cachés ?',
    a: 'La carte SIM, l’hébergement, les mises à jour et le remplacement du matériel d’usure sont dans l’abonnement. Restent à votre charge : l’électricité de la borne (environ 30 W), et le remplacement de ce qu’un client casse ou ne rend pas — que vous lui facturez.',
  },
]

const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Tarifs', item: SITE.url + '/tarifs' },
    ],
  },
]
---

<Base
  title="Tarifs — saison pilote, achat, location"
  description="Saison pilote 149 € HT/mois, achat 4 500 € HT + 790 € HT/saison, location saisonnière 349 € HT/mois. Matériel, maintenance et remplacement compris dans les trois formules."
  extraJsonLd={jsonLd}
>
  <Hero
    tag="Tarifs"
    title="Trois formules,"
    highlight="et les prix écrits."
    desc="Vous saurez en trente secondes si c’est dans votre budget. Matériel sportif, maintenance et remplacement des pièces d’usure sont compris dans les trois cas."
    primary={{ href: '/contact#formulaire', label: 'Demander un devis' }}
    secondary={{ href: '/la-borne', label: 'Fiche technique' }}
  />

  <!-- LES TROIS FORMULES -->
  <section class="section-alt">
    <div class="container-x">
      <div class="grid md:grid-cols-3 gap-5 items-stretch">
        {OFFRES.map((offre, i) => (
          <div
            class:list={['price-card', offre.vedette ? 'price-card-featured' : '']}
            data-reveal
            data-reveal-delay={String(i + 1)}
          >
            {offre.vedette && <span class="tag tag-brand self-start mb-4">Places limitées</span>}
            <h2 class="font-extrabold text-xl text-white">{offre.label}</h2>
            <p class="text-sm text-white/55 font-light mt-1.5 mb-6">{offre.pitch}</p>

            <div class="price-amount">{offre.prix}</div>
            <p class="text-sm text-white/50 font-light mt-1">{offre.prixDetail}</p>

            {offre.recurrent && (
              <div class="mt-4 pt-4 border-t border-white/10">
                <div class="font-extrabold text-lg text-white">{offre.recurrent}</div>
                <p class="text-sm text-white/50 font-light mt-1">{offre.recurrentDetail}</p>
              </div>
            )}

            <ul class="check-list mt-6 mb-6">
              {offre.inclus.map((item) => <li>{item}</li>)}
            </ul>

            {offre.limite && <p class="caveat mb-6">{offre.limite}</p>}

            <p class="text-xs text-white/40 font-light mt-auto mb-6">{offre.pourQui}</p>

            <a href="/contact#formulaire" class:list={['btn btn-sm w-full', offre.vedette ? 'btn-primary' : 'btn-outline']}>
              Demander un devis
            </a>
          </div>
        ))}
      </div>

      <p class="text-center text-sm text-white/45 font-light mt-10 max-w-2xl mx-auto" data-reveal>
        {REPERE_MARCHE.texte} <span class="text-white/30">({REPERE_MARCHE.source})</span>
      </p>
    </div>
  </section>

  <!-- BUDGET -->
  <section class="section">
    <div class="container-x max-w-3xl">
      <div class="text-center mb-10">
        <span class="eyebrow" data-reveal>Votre budget</span>
        <h2 class="section-title mt-3 mb-4" data-reveal data-reveal-delay="1">
          Combien pour votre camping ?
        </h2>
        <p class="section-sub mx-auto text-center" data-reveal data-reveal-delay="2">
          Déplacez le curseur sur la taille de votre site.
        </p>
      </div>
      <div data-reveal data-reveal-delay="3">
        <MiniSimulator client:visible />
      </div>
    </div>
  </section>

  <!-- COMPARATIF -->
  <section class="section-alt">
    <div class="container-x max-w-4xl">
      <span class="eyebrow" data-reveal>Comparatif</span>
      <h2 class="section-title mt-3 mb-8" data-reveal data-reveal-delay="1">
        Les trois formules, ligne à ligne
      </h2>

      <div class="overflow-x-auto" data-reveal data-reveal-delay="2">
        <table class="spec-table min-w-[38rem]">
          <thead>
            <tr>
              <th scope="col" class="w-[28%]">&nbsp;</th>
              <th scope="col" class="text-brand-400">Saison pilote</th>
              <th scope="col">Achat</th>
              <th scope="col">Location</th>
            </tr>
          </thead>
          <tbody>
            {comparatif.map((row) => (
              <tr>
                <th scope="row">{row.critere}</th>
                <td class="text-white/80">{row.pilote}</td>
                <td>{row.achat}</td>
                <td>{row.location}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="text-xs text-white/40 font-light mt-6" data-reveal>
        Prix hors taxes, hors frais de déplacement au-delà de la Vendée, de la Loire-Atlantique
        et de la Charente-Maritime. Une saison va d’avril à septembre.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container-x max-w-3xl">
      <div class="text-center mb-12">
        <span class="eyebrow" data-reveal>Questions</span>
        <h2 class="section-title mt-3" data-reveal data-reveal-delay="1">Ce qu’on nous demande</h2>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <FinalCta
    title="Un devis, sous 48 h."
    sub="Dites-nous la taille de votre camping et où sont vos terrains. On vous répond avec un prix ferme et un calendrier."
    primary={{ href: '/contact#formulaire', label: 'Demander un devis' }}
    secondary={{ href: '/la-borne', label: 'Fiche technique' }}
    fine="Devis sous 48 h ouvrées · Visite de site offerte sur la façade atlantique"
  />
</Base>
