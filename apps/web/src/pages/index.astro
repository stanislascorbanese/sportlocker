---
import Base from '@/layouts/Base.astro'
import Hero from '@/components/Hero.astro'
import ContactForm from '@/components/ContactForm.astro'
import FinalCta from '@/components/FinalCta.astro'
import LockerDistributor3D from '@/components/LockerDistributor3D.astro'
import {
  A_VOTRE_CHARGE,
  ENGAGEMENTS,
  OFFRES,
  PMS_MESSAGE,
  buildSegmentSchemas,
} from '@/data/site'

// Constat écrit à la première personne d'un gérant, sans un seul pourcentage :
// aucune étude publique ne mesure le prêt de matériel en camping, et inventer
// un chiffre est le meilleur moyen de se faire prendre par quelqu'un du métier.
const constats = [
  'Le ballon se prête à l’accueil, contre une pièce d’identité et un cahier.',
  'L’accueil ferme entre 12 h et 14 h, et après 19 h — c’est-à-dire quand les gens jouent.',
  'Personne ne sait combien de raquettes ont disparu cet été.',
  'La grille de classement demande de proposer du prêt de matériel. Il faut bien le cocher.',
]

const piliers = [
  {
    icon: '🔓',
    title: 'Ouvert quand vos clients jouent',
    desc: 'Le vacancier scanne le QR code de la borne, saisit son numéro de séjour, le casier s’ouvre. Nuit comprise, sans passer par l’accueil.',
  },
  {
    icon: '📋',
    title: 'Vous savez enfin ce qui sort',
    desc: 'Chaque emprunt est nominatif et horodaté. Ce qui n’est pas rentré apparaît avec le nom du client et son emplacement.',
  },
  {
    icon: '🧾',
    title: 'Rien à encaisser pour nous',
    desc: 'Le prêt peut être gratuit, ou porté sur le compte séjour comme le pain et la laverie. SportLocker ne touche jamais l’argent de vos clients.',
  },
]
---

<Base
  title="Le matériel de sport de votre camping, en libre-service"
  description="Une borne de 8 casiers connectés dans votre camping. Vos clients empruntent ballon, raquette ou matériel de plage avec leur numéro de séjour, 24 h/24, sans passer par l’accueil. Saison pilote à 149 € HT/mois, achat à 4 500 € HT."
  extraJsonLd={buildSegmentSchemas('camping')}
>
  <Hero
    tag="Hôtellerie de plein air · côte atlantique"
    title="Le matériel de sport de votre camping,"
    highlight="en libre-service."
    desc="Une borne de huit casiers, posée près du terrain multisports. Vos clients prennent un ballon ou une raquette avec leur numéro de séjour, à toute heure, sans passer par l’accueil. Vous savez ce qui sort et ce qui ne revient pas."
    primary={{ href: '/contact#formulaire', label: 'Demander un devis' }}
    secondary={{ href: '/la-borne', label: 'Voir la fiche technique' }}
  >
    <div class="hero-metrics">
      <div>
        <div class="hero-metric-value"><span data-counter="8">8</span></div>
        <div class="hero-metric-label">Casiers<br/>par borne</div>
      </div>
      <div>
        <div class="hero-metric-value">24<span class="hero-metric-accent">h</span></div>
        <div class="hero-metric-label">Disponible<br/>même la nuit</div>
      </div>
      <div>
        <div class="hero-metric-value">0</div>
        <div class="hero-metric-label">Minute d’accueil<br/>mobilisée</div>
      </div>
      <div>
        <div class="hero-metric-value"><span data-counter="10">10</span><span class="hero-metric-accent">min</span></div>
        <div class="hero-metric-label">Pour former<br/>un saisonnier</div>
      </div>
    </div>
  </Hero>

  <!-- CONSTAT -->
  <section class="section-alt">
    <div class="container-x">
      <div class="grid lg:grid-cols-2 gap-14 items-center">
        <div>
          <span class="eyebrow" data-reveal>Le constat</span>
          <h2 class="section-title mt-3 mb-5" data-reveal data-reveal-delay="1">
            Le terrain est là.<br/>Le ballon est à l’accueil.
          </h2>
          <p class="section-sub" data-reveal data-reveal-delay="2">
            Presque tous les campings prêtent du matériel. Presque aucun ne sait combien il en
            perd, ni combien de temps son accueil y passe en juillet. Et le prêt s’arrête quand
            l’accueil ferme.
          </p>
        </div>
        <div class="grid gap-3" data-reveal data-reveal-delay="3">
          {constats.map((c) => (
            <div class="card-dark p-5">
              <div class="text-sm text-white/70 font-light leading-relaxed">« {c} »</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CE QUE ÇA CHANGE -->
  <section class="section">
    <div class="container-x">
      <div class="text-center mb-14">
        <span class="eyebrow" data-reveal>Ce que ça change</span>
        <h2 class="section-title mt-3 mx-auto" data-reveal data-reveal-delay="1">
          Une armoire qui se gère<br/>toute seule.
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-5">
        {piliers.map((p, i) => (
          <div class="card-dark p-8 hover:border-brand-500/30 transition-colors" data-reveal data-reveal-delay={String(i + 1)}>
            <div class="w-12 h-12 rounded-lg bg-brand-500/10 border border-brand-500/30 grid place-items-center text-2xl mb-5">
              {p.icon}
            </div>
            <h3 class="font-extrabold text-lg text-white mb-3">{p.title}</h3>
            <p class="text-sm text-white/55 leading-relaxed font-light">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CLASSEMENT -->
  <section class="section-alt">
    <div class="container-x">
      <div class="max-w-3xl mx-auto text-center">
        <span class="eyebrow" data-reveal>Classement</span>
        <h2 class="section-title mt-3 mb-5" data-reveal data-reveal-delay="1">
          Deux critères de la grille,<br/>sans embaucher personne.
        </h2>
        <p class="section-sub mx-auto text-center" data-reveal data-reveal-delay="2">
          La grille de classement des terrains de camping demande, au niveau 4 étoiles, de
          proposer de la location de matériel sur place et de mettre à disposition le prêt de
          jeux et de raquettes. Une borne SportLocker répond aux deux, sans mobiliser votre
          accueil et sans saisonnier dédié.
        </p>
        <p class="text-xs text-white/40 mt-6 font-light" data-reveal data-reveal-delay="3">
          Référentiel Atout France, chapitre équipements et services. Vérifiez le libellé exact
          des critères avec votre organisme évaluateur.
        </p>
      </div>
    </div>
  </section>

  <!-- TARIFS -->
  <section id="tarifs" class="section">
    <div class="container-x">
      <div class="text-center mb-14 max-w-2xl mx-auto">
        <span class="eyebrow" data-reveal>Trois façons de s’équiper</span>
        <h2 class="section-title mt-3 mb-4" data-reveal data-reveal-delay="1">
          Les prix sont écrits.
        </h2>
        <p class="section-sub mx-auto text-center" data-reveal data-reveal-delay="2">
          Vous saurez en trente secondes si c’est dans votre budget. C’est le minimum qu’on
          vous doit avant de vous demander un rendez-vous.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-5 items-stretch">
        {OFFRES.map((offre, i) => (
          <div
            class:list={['price-card', offre.vedette ? 'price-card-featured' : '']}
            data-reveal
            data-reveal-delay={String(i + 1)}
          >
            {offre.vedette && <span class="tag tag-brand self-start mb-4">Places limitées</span>}
            <h3 class="font-extrabold text-xl text-white">{offre.label}</h3>
            <p class="text-sm text-white/55 font-light mt-1.5 mb-6">{offre.pitch}</p>

            <div class="price-amount">{offre.prix}</div>
            <p class="text-sm text-white/50 font-light mt-1">{offre.prixDetail}</p>

            {offre.recurrent && (
              <div class="mt-4 pt-4 border-t border-white/10">
                <div class="font-extrabold text-lg text-white">{offre.recurrent}</div>
                <p class="text-sm text-white/50 font-light mt-1">{offre.recurrentDetail}</p>
              </div>
            )}

            <ul class="check-list mt-6 mb-6">
              {offre.inclus.map((item) => <li>{item}</li>)}
            </ul>

            {offre.limite && <p class="caveat mb-6">{offre.limite}</p>}

            <p class="text-xs text-white/40 font-light mt-auto">{offre.pourQui}</p>
          </div>
        ))}
      </div>

      <div class="text-center mt-12">
        <a href="/tarifs" class="btn btn-outline">Le détail de chaque formule →</a>
      </div>
    </div>
  </section>

  <!-- LA BORNE -->
  <section class="section-alt">
    <div class="container-x">
      <div class="text-center mb-10 max-w-3xl mx-auto">
        <span class="eyebrow" data-reveal>La borne</span>
        <h2 class="section-title mt-3" data-reveal data-reveal-delay="1">
          Voilà ce qui arrive<br/><span class="text-brand-400">dans votre camping.</span>
        </h2>
        <p class="section-sub mt-4 mx-auto text-center" data-reveal data-reveal-delay="2">
          Faites-la pivoter, ouvrez les portes. Huit casiers, une prise 230 V, une carte SIM.
          Pas de génie civil, pas de raccordement à votre réseau.
        </p>
      </div>

      <div class="max-w-5xl mx-auto" data-reveal data-reveal-delay="3">
        <LockerDistributor3D />
      </div>

      <div class="text-center mt-10">
        <a href="/la-borne" class="btn btn-outline">Fiche technique et prérequis →</a>
      </div>
    </div>
  </section>

  <!-- CE QUI RASSURE -->
  <section class="section">
    <div class="container-x">
      <div class="text-center mb-14 max-w-2xl mx-auto">
        <span class="eyebrow" data-reveal>Nos engagements</span>
        <h2 class="section-title mt-3 mb-4" data-reveal data-reveal-delay="1">
          Ce qui se passe<br/>quand ça casse.
        </h2>
        <p class="section-sub mx-auto text-center" data-reveal data-reveal-delay="2">
          C’est la vraie question quand on achète à quelqu’un qu’on ne connaît pas encore.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {ENGAGEMENTS.map((e, i) => (
          <div class="card-dark p-7" data-reveal data-reveal-delay={String((i % 3) + 1)}>
            <h3 class="font-extrabold text-white mb-2">{e.titre}</h3>
            <p class="text-sm text-white/55 font-light leading-relaxed">{e.detail}</p>
          </div>
        ))}
      </div>

      <div class="max-w-3xl mx-auto mt-12" data-reveal>
        <h3 class="font-extrabold text-white mb-4 text-center">Et ce qui reste à votre charge</h3>
        <ul class="check-list sm:grid sm:grid-cols-2 sm:gap-x-8 sm:space-y-0 sm:[&>li]:mb-3">
          {A_VOTRE_CHARGE.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="text-center mt-10">
        <a href="/installation-sav" class="btn btn-outline">Installation, SAV, fin de contrat →</a>
      </div>
    </div>
  </section>

  <!-- PMS -->
  <section class="section-alt">
    <div class="container-x">
      <div class="max-w-3xl mx-auto text-center">
        <span class="eyebrow" data-reveal>Compatibilité</span>
        <h2 class="section-title mt-3 mb-5" data-reveal data-reveal-delay="1">
          {PMS_MESSAGE.titre}
        </h2>
        <p class="section-sub mx-auto text-center" data-reveal data-reveal-delay="2">
          {PMS_MESSAGE.corps}
        </p>
        <p class="text-sm text-white/45 mt-5 font-light" data-reveal data-reveal-delay="3">
          {PMS_MESSAGE.cite}
        </p>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="section">
    <div class="container-x max-w-3xl">
      <div class="text-center mb-12">
        <span class="eyebrow" data-reveal>Saison 2027</span>
        <h2 class="section-title mt-3" data-reveal data-reveal-delay="1">
          Trois campings pilotes recherchés
        </h2>
        <p class="section-sub mt-4 mx-auto text-center" data-reveal data-reveal-delay="2">
          En Vendée et Loire-Atlantique, pour la saison 2027. Et si vous voulez simplement nous
          raconter comment vous prêtez du matériel aujourd’hui, c’est utile aussi — c’est même
          ce qui nous intéresse le plus en ce moment.
        </p>
      </div>
      <ContactForm segment="camping" />

      <!--
        La porte de sortie pour les autres publics.
        Toute cette page parle camping, et c'est voulu — c'est là qu'on a la
        preuve et les chiffres. Mais un hôtelier qui a lu jusqu'ici mérite mieux
        que de refermer l'onglet en se disant que ce n'est pas pour lui : la
        borne ne demande rien de propre au camping.
      -->
      <p class="mt-10 text-center text-sm opacity-70" data-reveal>
        Vous n’êtes pas un camping ? La borne s’installe aussi en
        <a href="/hotels" class="link-quiet underline">hôtel ou résidence</a>,
        en <a href="/villages-vacances" class="link-quiet underline">village vacances</a>
        et sur une <a href="/bases-de-loisirs" class="link-quiet underline">base de loisirs</a>.
        <a href="/pour-qui" class="link-quiet underline">Ce qu’il faut pour qu’elle marche chez vous</a>.
      </p>
    </div>
  </section>

  <FinalCta
    title="Trente minutes sur votre site."
    sub="On regarde ensemble où poser la borne et où est la prise. Vous saurez tout de suite si ça a du sens chez vous."
    primary={{ href: '/contact#formulaire', label: 'Demander une visite' }}
    secondary={{ href: '/tarifs', label: 'Voir les tarifs' }}
    fine="Devis sous 48 h · Visite offerte en Vendée, Loire-Atlantique et Charente-Maritime"
  />
</Base>
