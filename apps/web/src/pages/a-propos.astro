---
import Base from '@/layouts/Base.astro'
import Hero from '@/components/Hero.astro'
import FinalCta from '@/components/FinalCta.astro'
import { SITE } from '@/data/site'

/**
 * À propos.
 *
 * Un gérant qui achète 4 500 € à une société inconnue n'achète pas une
 * société : il achète une personne, et il évalue le risque qu'elle disparaisse.
 * Cette page répond donc à quatre questions dans cet ordre — qui, pourquoi les
 * campings, à quelle distance, et que se passe-t-il si ça s'arrête.
 *
 * Aucun chiffre d'usage ici : aucune borne n'a encore fait une saison. Ceux qui
 * figuraient sur cette page en mai 2026 (34 % de renoncement, 8 % de sites
 * équipés) n'avaient aucune source et ont été retirés.
 */

const reperes = [
  { value: '8', label: 'Casiers par borne' },
  { value: '24 h', label: 'Service disponible, nuit comprise' },
  { value: '< 1 h', label: 'De route pour la plupart des sites vendéens' },
  { value: '2027', label: 'Premières installations, saison de printemps' },
]

const jsonLd = [
  {
    '@type': 'AboutPage',
    name: `À propos — ${SITE.name}`,
    description: 'Qui est derrière SportLocker, pourquoi les campings, et où en est le produit.',
    url: `${SITE.url}/a-propos`,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'À propos', item: SITE.url + '/a-propos' },
    ],
  },
]
---

<Base
  title="À propos"
  description="Qui est derrière SportLocker, pourquoi le choix des campings de la côte atlantique, et où en est vraiment le produit : borne, logiciel, premiers pilotes."
  extraJsonLd={jsonLd}
>
  <Hero
    tag="À propos"
    title="Une borne de prêt de matériel de sport."
    highlight="Une armoire à ballons qui se gère toute seule."
    desc="SportLocker est né en Vendée, premier département français pour la capacité de camping. L’idée est simple, et elle vient du terrain : presque tous les lieux de séjour prêtent du matériel, presque aucun ne sait combien il en perd."
    primary={{ href: '/contact#formulaire', label: 'En parler 15 minutes' }}
    secondary={{ href: '/la-borne', label: 'Voir la borne' }}
  />

  <!-- QUI -->
  <section class="section-alt">
    <div class="container-x max-w-3xl">
      <span class="eyebrow" data-reveal>Qui</span>
      <h2 class="section-title mt-3 mb-6" data-reveal data-reveal-delay="1">
        Une personne, pas un service commercial
      </h2>
      <div class="space-y-5 text-white/70 font-light leading-relaxed" data-reveal data-reveal-delay="2">
        <p>
          Je m’appelle Stanislas Corbanese. Je suis élève ingénieur généraliste à l’Icam Vendée,
          en apprentissage dans l’industrie, et je construis SportLocker en parallèle depuis
          2026 : la mécanique, l’électronique, le logiciel embarqué, l’application et le site que
          vous lisez.
        </p>
        <p>
          Concrètement, la personne qui vous répondra au téléphone est celle qui a dessiné la
          borne et qui viendra la poser. C’est une limite — je ne peux pas être partout — et
          c’est aussi ce qui fait qu’un problème remonte en une conversation au lieu de trois
          tickets.
        </p>
      </div>
    </div>
  </section>

  <!-- POURQUOI LES CAMPINGS -->
  <section class="section">
    <div class="container-x max-w-3xl">
      <span class="eyebrow" data-reveal>Pourquoi les campings</span>
      <h2 class="section-title mt-3 mb-6" data-reveal data-reveal-delay="1">
        Parce que c’est là que le problème existe vraiment
      </h2>
      <div class="space-y-5 text-white/70 font-light leading-relaxed" data-reveal data-reveal-delay="2">
        <p>
          Le projet visait d’abord les communes. Deux acteurs financés y sont déjà installés,
          avec une offre gratuite pour l’usager : il n’y avait pas de place, et surtout pas de
          modèle qui tienne. Nous l’avons écrit noir sur blanc plutôt que de continuer.
        </p>
        <p>
          En camping, le sujet est différent et il est concret : le prêt de matériel est un
          critère de classement, il mobilise l’accueil aux heures où il est déjà débordé, et il
          s’arrête précisément quand les gens veulent jouer. C’est un problème d’exploitation,
          pas une idée de service.
        </p>
        <p>
          La Vendée compte plus de 330 campings et 52 000 emplacements, la Charente-Maritime
          presque autant. Nous sommes au milieu du plus gros marché de France pour ce produit,
          et à moins d’une heure de route de la plupart des sites.
        </p>
      </div>
    </div>
  </section>

  <!-- REPÈRES -->
  <section class="section-alt">
    <div class="container-x">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-5 max-w-4xl mx-auto">
        {reperes.map((r, i) => (
          <div class="card-dark p-7 text-center" data-reveal data-reveal-delay={String(i + 1)}>
            <div class="font-extrabold text-3xl text-brand-400">{r.value}</div>
            <div class="text-sm text-white/55 font-light mt-2 leading-snug">{r.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- OÙ ON EN EST -->
  <section class="section">
    <div class="container-x max-w-3xl">
      <span class="eyebrow" data-reveal>Où on en est</span>
      <h2 class="section-title mt-3 mb-6" data-reveal data-reveal-delay="1">
        Aucun camping équipé, et nous le disons
      </h2>
      <div class="space-y-5 text-white/70 font-light leading-relaxed" data-reveal data-reveal-delay="2">
        <p>
          Le logiciel est écrit et déployé : l’application du vacancier, le tableau de bord,
          l’électronique embarquée. Le prototype matériel est en cours d’assemblage pour des
          essais en octobre 2026, en vue d’installations au printemps 2027.
        </p>
        <p>
          Nous cherchons trois campings pilotes pour cette première saison, à conditions
          préférentielles, en échange de retours d’usage honnêtes. Vous l’apprendrez de toute
          façon au premier rendez-vous : autant que vous le sachiez avant.
        </p>
      </div>

      <div class="caveat mt-8" data-reveal data-reveal-delay="3">
        <strong class="text-white/85">Et si SportLocker s’arrête&nbsp;?</strong> C’est une
        question légitime face à une jeune entreprise, et elle a une réponse concrète. La borne
        n’a pas besoin de nos serveurs pour ouvrir un casier : le code est vérifié localement.
        Les serrures, les capteurs et l’électronique sont des composants du commerce, pas des
        pièces propriétaires. Un camping équipé garde une armoire qui fonctionne, et un
        électricien peut la dépanner.
      </div>
    </div>
  </section>

  <FinalCta
    title="Le mieux, c’est encore d’en parler."
    sub="Quinze minutes au téléphone, ou trente sur votre site. Même si vous n’achetez rien, votre façon de faire nous intéresse."
    primary={{ href: '/contact?intention=echange#formulaire', label: 'En parler' }}
    secondary={{ href: '/tarifs', label: 'Voir les tarifs' }}
    fine="Devis sous 48 h ouvrées · Visite offerte en Vendée, Loire-Atlantique et Charente-Maritime"
  />
</Base>
