---
// La FAQ vit au plus près de ce qu'elle rassure : l'installation et le SAV.
// Astro est en sortie statique : pas d'Astro.redirect ici, on sert une page de
// redirection meta-refresh pour ne pas casser les liens entrants.
const target = '/installation-sav#faq'
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={`https://sportlocker.fr${target}`} />
    <title>Redirection — SportLocker</title>
  </head>
  <body>
    <p>Cette page a déménagé. <a href={target}>Voir les questions fréquentes</a>.</p>
  </body>
</html>
