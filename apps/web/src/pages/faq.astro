---
// La FAQ vit désormais sur la page campings, au plus près de l'offre.
// Page conservée en redirection pour ne pas casser les liens entrants.
const target = '/campings#faq'
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href="https://sportlocker.fr/campings" />
    <title>Redirection — SportLocker</title>
  </head>
  <body>
    <p>La FAQ a déménagé. <a href={target}>Voir les questions fréquentes</a>.</p>
  </body>
</html>
