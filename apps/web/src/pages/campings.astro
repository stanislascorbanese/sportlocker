---
import Base from '@/layouts/Base.astro'
import Hero from '@/components/Hero.astro'
import ContactForm from '@/components/ContactForm.astro'
import Faq from '@/components/Faq.astro'
import FinalCta from '@/components/FinalCta.astro'
import { OFFRE, buildSegmentSchemas, loyerSaison, recommendBornes } from '@/data/site'

const eur = (n: number): string =>
  new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 0 }).format(n) + ' € HT'

const catalogue = [
  { icon: '⚽', title: 'Ballons', desc: 'Football, basket, volley. Le fond du sujet : c’est ce qu’on vous demande le plus.' },
  { icon: '🏓', title: 'Raquettes', desc: 'Ping-pong, badminton, beach-tennis, avec balles et volants.' },
  { icon: '🏖️', title: 'Matériel de plage', desc: 'Raquettes de plage, frisbees, mölkky, jeux de boules.' },
  { icon: '🥅', title: 'Accessoires de terrain', desc: 'Chasubles, plots, cordes à sauter, filets de rechange.' },
]

const dimensionnement = [
  { taille: 'Jusqu’à 150 emplacements', bornes: recommendBornes(150), lieu: 'À côté du terrain multisports ou de la piscine.' },
  { taille: '150 à 300 emplacements', bornes: recommendBornes(250), lieu: 'Une près du terrain, une près de l’espace aquatique.' },
  { taille: 'Plus de 300 emplacements', bornes: recommendBornes(400), lieu: 'Une par pôle d’animation, pour éviter les allers-retours.' },
]

const objections = [
  {
    q: 'On prête déjà du matériel à l’accueil, ça marche.',
    a: 'Ça marche aux heures d’ouverture. La borne prend le relais le midi, le soir et le week-end, et elle vous dit ce qui n’est pas revenu — ce que le cahier de l’accueil ne fait pas.',
  },
  {
    q: 'Mes clients ne vont pas scanner un QR code.',
    a: 'Ils scannent déjà celui du wifi, celui du menu du snack et celui du planning d’animation. Le parcours tient en deux écrans : numéro de séjour, choix de l’article.',
  },
  {
    q: 'Le matériel va disparaître.',
    a: 'C’est le cas aujourd’hui, sans savoir chez qui. Là, chaque emprunt est nominatif et rattaché à un emplacement. Vous facturez sur le compte séjour comme pour un vélo.',
  },
  {
    q: 'Je n’ai pas de budget d’investissement.',
    a: `La location saisonnière existe pour ça : ${eur(OFFRE.loyerMensuel)} par mois sur ${OFFRE.moisSaison} mois, tout compris, sans immobilisation.`,
  },
  {
    q: 'C’est un logiciel de plus à gérer.',
    a: 'Votre accueil a un seul écran : quels casiers sont vides, quoi remettre dedans. Dix minutes de formation pour un saisonnier.',
  },
]

const faq = [
  {
    q: 'Qu’est-ce qu’il faut prévoir sur place ?',
    a: 'Une prise 230 V et une surface plane, de préférence sous auvent. La borne communique en 4G : aucun raccordement réseau, aucun génie civil.',
  },
  {
    q: 'Quand faut-il décider pour la saison prochaine ?',
    a: 'La borne s’installe avant l’ouverture d’avril. Concrètement, la décision se prend entre novembre et janvier, la fabrication suit en février-mars.',
  },
  {
    q: 'Est-ce que je peux facturer les emprunts ?',
    a: 'Oui, sur le compte séjour du client, réglé au check-out, comme la laverie. Vous fixez vos prix et vous gardez tout : SportLocker ne prélève aucune commission.',
  },
  {
    q: 'Que se passe-t-il hors saison ?',
    a: 'En achat, la borne reste à vous : vous la fermez ou vous la laissez tourner. En location, nous la reprenons en fin de saison et la réinstallons au printemps suivant.',
  },
  {
    q: 'Qui remplace le matériel usé ?',
    a: 'L’abonnement couvre le remplacement du matériel d’usure normale. Ce qui est cassé ou perdu par un client vous est réglé par lui, via le compte séjour.',
  },
  {
    q: 'Vous avez déjà des campings équipés ?',
    a: 'Pas encore. Nous cherchons des campings pilotes en Vendée pour la saison 2027, avec des conditions préférentielles en échange de vos retours d’usage. Autant vous le dire franchement plutôt que de vous laisser le découvrir.',
    note: 'premières installations prévues au printemps 2027.',
  },
]
---

<Base
  title="Une borne de prêt de matériel sportif pour votre camping"
  description={`Borne de ${OFFRE.casiers} casiers connectés pour campings. Vos clients empruntent ballon, raquette ou matériel de plage avec leur numéro de séjour, 24 h/24, sans mobiliser l’accueil. ${eur(OFFRE.prixBorne)} installée, ou ${eur(OFFRE.loyerMensuel)}/mois en location saisonnière.`}
  extraJsonLd={buildSegmentSchemas('camping')}
>
  <Hero
    tag="Hôtellerie de plein air"
    title="Vos clients jouent quand ils veulent,"
    highlight="pas quand l’accueil est ouvert."
    desc="Une borne de huit casiers près du terrain multisports. Le vacancier prend un ballon avec son numéro de séjour, le rend quand il a fini, et vous savez exactement ce qui est sorti."
    primary={{ href: '/contact#formulaire', label: 'Demander une visite' }}
    secondary={{ href: '/comment-ca-marche', label: 'Comment ça marche' }}
  />

  <!-- POURQUOI MAINTENANT -->
  <section class="section-alt">
    <div class="container-x">
      <div class="grid lg:grid-cols-2 gap-14 items-start">
        <div data-reveal>
          <span class="eyebrow">Le sujet</span>
          <h2 class="section-title mt-3 mb-5">
            Le prêt de matériel est<br/>un critère de classement.
          </h2>
          <p class="section-sub">
            La grille de classement des terrains de camping demande, au niveau 4 étoiles, de
            proposer de la location de matériel sur place et de mettre à disposition le prêt de
            jeux et de raquettes. La plupart des campings le font avec une armoire et un cahier.
            C’est exactement ce que la borne remplace.
          </p>
        </div>
        <div class="card-dark p-8" data-reveal data-reveal-delay="1">
          <div class="text-xs uppercase tracking-[0.12em] text-brand-400 mb-4">Ce que vous gagnez</div>
          <ul class="space-y-3 text-sm text-white/70 font-light">
            <li>— Un service disponible le midi, le soir et le dimanche.</li>
            <li>— Un accueil qui ne gère plus les cautions ni les pièces d’identité.</li>
            <li>— La liste de ce qui n’est pas revenu, avec le nom et l’emplacement.</li>
            <li>— Deux critères de la grille cochés sans embaucher.</li>
            <li>— Un bilan de saison chiffré pour arbitrer l’an prochain.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CATALOGUE -->
  <section class="section">
    <div class="container-x">
      <div class="text-center mb-14">
        <span class="eyebrow" data-reveal>Ce qu’il y a dedans</span>
        <h2 class="section-title mt-3" data-reveal data-reveal-delay="1">
          Ce que vos clients demandent<br/>déjà à l’accueil.
        </h2>
        <p class="section-sub mt-4 mx-auto text-center" data-reveal data-reveal-delay="2">
          {OFFRE.articlesInclus} articles fournis à l’installation, répartis dans {OFFRE.casiers} casiers.
          Le contenu s’ajuste à votre clientèle après la première saison.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {catalogue.map((c, i) => (
          <div class="card-dark p-7" data-reveal data-reveal-delay={String(i + 1)}>
            <div class="text-3xl mb-4">{c.icon}</div>
            <h3 class="font-extrabold text-white mb-2">{c.title}</h3>
            <p class="text-sm text-white/55 font-light leading-relaxed">{c.desc}</p>
          </div>
        ))}
      </div>
      <p class="text-center text-xs text-white/40 font-light mt-8" data-reveal>
        Pas de vélo, pas de paddle, pas de kayak : seulement ce qui rentre dans un casier.
      </p>
    </div>
  </section>

  <!-- DIMENSIONNEMENT -->
  <section class="section-alt">
    <div class="container-x">
      <div class="text-center mb-14">
        <span class="eyebrow" data-reveal>Combien de bornes</span>
        <h2 class="section-title mt-3" data-reveal data-reveal-delay="1">
          Une borne couvre<br/>environ 120 emplacements.
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-5 max-w-5xl mx-auto">
        {dimensionnement.map((d, i) => (
          <div class="card-dark p-7" data-reveal data-reveal-delay={String(i + 1)}>
            <div class="text-xs uppercase tracking-[0.12em] text-brand-400 mb-3">{d.taille}</div>
            <div class="font-extrabold text-3xl text-white mb-2">
              {d.bornes} <span class="text-base font-light text-white/50">borne{d.bornes > 1 ? 's' : ''}</span>
            </div>
            <p class="text-sm text-white/55 font-light leading-relaxed">{d.lieu}</p>
          </div>
        ))}
      </div>
      <p class="text-center text-xs text-white/40 font-light mt-8 max-w-2xl mx-auto" data-reveal>
        Ordre de grandeur à affiner sur place : la bonne question n’est pas le nombre
        d’emplacements, c’est la distance entre la borne et le terrain.
      </p>
    </div>
  </section>

  <!-- PRIX -->
  <section class="section">
    <div class="container-x">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <span class="eyebrow" data-reveal>Prix</span>
        <h2 class="section-title mt-3 mb-4" data-reveal data-reveal-delay="1">
          Deux façons de s’équiper.
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-5 max-w-4xl mx-auto">
        <div class="card-dark p-8" data-reveal data-reveal-delay="2">
          <div class="text-xs uppercase tracking-[0.12em] text-brand-400 mb-3">Achat</div>
          <div class="font-extrabold text-3xl text-white mb-1">{eur(OFFRE.prixBorne)}</div>
          <div class="text-sm text-white/60 font-light mb-6">
            Borne installée et garnie. Elle vous appartient, elle s’amortit.
          </div>
          <div class="font-extrabold text-xl text-white mb-1">+ {eur(OFFRE.aboSaison)} / saison</div>
          <div class="text-sm text-white/60 font-light">
            Logiciel, maintenance à distance, remplacement du matériel d’usure.
          </div>
        </div>

        <div class="card-dark p-8" data-reveal data-reveal-delay="3">
          <div class="text-xs uppercase tracking-[0.12em] text-brand-400 mb-3">Location saisonnière</div>
          <div class="font-extrabold text-3xl text-white mb-1">{eur(OFFRE.loyerMensuel)} / mois</div>
          <div class="text-sm text-white/60 font-light mb-6">
            {OFFRE.moisSaison} mois, soit {eur(loyerSaison)} la saison. Rien à immobiliser.
          </div>
          <div class="font-extrabold text-xl text-white mb-1">Pose et dépose incluses</div>
          <div class="text-sm text-white/60 font-light">
            Nous installons avant l’ouverture, nous reprenons après la fermeture.
          </div>
        </div>
      </div>

      <p class="text-center text-sm text-white/50 font-light mt-8 max-w-2xl mx-auto" data-reveal data-reveal-delay="4">
        Si vous facturez les emprunts à vos clients, la recette est intégralement la vôtre.
        SportLocker ne prend aucune commission et n’intervient pas dans l’encaissement.
      </p>
    </div>
  </section>

  <!-- OBJECTIONS -->
  <section class="section-alt">
    <div class="container-x max-w-4xl">
      <div class="text-center mb-12">
        <span class="eyebrow" data-reveal>Les objections</span>
        <h2 class="section-title mt-3" data-reveal data-reveal-delay="1">
          Ce que les gérants nous disent
        </h2>
      </div>
      <div class="space-y-4">
        {objections.map((o, i) => (
          <div class="card-dark p-7" data-reveal data-reveal-delay={String(i + 1)}>
            <div class="font-bold text-white mb-2">« {o.q} »</div>
            <div class="text-sm text-white/60 font-light leading-relaxed">{o.a}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container-x max-w-3xl">
      <div class="text-center mb-12">
        <span class="eyebrow" data-reveal>Questions</span>
        <h2 class="section-title mt-3" data-reveal data-reveal-delay="1">Questions fréquentes</h2>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="section-alt">
    <div class="container-x max-w-3xl">
      <div class="text-center mb-12">
        <span class="eyebrow" data-reveal>Pilotes 2027</span>
        <h2 class="section-title mt-3" data-reveal data-reveal-delay="1">
          Campings pilotes recherchés en Vendée
        </h2>
        <p class="section-sub mt-4 mx-auto text-center" data-reveal data-reveal-delay="2">
          Conditions préférentielles pour les premiers sites équipés, en échange de vos retours
          d’usage sur la saison. Et si vous voulez juste nous raconter comment vous prêtez du
          matériel aujourd’hui, c’est utile aussi.
        </p>
      </div>
      <ContactForm segment="camping" />
    </div>
  </section>

  <FinalCta
    title="Quinze minutes, sur votre site."
    sub="On regarde ensemble où poser la borne et où est la prise. Vous saurez tout de suite si ça a du sens chez vous."
    primary={{ href: '/contact#formulaire', label: 'Demander une visite' }}
    secondary={{ href: '/', label: 'Revenir à l’accueil' }}
    fine="Réponse sous 24 h ouvrées · Visite offerte en Vendée et Loire-Atlantique"
  />
</Base>
