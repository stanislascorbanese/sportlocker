---
// Le site entier s'adresse désormais aux campings : une page « pour les
// campings » distincte de l'accueil n'a plus de sens. Redirection conservée
// pour les liens entrants.
const target = '/'
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href="https://sportlocker.fr/" />
    <title>Redirection — SportLocker</title>
  </head>
  <body>
    <p>Cette page a déménagé. <a href={target}>Voir l’offre</a>.</p>
  </body>
</html>
