---
import Base from '@/layouts/Base.astro'
import { SITE } from '@/data/site'

// Les CGU de mai 2026 décrivaient le parcours d'un « citoyen » avec compte,
// paiement Stripe et caution préautorisée de 30 à 150 €. Ce parcours a été
// abandonné en septembre 2026 : le vacancier s'identifie avec son numéro de
// séjour, ne crée pas de compte et ne saisit aucune carte bancaire.
//
// Les CGU du nouveau parcours seront rédigées quand ce parcours sera figé par
// le premier pilote. En attendant, cette page dit ce qui est vrai.
---

<Base
  title="Conditions d’utilisation"
  description="Le service est en cours de déploiement. Les conditions d’utilisation du parcours vacancier seront publiées avec les premières installations."
  noindex
>
  <section class="section pt-32">
    <div class="container-x max-w-3xl">
      <span class="eyebrow">Conditions d’utilisation</span>
      <h1 class="font-extrabold text-display-lg text-white mt-3 mb-8">
        Le service n’est pas encore ouvert au public.
      </h1>

      <div class="card-dark p-8 space-y-5 text-white/70 font-light leading-relaxed">
        <p>
          Aucune borne SportLocker n’est aujourd’hui accessible à des utilisateurs finaux.
          Les premières installations sont prévues pour la saison 2027.
        </p>
        <p>
          Les conditions d’utilisation du parcours vacancier — identification par numéro de
          séjour, emprunt, restitution, responsabilité en cas de casse — seront publiées ici
          avec la première mise en service, et remises à l’exploitant pour affichage sur la borne.
        </p>
        <p class="text-white/50 text-sm">
          Une question d’ici là ?
          <a href={`mailto:${SITE.email}`} class="text-brand-400 hover:underline">{SITE.email}</a>
        </p>
      </div>
    </div>
  </section>
</Base>
