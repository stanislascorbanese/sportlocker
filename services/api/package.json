{
  "name": "@sportlocker/api",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap-super-admin": "node ./scripts/bootstrap-super-admin.mjs",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist .turbo",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "node ./scripts/migrate.mjs",
    "db:migrate:drizzle": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:seed": "node ./scripts/seed.mjs",
    "db:seed-camping": "node ./scripts/seed-camping.mjs",
    "db:seed-fw-sim": "node ./scripts/seed-firmware-sim.mjs",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "dev": "tsx watch src/index.ts",
    "gen:openapi": "node ./scripts/gen-openapi.mjs",
    "lint": "eslint src --ext .ts",
    "onboard-tenant": "node ./scripts/onboard-tenant.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@sportlocker/types": "workspace:*",
    "@fastify/helmet": "^13.1.2",
    "@fastify/jwt": "^10.2.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/websocket": "^11.3.4",
    "@sentry/node": "^10.74.0",
    "bullmq": "^5.79.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.2",
    "firebase-admin": "^12.1.0",
    "ioredis": "^5.11.1",
    "jose": "^5.2.0",
    "mqtt": "^5.16.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.4",
    "stripe": "^15.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.9.0",
    "@types/node": "^26.6.4",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "ws": "^8.22.0",
    "@vitest/coverage-v8": "^4.1.9",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^11.0.0",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.9"
  }
}
