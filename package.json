{
  "name": "sportlocker",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev":        "turbo run dev",
    "build":      "turbo run build",
    "lint":       "turbo run lint",
    "test":       "turbo run test",
    "typecheck":  "turbo run typecheck",
    "clean":      "turbo run clean && rm -rf node_modules",
    "db:migrate": "pnpm --filter @sportlocker/api db:migrate",
    "db:studio":  "pnpm --filter @sportlocker/api db:studio"
  },
  "devDependencies": {
    "turbo":            "^2.10.3",
    "typescript":       "^5.9.3",
    "eslint":           "^8.57.1",
    "@types/node":      "^26.1.0",
    "prettier":         "^3.9.4"
  },
  "pnpm": {
    "//overrides": "Overrides de sécurité — forcent les versions patchées pour les vulns ≥ high (cf. docs/SECURITY.md §9). La forme `paquet@plage` cible une ligne de version précise : le sélecteur est comparé à la plage que déclare le dépendant, pas à la version résolue, d'où `@>=4` plutôt que `@4` : brace-expansion et fast-uri vivent en plusieurs majeures dans l'arbre, et forcer une seule version pour toutes casserait les paquets qui dépendent de l'ancienne API.",
    "overrides": {
      "@xmldom/xmldom": ">=0.8.13",
      "fast-jwt":       ">=6.2.4",
      "fast-uri@3":     ">=3.1.7",
      "fast-uri@>=4":   ">=4.1.4",
      "undici":         ">=6.27.0 <7",
      "drizzle-orm":    ">=0.45.2",
      "rollup":         ">=3.30.0",
      "tar":            ">=7.5.4",
      "tmp":            ">=0.2.6",
      "ws":             ">=8.21.0",
      "form-data":      ">=4.0.6",
      "protobufjs":     ">=7.6.3",
      "@grpc/grpc-js@1.14.3": "1.14.4",

      "brace-expansion@1": ">=1.1.18",
      "brace-expansion@2": ">=2.1.4",
      "brace-expansion@>=5": ">=5.0.9",
      "browserslist":   ">=4.28.7",
      "find-my-way":    ">=9.7.0",
      "@fastify/static": ">=10.1.1",
      "ip-address":     ">=10.3.1",
      "js-yaml":        ">=4.3.2",
      "nanoid":         ">=3.3.18",
      "postcss":        ">=8.5.18",
      "sharp":          ">=0.35.4",
      "smol-toml":      ">=1.7.1",
      "svgo":           ">=4.1.0"
    },
    "//audit": "Les GHSAs non couvertes par les overrides ci-dessus sont filtrées dans .github/workflows/security.yml (pnpm 9 n'applique pas pnpm.auditConfig.ignoreCves). Voir docs/SECURITY.md §9."
  }
}
